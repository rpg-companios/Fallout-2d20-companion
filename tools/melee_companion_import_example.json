  "i18n_ru_import": {
    "weapons": [
      { "id": "weapon_assaultron_blade", "name": "Клинок штурмотрона", "flavour": "Виброклинок от доминатора-штурмотрона, переделанный в оружие ближнего боя." },
      { "id": "weapon_auto_axe", "name": "Автотопор", "flavour": "Стальная пила с деталями автомобильного двигателя, 4 топорных лезвия вокруг оси. Общие черты с Потрошителем, но более разрушительный." },
      { "id": "weapon_ballistic_fist", "name": "Баллистический кулак", "flavour": "Закрепленный на запястье дробовик с нажимной пластиной. При ударе выпускает заряд дроби. Требует патрон дробовика, медленная перезарядка." },
      { "id": "weapon_bumper_sword", "name": "Большой меч", "flavour": "Хромированный бампер расплющен в тяжелое лезвие, номерной знак сохранен, выхлопная труба — рукоять." },
      { "id": "weapon_cattle_prod", "name": "Электрошокер", "flavour": "Прибор для управления скотом, переоборудован против людей. Спираль на батареях." },
      { "id": "weapon_chainsaw", "name": "Бензопила", "flavour": "Механизированный инструмент с зубчатой цепью. Не получает бонус СИЛ к урону." },
      { "id": "weapon_death_tambo", "name": "Танбо смерти", "flavour": "Смесь кастета и бубна с колокольчиками и лезвиями. Звон увеличивает диапазон Осложнений на 1 при скрытной атаке." },
      { "id": "weapon_displacer_glove", "name": "Перчатка-вытеснитель", "flavour": "Динамик на костяшках создает звуковой удар." },
      { "id": "weapon_guitar_sword", "name": "Гитара-меч", "flavour": "Меч в форме гитары. После убийства придется настроить. Звук +1 к Осложнениям в скрыте." },
      { "id": "weapon_buzz_blade", "name": "Циркулярный резак Мистера Помощника", "flavour": "Пила-рука Мистера Помощника на моторе и длинной рукояти." },
      { "id": "weapon_multipurpose_axe", "name": "Универсальный топор", "flavour": "Довоенный многофункциональный топор для рубки древесины и голов." },
      { "id": "weapon_proton_axe", "name": "Протонный топор", "flavour": "Футуристический топор со светящимся лезвием энергии, два конденсатора. Особо опасен для роботов. Качество Всплеск." },
      { "id": "weapon_war_drum", "name": "Военный барабан", "flavour": "Металлический барабан на столбе с банками гвоздей на ободке. Звук +1 к Осложнениям в скрыте." },
      { "id": "weapon_shepherds_crook", "name": "Посох Атома", "flavour": "Усиленный посох 1.5м с символом Атома, кинетические накопители. Дает Парирование и Двуручный." },
      { "id": "weapon_drill", "name": "Шахтерский перфоратор", "flavour": "Дрель для твердых пород, проходит сквозь броню. Проникающий 2, Разрушающий, тратит Ядерную батарею." },
