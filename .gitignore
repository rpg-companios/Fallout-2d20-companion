# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Кэш Expo CLI / React Native DevTools (dotslash): внутри встречаются
# read-only каталоги, и EAS Build падает на упаковке архива
# («EACCES: permission denied, rmdir .../.cache/dotslash/...»).
.cache/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# кошельки, распакованные из .trpg (не в движок)
сеттинги/
settings/pins.json
package-lock — копия.json

# архив локальных правок перед установкой (патч 431)
.install-backup/

# деревья/патчи публикации в целевые репозитории
.publish/

# нативные проекты генерируются из app.json/eas.json
/android
/ios

# локальное окружение Replit и скачанный вручную node
.replit
.node/
