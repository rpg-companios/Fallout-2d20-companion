@@ -0,0 +1,60 @@
+# Установка патча 493: терминал в локации открывает мини-игру
+
+Патч подготовлен **от коммита `a62ec7109b50ad720641a4fdeb48f1de865d8742`**
+(`main`, версия 491, уже установлены патчи 482 и 488–491). Проверено:
+`git apply --check patchs/493-terminal-hacking-on-main-491.patch` проходит на
+чистом дереве этого коммита.
+
+## Через `apply-patch.sh`
+
+В коммите `a62ec71` установщик берёт цепочку патчей из ветки
+`arena/c1c60b87-fallout-2d20-companion`. Патч 493 лежит в ветке
+`arena/054e6676-fallout-2d20-companion`, поэтому один раз нужно переключить
+источник:
+
+```bash
+git fetch origin arena/054e6676-fallout-2d20-companion
+sed -i 's|arena/c1c60b87-fallout-2d20-companion|arena/054e6676-fallout-2d20-companion|' apply-patch.sh
+./apply-patch.sh 493
+```
+
+`patchs/baseline.json` в ветке-источнике равен `493`, поэтому установщик работает
+в режиме отсечки: за один шаг он приводит всё дерево к состоянию коммита,
+в котором добавлен `patchs/493-terminal-hacking-on-main-491.patch`. Никакие
+промежуточные патчи поверх не накладываются, а файлы «Окружающая среда/бой»
+(патчи 482–486) не удаляются — базовое дерево `a62ec71` взято целиком.
+Вместе с деревом синхронизируется и сам каталог `patchs/`: локальный
+`baseline.json` становится `493`, файл патча 493 появляется на диске.
+
+`./apply-patch.sh --status` до установки может написать «Всё актуально»: старые
+патчи из цепочки уже перекрыты содержимым `a62ec71`. Ориентируйтесь на версию в
+`public/version.json` (`491`) и просто запускайте `./apply-patch.sh 493`.
+
+После установки:
+
+- `public/version.json` → `493`;
+- `apply-patch.sh` уже указывает на новую ветку (приходит вместе с деревом),
+  поэтому следующие обновления ставятся просто `./apply-patch.sh <номер>`;
+- не забудьте закоммитить изменения (`git add -A && git commit -m "Патч 493"`);
+- **перезапустите сервис Node.js** (`server/`), чтобы сервер комнат начал
+  отдавать `capabilities.terminalHacking` и доска взлома стала общей для всех
+  игроков. Без перезапуска мини-игра всё равно открывается и работает локально
+  на устройстве игрока (в окне есть подсказка).
+
+## Без `apply-patch.sh`
+
+Если установщик недоступен, патч — обычный `git`-дифф:
+
+```bash
+git apply --check patchs/493-terminal-hacking-on-main-491.patch
+git apply patchs/493-terminal-hacking-on-main-491.patch
+```
+
+## Что именно чинится
+
+Сервер комнат старой версии при выдаче локации пересобирает узлы и понижает
+`kind: 'terminal'` до `'loot'`, теряя `difficulty` и `lockOnFailure`, — игрок
+видел сундук. Конфигурация терминала теперь дублируется маркером в `lockLabel`
+(поле сохраняется даже старым сервером), клиент восстанавливает из него тип
+узла и открывает `TerminalHackingModal`. При отсутствии
+`capabilities.terminalHacking` та же мини-игра запускается локально.
diff --git a/domain/lootTrade.js b/domain/lootTrade.js
index 48e2eb8..de76601 100644
--- a/domain/lootTrade.js
+++ b/domain/lootTrade.js
@@ -29,6 +29,92 @@ export const CONTAINER_KIND = Object.freeze({
   TERMINAL: 'terminal',
 });
 
+/**
+ * Маркер терминала внутри узла локации.
+ *
+ * `normalizeHubSessionNode()` на сервере (особенно на ещё не обновлённом)
+ * собирает узел заново и выбрасывает все неизвестные поля: `kind: 'terminal'`
+ * превращается в `'loot'`, а `difficulty`/`lockOnFailure` теряются. Из-за этого
+ * игрок видел терминал как обычный сундук. `lockLabel` — единственное поле,
+ * которое сервер сохраняет как есть и которое не показывается для незапертых
+ * узлов, поэтому конфигурация терминала едет в нём. Клиент и обновлённый
+ * сервер умеют восстановить из маркера настоящий тип узла.
+ * Формат обязан совпадать с `server/terminalHacking.js` (CJS-копия).
+ */
+export const TERMINAL_NODE_MARKER = 'F2D20-TERM:';
+
+export const encodeTerminalNodeMarker = ({ difficulty = 0, lockOnFailure = false, label = '' } = {}) => (
+  `${TERMINAL_NODE_MARKER}${JSON.stringify({
+    v: 1,
+    d: Math.max(0, Math.min(5, Math.floor(Number(difficulty) || 0))),
+    f: lockOnFailure ? 1 : 0,
+    l: String(label || ''),
+  })}`
+);
+
+export const decodeTerminalNodeMarker = (value) => {
+  const raw = String(value || '');
+  if (!raw.startsWith(TERMINAL_NODE_MARKER)) return null;
+  try {
+    const parsed = JSON.parse(raw.slice(TERMINAL_NODE_MARKER.length));
+    if (!parsed || parsed.v !== 1) return null;
+    return {
+      difficulty: Math.max(0, Math.min(5, Math.floor(Number(parsed.d) || 0))),
+      lockOnFailure: Boolean(parsed.f),
+      label: String(parsed.l || ''),
+    };
+  } catch {
+    return null;
+  }
+};
+
+export const withTerminalNodeMarker = (node) => ({
+  ...node,
+  lockLabel: encodeTerminalNodeMarker({
+    difficulty: node?.difficulty,
+    lockOnFailure: node?.lockOnFailure,
+    label: node?.lockLabel,
+  }),
+});
+
+/** Восстанавливает узел терминала даже если сервер понизил его до сундука. */
+export const resolveTerminalSessionNode = (node) => {
+  if (!node) return { node, isTerminal: false, marker: null };
+  const marker = decodeTerminalNodeMarker(node.lockLabel);
+  if (node.kind === CONTAINER_KIND.TERMINAL) {
+    return {
+      node: marker ? { ...node, lockLabel: marker.label } : node,
+      isTerminal: true,
+      marker,
+    };
+  }
+  if (!marker) return { node, isTerminal: false, marker: null };
+  return {
+    node: {
+      ...node,
+      kind: CONTAINER_KIND.TERMINAL,
+      difficulty: marker.difficulty,
+      lockOnFailure: marker.lockOnFailure,
+      lockLabel: marker.label,
+    },
+    isTerminal: true,
+    marker,
+  };
+};
+
+/** Отдельный терминал, выданный без локации (старый сервер не знает terminal.issue). */
+export const buildStandaloneTerminalSessionNode = (container, { locked = false, lockLabel = '' } = {}) => withTerminalNodeMarker({
+  containerId: container?.id,
+  kind: CONTAINER_KIND.TERMINAL,
+  name: container?.name || '',
+  description: container?.description || '',
+  locked,
+  lockLabel,
+  difficulty: container?.difficulty || 0,
+  lockOnFailure: Boolean(container?.lockOnFailure),
+  items: [],
+});
+
