+
+/**
+ * Рецепты крафта сеттинга: набор правил и ингредиентов для создания
+ * предметов. Каждая секция — массив рецептов: id, output (itemId + quantity),
+ * materials (itemId + quantity). Секции: chem, ammo, food, drinks.
+ * Движок крафта читает рецепты только через эту функцию.
+ */
+export function getCraftRecipes() {
+  return moduleCraftRecipes;
+}
+
+/**
+ * Хлам (junk) сеттинга: ингредиенты крафта с id, весом и стоимостью.
+ * Имена — из i18n модуля для текущей локали.
+ */
+export function getJunk(locale = getCurrentModuleLocale()) {
+  const i18n = requireModuleLocale(locale) === 'en-EN' ? moduleEnJunkI18n : moduleRuJunkI18n;
+  const i18nMap = new Map((i18n || []).map((item) => [item.id, item]));
+  return (moduleJunk || []).map((dataItem) => {
+    const loc = i18nMap.get(dataItem.id);
+    return { ...dataItem, name: loc?.name || dataItem.id };
+  });
+}
+
+/**
+ * Таблица сбора (foraging) сеттинга: массив { roll, id } для броска d20.
