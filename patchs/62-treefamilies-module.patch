 // domain/registry.js
 // Реестр данных движка — ЕДИНАЯ точка чтения данных сеттинга.
 //
-// Сейчас реестр возвращает статические файлы data/ (поведение не меняется).
-// В будущем сюда подключится модуль сеттинга (modules/fallout.posm):
-// registry = base(встроенные данные) + user(packStore-модуль), приоритет — модуль.
+// Источники:
+//   base   — встроенные данные data/ (движок поставляется без сеттинга,
