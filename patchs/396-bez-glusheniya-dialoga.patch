--- a/public/index.html
+++ b/public/index.html
@@ -27,7 +27,12 @@
       window.__pwaInstallPrompt = null;
 
       window.addEventListener('beforeinstallprompt', (event) => {
-        event.preventDefault();
+        // 396: НЕ вызываем event.preventDefault(). Раньше мы глушили родной
+        // диалог браузера, оставляя установку только через нашу кнопку —
+        // а в части браузеров (сегодняшний Яндекс) отложенный prompt()
+        // своего UI не поднимает, и диалог не показывался ВООБЩЕ. Теперь
+        // браузер волен показать свой родной путь установки; событие лишь
+        // запоминаем — для диагностики и кнопки.
         window.__pwaInstallPrompt = event;
         // Notify React if it is already listening
         window.dispatchEvent(new CustomEvent('pwaInstallPromptReady', { detail: event }));
