+  const armorPiecesByCategory = Object.fromEntries(
+    Object.entries(dataArmor || {}).map(([categoryKey, category]) => [
+      categoryKey,
+      Object.values(category?.tiers || {}).flatMap((tier) => tier?.pieces || []),
