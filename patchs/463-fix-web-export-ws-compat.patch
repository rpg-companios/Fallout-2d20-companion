+// и ws@8+ (экспортирует и ws.WebSocketServer, и ws.Server).
+const resolveWebSocketServer = (wsPkg) => {
+  if (!wsPkg) return null;
+  const candidate =
+    wsPkg.WebSocketServer ||
+    wsPkg.Server ||
+    wsPkg.default?.WebSocketServer ||
