-# Добавленные строки патча: «файл<TAB>строка», файлы вне чейнджлогов,
-# строка не короче 10 символов, не больше 15 на файл.
-added_lines() {
-  awk '
-    function flush() { n = 0 }
-    BEGIN { cur = ""; n = 0 }
-    /^diff --git / { flush(); cur = "" }
-    /^\+\+\+ b\// {
-      p = substr($0, 7)
-      if (p != "docs/changelog.ru.md" && p != "docs/changelog.en.md") cur = p
-      else cur = ""
-      flush()
-      next
-    }
-    cur != "" && /^\+/ && !/^\+\+\+/ {
-      if (n < 15) {
-        l = substr($0, 2)
-        if (length(l) >= 10) {
-          printf "%s\t%s\n", cur, l
-          n++
-        }
-      }
-    }
-  ' "$1"
