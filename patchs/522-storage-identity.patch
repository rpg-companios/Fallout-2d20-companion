+/**
+ * Патч 522: доменная точка входа к ЕДИНОМУ модулю механики предметов.
+ *
+ * Канон живёт в `server/itemStacking.js`: лёгкий деплой NetAngels раскладывает
+ * в app/ только `server/` + `ws`, поэтому комнатный сервер не может зависеть от
+ * каталога `domain/`. Клиент (инвентарь, склад, торговцы) импортирует именно
+ * этот файл —规则 физически одни и те же, дубля нет.
+ */
+module.exports = require('../server/itemStacking.js');
