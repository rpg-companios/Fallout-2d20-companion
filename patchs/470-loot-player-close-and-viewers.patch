+        code,
+        sessionId: opened.sessionId,
+        requestId: 'close-p2',
+      }, code);
+
+      const closeRes = await waitMsg(
+        p2Box,
+        (m) => m.type === ROOM_MESSAGE.SESSION_STATE && m.payload?.requestId === 'close-p2',
