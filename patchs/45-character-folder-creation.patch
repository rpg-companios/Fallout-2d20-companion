@@ -0,0 +1,26 @@
+import AsyncStorage from '@react-native-async-storage/async-storage';
+
+const STORAGE_KEY = 'fallout2d20:character-folders';
+
+const readFolders = async () => {
+  const raw = await AsyncStorage.getItem(STORAGE_KEY);
+  if (!raw) return [];
+  try {
+    const folders = JSON.parse(raw);
+    return Array.isArray(folders) ? folders : [];
+  } catch (_) {
+    return [];
+  }
+};
+
+export const getCharacterFolders = readFolders;
+
+export const createCharacterFolder = async (name) => {
+  const cleanName = String(name || '').trim();
+  if (!cleanName) throw new Error('Folder name is required');
+  const folders = await readFolders();
+  const now = Date.now();
+  const folder = { id: `folder_${now}_${Math.random().toString(36).slice(2, 8)}`, name: cleanName, createdAt: now };
+  await AsyncStorage.setItem(STORAGE_KEY, JSON.stringify([...folders, folder]));
+  return folder;
+};
