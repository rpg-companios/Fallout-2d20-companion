+  const applyDiseaseExposureForConsumable = (item) => {
+    if (
+      item?.id === 'drink_dirty_water'
+      && Boolean(useCharacterStore.getState().perkBonuses?.dirtyWaterDiseaseImmune)
+    ) {
+      return null;
+    }
+    const ruleMatches = getSceneRiskRules()
+      .map((rule) => ({ rule, event: getSceneRiskEventForRule(item, rule.id) }))
+      .filter(({ event }) => event !== null);
+    if (ruleMatches.length === 0) return null;
+    if (ruleMatches.length > 1) {
+      throw new Error('[CharacterContext] Расходник объявляет несколько проверок риска одной сцены');
+    }
+
+    // Единая механика проверки болезни (§7 дока): событие расходника
+    // (rawFood / dirtyWater) разрешается тем же кодом, что и sleepOnGround.
+    return applyDiseaseExposureEvent(ruleMatches[0].event.eventId);
+  };
+
+  /**
+   * Сон — операция выживания (docs/survival-system-design.md §4–§7):
+   * лестницы + усталость + дрен ОЗ (домен rest), мост контуров — временные
+   * эффекты продвигаются на N × 12 сцен, и при сне в пустоши — проверка
+   * болезни по имеющейся механике (событие sleepOnGround).
+   * Прогноз для модали делает чистый домен forecastSleep (состояние не
+   * фиксируется); эта функция — применяет и фиксирует.
+   */
+  const sleepSurvival = ({ place, hours }) => {
+    if (!survival) return { ok: false, reason: 'notCapable' };
+    const result = rest(survival, { place, hours, currentHp: currentHealth });
+    setSurvival(result.state);
+    if (currentHealth != null && result.hpEnd != null) {
+      setCurrentHealth(result.hpEnd);
+    }
+    // Мост контуров (§5): сон двигает таймеры эффектов как N × 12 сцен.
+    const store = useCharacterStore.getState();
+    const currentLegacy = effectsDictToLegacyArray(store.effects);
+    const normalizedCurrent = pruneExpiredTimedEffects(currentLegacy);
+    normalizedCurrent.expired.forEach((effect) => store.expireEffect(effect.id));
+    const { effects: nextEffects, expired } = advanceEffectsByScenes(
+      normalizedCurrent.effects,
+      hours * SCENE_RULES.SCENES_PER_GAME_HOUR,
+    );
+    syncTimedEffectsToStore(nextEffects, store);
+    setActiveTimedEffects(nextEffects);
+    // Сон в пустоши — проверка заболевания (sleepOnGround, §7).
+    const diseaseRiskResult = place === 'wasteland'
+      ? applyDiseaseExposureEvent('sleepOnGround')
+      : null;
+    debugLog('survival.sleep.apply', {
+      place,
+      hours,
+      sleepTo: result.state.sleep,
+      hpEnd: result.hpEnd,
+      hpLost: result.hpLost,
+      hitsZero: result.hitsZero,
+      diseaseRiskResult,
+      effectsExpired: expired.length,
+    });
+    return {
+      ok: true,
+      result,
+      diseaseRiskResult,
+      effectsExpired: [...normalizedCurrent.expired, ...expired],
+    };
+  };
+
   /**
    * Применяет расходник: мгновенное лечение/радиация, timed-эффекты,
