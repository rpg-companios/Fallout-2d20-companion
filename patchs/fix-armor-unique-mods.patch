+const hasIntersection = (a = [], b = []) => a.some((x) => b.includes(x));
+
+// ПРАВИЛО (от владельца): уникальные модификации брони — СТРОГО по типу брони.
+// У каждой категории брони свой набор уникальных модов (напр. только кожаной
