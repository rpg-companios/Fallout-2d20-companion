new file mode 100644
index 0000000..d02fbe7
--- /dev/null
+++ b/__tests__/robot/robot-kit-assembly.test.js
@@ -0,0 +1,117 @@
+// __tests__/robot/robot-kit-assembly.test.js
+//
+// Реальный путь модалки комплекта снаряжения:
+//   kitResolver.resolveKitItems(кит) → initRobotSlots(план тела, записи, каталог)
+//
+// До этого проверялась только копия разворота (resolveKit в mister-handy.test.js):
+// kitResolver тянет БД и react-native и в тесты не импортировался. Здесь
+// тяжёлые зависимости подменены, сам разворот настоящий — так видно, что
+// конечности и защита из комплекта действительно встают в слоты робота.
+import { describe, it, expect, vi } from 'vitest';
+
+vi.mock('../../db/Database', () => ({
+  getWeaponById: async () => null,
+  getWeaponModById: async () => null,
+  getAmmoById: async () => null,
+  getItemByName: async () => null,
+}));
+vi.mock('../../modules/fallout/screens/CharacterScreen/logic/RandomLootLogic', () => ({
+  resolveRandomLootByRoll: () => null,
+}));
+vi.mock('../../modules/fallout/screens/WeaponsAndArmorScreen/weaponsAndArmorScreenI18n', () => ({
+  tWeaponsAndArmorScreen: (key) => key,
+}));
+
+import kits from '../../modules/fallout/data/equipmentKits/index.js';
+import { resolveKitItems } from '../../domain/kitResolver';
+import { initRobotSlots } from '../../domain/robotEquip';
+import limbs from '../../modules/fallout/data/equipment/robot/limbs.json';
+import weaponAsLimb from '../../modules/fallout/data/equipment/robot/weaponAsLimb.json';
+import robotWeapons from '../../modules/fallout/data/equipment/robot/weapons.json';
+import platingFile from '../../modules/fallout/data/equipment/robot/armor_plating.json';
+import framesFile from '../../modules/fallout/data/equipment/robot/frames.json';
+
+// Каталог ровно тот, что модалка комплекта передаёт в initRobotSlots.
+const robotCatalog = {
+  limbs,
+  weaponAsLimb,
+  weapons: robotWeapons,
+  plating: platingFile.plating || [],
+  frames: framesFile.frames || [],
+};
+
+const assemble = async (kitId, bodyPlan) => {
+  const kit = kits[kitId];
+  if (!kit) throw new Error(`нет комплекта ${kitId}`);
+  const resolved = await resolveKitItems(kit, {});
+  return initRobotSlots(bodyPlan, resolved.items, robotCatalog);
+};
+
+describe('комплект снаряжения собирает робота (реальный разворот)', () => {
+  it('мистер Хэндℹ: все шесть слотов заняты, защита на месте', async () => {
+    const { slots } = await assemble('mister_handy_assistant', 'misterHandy');
+
+    expect(slots.head.limb?.id).toBe('robot_head_mister_handy_eye_stalk');
+    expect(slots.body.limb?.id).toBe('robot_body_mister_handy');
+    expect(slots.thruster.limb?.id).toBe('robot_legs_mister_handy_thruster');
+    expect(slots.arm1.limb?.id).toBe('robot_arm_mister_handy');
+    expect(slots.arm2.limb?.id).toBe('robot_weapon_flamethrower');
+    expect(slots.arm3.limb?.id).toBe('robot_weapon_circular_saw');
+  });
+
+  it('конечности приходят из каталога, а не заглушками из кита', async () => {
+    const { slots } = await assemble('mister_handy_assistant', 'misterHandy');
+
+    // У записи кита своих характеристик нет: если разворот сломался,
+    // в слот ляжет голый itemId без СУ и без типа конечности.
+    for (const key of Object.keys(slots)) {
+      const limb = slots[key].limb;
+      expect(limb, `слот ${key} пуст`).toBeTruthy();
+      expect(['limb', 'weaponAsLimb']).toContain(limb.itemCategory);
+
+      if (limb.itemCategory === 'limb') {
+        expect(limb.physicalDR, `у конечности ${key} нет СУ из каталога`).toBeTypeOf('number');
+      } else {
+        // Конечность-оружие: полей СУ в данных у неё нет вовсе (правило
+        // владельца) — вклада от слоёв защиты она не получает. А вот хватать
+        // ей нечем: canHoldWeapons движок ставит сам.
+        for (const field of ['physicalDR', 'energyDR', 'radDR']) {
+          expect(limb[field], `${key}: у оружия-конечности не должно быть ${field}`).toBeUndefined();
+        }
+        expect(limb.canHoldWeapons, `${key}: оружие вместо руки ничего не держит`).toBe(false);
+      }
+    }
+  });
+
+  it('обшивка из комплекта ложится в слот, а не теряется', async () => {
+    const { slots, inventoryItems } = await assemble('mister_handy_assistant', 'misterHandy');
+
+    const layers = Object.values(slots).flatMap((slot) => [
+      slot.plating?.id, slot.frame?.id, slot.armor?.id,
+    ]).filter(Boolean);
+    expect(layers).toContain('robot_plating_standard_body');
+
+    // Защита не дублируется в инвентарь и не пропадает: ровно один слой.
+    const ids = Object.keys(inventoryItems).length;
+    expect(layers.filter((id) => id === 'robot_plating_standard_body')).toHaveLength(1);
+    expect(ids).toBeGreaterThan(0);
+  });
+
+  it('атаки: своя атака руки плюс оружие в ладонях', async () => {
+    const { weapons } = await assemble('mister_handy_assistant', 'misterHandy');
+    const ids = weapons.map((w) => w.id);
+
+    expect(ids).toContain('robot_weapon_manipulator'); // встроенная атака руки
+    expect(ids).toContain('robot_weapon_flamethrower');
+    expect(ids).toContain('robot_weapon_circular_saw');
+  });
+
+  it('штурмотрон: гуманоидный план собирается так же', async () => {
+    const { slots, weapons } = await assemble('assaultron_us_military', 'assaultron');
+
+    for (const key of ['head', 'body', 'leftArm', 'rightArm', 'leftLeg', 'rightLeg']) {
+      expect(slots[key]?.limb, `слот ${key} пуст`).toBeTruthy();
+    }
+    expect(weapons.length).toBeGreaterThan(0);
+  });
+});
