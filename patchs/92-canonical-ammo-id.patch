diff --git a/__tests__/equipment/ammo-id-canonical.test.js b/__tests__/equipment/ammo-id-canonical.test.js
new file mode 100644
--- /dev/null
+++ b/__tests__/equipment/ammo-id-canonical.test.js
index 0000000..ede1ce2
--- /dev/null
+++ b/__tests__/equipment/ammo-id-canonical.test.js
@@ -0,0 +1,40 @@
+import { describe, it, expect } from 'vitest';
+import { resolveItem } from '../../domain/resolveItem';
+import { isAmmoWeapon } from '../../domain/weaponDurability';
+
+// Каноническое поле патронов — ammoId (camelCase). Потребители должны читать
+// только его, без многовариантных `?? ammo_id`.
+const catalog = {
+  weapons: [
+    { id: 'weapon_test', name: 'Test Gun', itemType: 'weapon', ammoId: 'ammo_308' },
+  ],
+};
+
+describe('resolveItem — канонический ammoId', () => {
+  it('отдаёт ammoId из каталога', () => {
+    const resolved = resolveItem({ id: 'weapon_test', itemType: 'weapon' }, catalog);
+    expect(resolved.ammoId).toBe('ammo_308');
+  });
+
+  it('нормализует старый snake_case ammo_id инстанса в ammoId', () => {
+    const resolved = resolveItem(
+      { id: 'weapon_test', itemType: 'weapon', ammo_id: 'legacy_ammo' },
+      catalog,
+    );
+    expect(resolved.ammoId).toBe('legacy_ammo');
+    expect(resolved.ammo_id).toBeUndefined();
+  });
+});
+
+describe('isAmmoWeapon — читает только ammoId', () => {
+  it('true, если есть ammoId', () => {
+    expect(isAmmoWeapon({ ammoId: 'ammo_308' })).toBe(true);
+  });
+  it('false, если только старый ammo_id (без нормализации)', () => {
+    // Это намеренно: до resolveItem старые записи должны быть приведены к ammoId.
+    expect(isAmmoWeapon({ ammo_id: 'ammo_308' })).toBe(false);
+  });
+  it('false для ammo_anything', () => {
+    expect(isAmmoWeapon({ ammoId: 'ammo_anything' })).toBe(false);
+  });
+});
