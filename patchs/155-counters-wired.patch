   };
 
   const handleApplyConsumable = (item) => {
@@ -479,7 +479,7 @@ const InventoryScreen = () => {
   };
 
   const handleConfirmSale = (quantity, finalPrice) => {
-    setCaps(prev => prev + finalPrice);
