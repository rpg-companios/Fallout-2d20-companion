+  const resultLabel = {
+    'PIN BROKEN': 'lock.pinBroken',
+    'PIN HELD': 'lock.pinHeld',
+    'TRY AGAIN': 'lock.wrong',
+    'OUT OF PINS': 'lock.noPins',
+    'ACCESS GRANTED': 'lock.won',
+  }[game?.result] || null;
