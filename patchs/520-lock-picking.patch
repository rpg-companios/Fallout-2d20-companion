+            >
+              <MaterialCommunityIcons name="close" size={20} color="#bdc8b7" />
+            </TouchableOpacity>
+          </View>
+
+          {(lock?.description || terminalState?.config?.description) ? (
+            <Text style={terminalHackingStyles.description}>
+              {lock?.description || terminalState?.config?.description}
+            </Text>
+          ) : null}
