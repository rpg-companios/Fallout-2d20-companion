+    const sizes = game?.rows || [cells.length];
+    const out = [];
+    let at = 0;
+    for (const size of sizes) {
+      out.push(cells.slice(at, at + size));
+      at += size;
+    }
+    return out;
+  }, [game?.cells, game?.rows]);
