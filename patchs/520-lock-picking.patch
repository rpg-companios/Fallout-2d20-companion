+    }[cell?.state] || styles.cellHidden;
+    const textStyle = {
+      [CELL_STATE.GREEN]: styles.cellTextGreen,
+      [CELL_STATE.RED]: styles.cellTextRed,
+      [CELL_STATE.GREY]: styles.cellTextGrey,
