diff --git a/components/lootTrade/PlayerLootTradeOverlay.js b/components/lootTrade/PlayerLootTradeOverlay.js
index 3c5a083..43f0f3a 100644
--- a/components/lootTrade/PlayerLootTradeOverlay.js
+++ b/components/lootTrade/PlayerLootTradeOverlay.js
