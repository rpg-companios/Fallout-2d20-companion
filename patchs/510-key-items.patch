+++ b/__tests__/room/key-items-510.test.js
@@ -0,0 +1,128 @@
+// Приёмочный тест 510, шаг 2 дизайна: ключевые записи на общем складе.
+// «Предметов таких можно создавать много. Каждому предмету вручную нужно
+// будет давать имя, описание ... Мастер может назвать предмет "ключ от склада"
+// и не давать описания. Или может написать "Записка наёмника" ... В инвентаре
+// эти предметы просто лежат с названием». Плюс решения: запись общая,
+// забрать нельзя, добытое неприкосновенно.
+import { describe, expect, it } from 'vitest';
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createRoomRegistry } from '../../server/roomRegistry.js';
+import { MESSAGE, ERROR_CODE } from '../../server/protocol.js';
+import { ROOM_MESSAGE, ROOM_ERROR } from '../../src/room/roomProtocol.ts';
+import {
+  createStorageExportPayload,
+  parseStorageImportPayload,
+} from '../../domain/partyStorageTransfer.js';
+
+const ROOT = fileURLToPath(new URL('../../', import.meta.url));
+const read = (rel) => readFileSync(path.join(ROOT, rel), 'utf8');
+
+const setup = () => {
+  const registry = createRoomRegistry({ now: () => 1000 });
+  const { room } = registry.createRoom({ clientId: 'gm', name: 'Стол', ownerToken: 'tok' });
+  registry.joinRoom({ code: room.code, clientId: 'gm', name: 'GM', role: 'gm' });
+  registry.joinRoom({ code: room.code, clientId: 'p1', name: 'Игрок', role: 'player' });
+  return { registry, room };
+};
+
+describe('510: ключевая запись на складе', () => {
+  it('Мастер выдаёт ключ; забрать его нельзя, прочитать можно', () => {
+    const { registry, room } = setup();
+    const added = registry.addKeyItemToStorage({
+      code: room.code, clientId: 'gm', keyItemId: 'key_42',
+      name: 'Ключ от склада', description: '',
+    });
+    expect(added.error).toBeUndefined();
+    expect(added.entry.kind).toBe('keyItem');
+    expect(added.entry.description).toBe('');
+    expect(registry.getPartyStorage(room.code).entries).toHaveLength(1);
+
+    expect(registry.withdrawFromPartyStorage({
+      code: room.code, clientId: 'p1', entryId: added.entry.entryId,
+    }).error).toBe(ERROR_CODE.STORAGE_KEY_READ_ONLY);
+    expect(registry.getPartyStorage(room.code).entries).toHaveLength(1);
+  });
+
+  it('ключ выдаёт только Мастер, дубликат не создаётся, без Мастера — отказ', () => {
+    const { registry, room } = setup();
+    expect(registry.addKeyItemToStorage({ code: room.code, clientId: 'p1', keyItemId: 'k', name: 'K' }).error)
+      .toBe(ERROR_CODE.STORAGE_FORBIDDEN);
+    const first = registry.addKeyItemToStorage({ code: room.code, clientId: 'gm', keyItemId: 'k', name: 'K' });
+    expect(first.added).toBe(true);
+    const second = registry.addKeyItemToStorage({ code: room.code, clientId: 'gm', keyItemId: 'k', name: 'K' });
+    expect(second.added).toBe(false);
+    expect(registry.getPartyStorage(room.code).entries).toHaveLength(1);
+    registry.leaveRoom({ code: room.code, clientId: 'gm' });
+    expect(registry.addKeyItemToStorage({ code: room.code, clientId: 'gm', keyItemId: 'k2', name: 'K2' }).error)
+      .toBe(ERROR_CODE.ROOM_NOT_FOUND);
+  });
+
+  it('ключ, найденный в контейнере, уходит на общий склад', () => {
+    const { registry, room } = setup();
+    registry.openSession({
+      code: room.code, clientId: 'gm',
+      session: {
+        name: 'Сейф', kind: 'loot', targetType: 'room',
+        items: [{
+          entryId: 'e1', itemId: 'key_77', itemType: 'misc', name: 'Записка наёмника',
+          quantity: 1, keyItemId: 'key_77', keyDescription: 'Нажать левый верхний кирпич',
+        }],
+      },
+    });
+    const take = registry.lootTake({
+      code: room.code, clientId: 'p1',
+      payload: { characterId: 'c1', takes: [{ entryId: 'e1', quantity: 1 }] },
+    });
+    expect(take.error).toBeUndefined();
+    const keys = registry.getPartyStorage(room.code).entries.filter((e) => e.kind === 'keyItem');
+    expect(keys).toHaveLength(1);
+    expect(keys[0]).toMatchObject({
+      keyItemId: 'key_77', name: 'Записка наёмника', description: 'Нажать левый верхний кирпич',
+    });
+  });
+
+  it('ключи едут в JSON-снимке вместе со всем складом', () => {
+    const { registry, room } = setup();
+    registry.addKeyItemToStorage({
+      code: room.code, clientId: 'gm', keyItemId: 'key_1', name: 'Карточка', description: '**Код** 1234',
+    });
+    const exported = createStorageExportPayload({ code: room.code, storage: registry.getPartyStorage(room.code) });
+    const imported = parseStorageImportPayload(JSON.stringify(exported));
+    expect(imported.storage.entries[0]).toMatchObject({
+      kind: 'keyItem', keyItemId: 'key_1', description: '**Код** 1234',
+    });
+  });
+});
+
+describe('510: справочник, редактор и карточка', () => {
+  it('протокол зеркалится', () => {
+    expect(ROOM_MESSAGE.STORAGE_ADD_KEY).toBe(MESSAGE.STORAGE_ADD_KEY);
+    expect(ROOM_ERROR.STORAGE_KEY_READ_ONLY).toBe(ERROR_CODE.STORAGE_KEY_READ_ONLY);
+  });
+
+  it('справочник Мастера хранится локально, описание с тегами и предпросмотром', () => {
+    expect(read('db/schema.js')).toContain('gm_key_items');
+    expect(read('db/Database.js')).toContain('saveGmKeyItem');
+    expect(read('db/Database.web.js')).toContain('getGmKeyItems');
+    const catalog = read('components/lootTrade/KeyItemCatalogModal.js');
+    expect(catalog).toContain('renderTextWithIcons');
+    expect(catalog).toContain('key-item-description');
+    expect(catalog).toContain('addKeyItemToStorage');
+    expect(read('components/screens/LootTradeScreen/LootTradeScreen.js')).toContain('testID="key-catalog-button"');
+  });
+
+  it('окно склада показывает ключи отдельно и без кнопки «Забрать»', () => {
+    const modal = read('components/lootTrade/PartyStorageModal.js');
+    expect(modal).toContain("entry.kind !== 'keyItem'");
+    expect(modal).toContain("entry.kind === 'keyItem'");
+    expect(modal).toContain('renderTextWithIcons');
+    expect(modal).toContain('screen.storage.keyStays');
+    const ru = JSON.parse(read('i18n/ru-RU/screens/lootTrade/screen.json')).keyItems;
+    const en = JSON.parse(read('i18n/en-EN/screens/lootTrade/screen.json')).keyItems;
+    expect(ru.title).toBe('Ключи и записки');
+    expect(en.title).toBe('Keys and notes');
+    expect(ru.descriptionPlaceholder).toBeTruthy();
+  });
+});
diff --git a/components/lootTrade/KeyItemCatalogModal.js b/components/lootTrade/KeyItemCatalogModal.js
new file mode 100644
index 0000000..c0184c1
--- /dev/null
+++ b/components/lootTrade/KeyItemCatalogModal.js
@@ -0,0 +1,214 @@
+/**
+ * Патч 510, шаг 2: справочник ключевых записей Мастера.
+ *
+ * «Ключ от склада» без описания и «Записка наёмника» с мини-историей —
+ * это одна и та же запись: id, имя, описание с уже существующими тегами.
+ * Справочник принадлежит Мастеру; добытая копия на складе самодостаточна и
+ * не зависит от последующих правок этого справочника.
+ */
+
+import React, { useCallback, useEffect, useMemo, useState } from 'react';
+import {
+  Modal,
+  View,
+  Text,
+  TextInput,
+  TouchableOpacity,
+  ScrollView,
+  StyleSheet,
+  Platform,
+} from 'react-native';
+import * as db from '../../db';
+import useRoomStore from '../../src/room/roomStore';
+import { renderTextWithIcons } from '../../modules/fallout/screens/WeaponsAndArmorScreen/textUtils';
+import { showRawAlert } from '../alerts/alertService';
+import { tLootTrade } from '../screens/LootTradeScreen/logic/lootTradeI18n';
+import { useLocale } from '../../i18n/locale';
+
+const makeId = () => `key_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
+
+const TAG_BUTTONS = [
+  { label: '**Ж**', insert: '**жирный**' },
+  { label: '*К*', insert: '*курсив*' },
+  { label: '• список', insert: '\n- пункт' },
+  { label: '{CD}', insert: ' {CD}' },
+  { label: '{CAP}', insert: ' {CAP}' },
+];
+
+const KeyItemCatalogModal = ({ visible, onClose }) => {
+  useLocale();
+  const rooms = useRoomStore((state) => state.rooms);
+  const [items, setItems] = useState([]);
+  const [draft, setDraft] = useState({ id: '', name: '', description: '' });
+  const [busy, setBusy] = useState(false);
+
+  const gmRoom = useMemo(() => {
+    const entry = Object.entries(rooms || {}).find(([, room]) => room?.role === 'gm');
+    return entry ? { code: entry[0] } : null;
+  }, [rooms]);
+
+  const refresh = useCallback(async () => {
+    try { setItems(await db.getGmKeyItems()); } catch { setItems([]); }
+  }, []);
+  useEffect(() => { if (visible) void refresh(); }, [visible, refresh]);
+
+  const save = async () => {
+    const name = draft.name.trim();
+    if (!name) { showRawAlert({ title: tLootTrade('keyItems.nameRequired') }); return; }
+    setBusy(true);
+    try {
+      await db.saveGmKeyItem({
+        id: draft.id || makeId(),
+        name,
+        description: draft.description,
+        roomCode: gmRoom?.code || '',
+      });
+      setDraft({ id: '', name: '', description: '' });
+      await refresh();
+    } finally { setBusy(false); }
+  };
+
+  const issue = async (item) => {
+    if (!gmRoom) { showRawAlert({ title: tLootTrade('keyItems.noRoom') }); return; }
+    setBusy(true);
+    try {
+      await useRoomStore.getState().addKeyItemToStorage({
+        code: gmRoom.code,
+        keyItemId: item.id,
+        name: item.name,
+        description: item.description,
+      });
+      showRawAlert({ title: tLootTrade('keyItems.issued') });
+    } catch (error) {
+      showRawAlert({ title: tLootTrade('keyItems.failed'), message: error?.message });
+    } finally { setBusy(false); }
+  };
+
+  if (!visible) return null;
+
+  return (
+    <Modal visible transparent animationType={Platform.OS === 'web' ? 'none' : 'fade'} onRequestClose={onClose}>
+      <View style={styles.backdrop}>
+        <View style={styles.window}>
+          <View style={styles.header}>
+            <Text style={styles.title}>{tLootTrade('keyItems.title')}</Text>
+            <TouchableOpacity accessibilityRole="button" onPress={onClose}>
+              <Text style={styles.close}>×</Text>
+            </TouchableOpacity>
+          </View>
+
+          <Text style={styles.label}>{tLootTrade('keyItems.nameLabel')}</Text>
+          <TextInput
+            testID="key-item-name"
+            style={styles.input}
+            value={draft.name}
+            onChangeText={(text) => setDraft((prev) => ({ ...prev, name: text }))}
+            placeholder={tLootTrade('keyItems.namePlaceholder')}
+            placeholderTextColor="#6b7a68"
+          />
+
+          <Text style={styles.label}>{tLootTrade('keyItems.descriptionLabel')}</Text>
+          <View style={styles.tagRow}>
+            {TAG_BUTTONS.map((tag) => (
+              <TouchableOpacity
+                key={tag.label}
+                style={styles.tagButton}
+                onPress={() => setDraft((prev) => ({ ...prev, description: prev.description + tag.insert }))}
+              >
+                <Text style={styles.tagButtonText}>{tag.label}</Text>
+              </TouchableOpacity>
+            ))}
+          </View>
+          <TextInput
+            testID="key-item-description"
+            style={[styles.input, styles.multiline]}
+            value={draft.description}
+            onChangeText={(text) => setDraft((prev) => ({ ...prev, description: text }))}
+            placeholder={tLootTrade('keyItems.descriptionPlaceholder')}
+            placeholderTextColor="#6b7a68"
+            multiline
+          />
+          <View style={styles.preview}>
+            {renderTextWithIcons(
+              draft.description || tLootTrade('keyItems.previewEmpty'),
+              styles.previewText,
+            )}
+          </View>
+
+          <View style={styles.formActions}>
+            <TouchableOpacity testID="key-item-save" style={styles.primaryButton} disabled={busy} onPress={() => void save()}>
+              <Text style={styles.primaryButtonText}>{tLootTrade('keyItems.save')}</Text>
+            </TouchableOpacity>
+            <TouchableOpacity style={styles.secondaryButton} onPress={() => setDraft({ id: '', name: '', description: '' })}>
+              <Text style={styles.secondaryButtonText}>{tLootTrade('keyItems.clear')}</Text>
+            </TouchableOpacity>
+          </View>
+
+          <Text style={styles.label}>{tLootTrade('keyItems.catalog')}</Text>
+          <ScrollView style={styles.list}>
+            {items.length === 0
+              ? <Text style={styles.hint}>{tLootTrade('keyItems.empty')}</Text>
+              : items.map((item) => (
+                <View key={item.id} style={styles.row}>
+                  <View style={styles.rowInfo}>
+                    <Text style={styles.rowName}>{item.name}</Text>
+                    {Boolean(item.description) && (
+                      <Text style={styles.rowDesc} numberOfLines={1}>{item.description.replace(/\*/g, '')}</Text>
+                    )}
+                  </View>
+                  <TouchableOpacity
+                    testID={`key-item-edit-${item.id}`}
+                    style={styles.rowButton}
+                    onPress={() => setDraft({ id: item.id, name: item.name, description: item.description })}
+                  >
+                    <Text style={styles.rowButtonText}>{tLootTrade('keyItems.edit')}</Text>
+                  </TouchableOpacity>
+                  <TouchableOpacity
+                    testID={`key-item-issue-${item.id}`}
+                    style={[styles.rowButton, styles.issueButton]}
+                    disabled={busy}
+                    onPress={() => void issue(item)}
+                  >
+                    <Text style={styles.rowButtonText}>{tLootTrade('keyItems.issue')}</Text>
+                  </TouchableOpacity>
+                </View>
+              ))}
+          </ScrollView>
+          <Text style={styles.hint}>{tLootTrade('keyItems.hint')}</Text>
+        </View>
+      </View>
+    </Modal>
+  );
+};
+
+const styles = StyleSheet.create({
+  backdrop: { flex: 1, backgroundColor: 'rgba(0,0,0,0.78)', justifyContent: 'center', alignItems: 'center', padding: 14 },
+  window: { width: '100%', maxWidth: 720, maxHeight: '90%', backgroundColor: '#0b140d', borderWidth: 1.5, borderColor: '#42784a', borderRadius: 6, padding: 14 },
+  header: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderBottomWidth: 1, borderColor: '#29482d', paddingBottom: 8, marginBottom: 10 },
+  title: { color: '#93d17a', fontSize: 16, fontWeight: '800' },
+  close: { color: '#bdc8b7', fontSize: 22 },
+  label: { color: '#8da38b', fontSize: 11, letterSpacing: 1, textTransform: 'uppercase', marginTop: 8, marginBottom: 4, fontFamily: 'monospace' },
+  input: { borderWidth: 1, borderColor: '#29482d', borderRadius: 4, color: '#d8e4cc', paddingHorizontal: 9, paddingVertical: 7, fontSize: 13 },
+  multiline: { minHeight: 76, textAlignVertical: 'top' },
+  tagRow: { flexDirection: 'row', flexWrap: 'wrap', gap: 5, marginBottom: 5 },
+  tagButton: { borderWidth: 1, borderColor: '#3a5a3d', borderRadius: 3, paddingHorizontal: 7, paddingVertical: 3 },
+  tagButtonText: { color: '#a4cb77', fontSize: 10 },
+  preview: { borderWidth: 1, borderColor: '#29482d', borderRadius: 4, padding: 8, marginTop: 6, minHeight: 40 },
+  previewText: { color: '#c8d4b1', fontSize: 12 },
+  formActions: { flexDirection: 'row', gap: 8, marginTop: 9 },
+  primaryButton: { flex: 1, alignItems: 'center', paddingVertical: 8, borderRadius: 4, backgroundColor: '#315331', borderWidth: 1, borderColor: '#a4cb77' },
+  primaryButtonText: { color: '#e2f1d5', fontSize: 12, fontWeight: '700' },
+  secondaryButton: { alignItems: 'center', paddingHorizontal: 12, paddingVertical: 8, borderRadius: 4, borderWidth: 1, borderColor: '#42604a' },
+  secondaryButtonText: { color: '#a9bba4', fontSize: 12 },
+  list: { maxHeight: 210, marginTop: 5 },
+  row: { flexDirection: 'row', alignItems: 'center', gap: 6, paddingVertical: 7, borderBottomWidth: 1, borderColor: '#1c2d20' },
+  rowInfo: { flex: 1 },
+  rowName: { color: '#d8e4cc', fontSize: 13, fontWeight: '700' },
+  rowDesc: { color: '#8da38b', fontSize: 11, marginTop: 2 },
+  rowButton: { paddingHorizontal: 8, paddingVertical: 6, borderRadius: 3, borderWidth: 1, borderColor: '#3a5a3d' },
+  issueButton: { borderColor: '#a4cb77' },
+  rowButtonText: { color: '#a4cb77', fontSize: 11, fontWeight: '700' },
+  hint: { color: '#97a392', fontSize: 11, textAlign: 'center', marginTop: 8 },
+});
+
+export default KeyItemCatalogModal;
