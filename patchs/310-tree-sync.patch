#!/bin/sh
# Патч 310: сверка дерева с веткой-источником после цепи 304–309.
#   — возвращён приёмочный тест тест-сеттинга (285: декларация модуля
#     описывается без правок движка; на дереве владельца файл не доехал,
#     потому что патч 285 встал «перекрытым»);
#   — удалён осиротевший robot/weapon_mod_slots.json: знание о слотах
#     живёт в описаниях самих модов (306), файл-дубль никто не читает;
#     удаление больше не ручной шаг.
# Применять из корня репозитория: sh patchs/310-tree-sync.patch
# или цепочкой: ./apply-patch.sh 310 (установщик — версии 309, бутстрап).
patch -p1 <<'PATCH_310_EOF'
diff --git a/docs/changelog.en.md b/docs/changelog.en.md
