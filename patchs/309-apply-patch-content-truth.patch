#!/bin/sh
# Патч 309: установщик патчей переписан по принципу владельца —
# «единственный источник истины — реальное содержимое файлов прямо сейчас».
# Каждый патч проверяется заново при каждом запуске (git apply --check и
# --reverse --check). Журнал состояния, --3way, --mark-through/--mark/--unmark
# и эвристики угадывания удалены. Отложенный патч подтверждается более поздним
# патчем на тех же файлах или следом своих строк. Остатки отката узнаются
# по побайтовому совпадению и воссоздаются. Целостность файлов данных
# проверяется после применения и на повторных запусках.
# Старая запись .git/arena-patches.state больше не используется — можно удалить.
