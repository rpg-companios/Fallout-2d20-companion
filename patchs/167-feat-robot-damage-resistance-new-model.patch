+  if (isNewSlotModelEnabled()) return activeArmorLayers(slotData);
+
   const keys = getLayerKeys(slotData);
   const active = [];
   for (const key of keys) {
@@ -69,6 +75,10 @@ export const getLimbDamageResistance = (limb) => ({
  * @returns {{ physical: number, energy: number, rad: number }}
