+{
+  "treeFamilies": {
+    "family": {
+      "name": "Strip Families",
+      "description": "You are a member of one of the three Strip families. Choose your family: each grants its own advantage."
+    },
+    "chairmen": {
+      "name": "The Chairmen",
+      "description": "Once per scene, you may re-roll one d20 when passing a single skill test based on Charisma (CHA)."
+    },
+    "omerta": {
+      "name": "Omerta",
+      "description": "Chems you administer to other characters have their Addiction property increased by 1. If a chem has no Addiction property, it gains Addiction 1."
+    },
+    "whiteGlove": {
+      "name": "White Glove Society",
+      "description": "Food you cook at a Cooking Station restores 1 more HP. When you butcher a corpse for meat, you gain one additional piece. Charisma (CHA) skill tests involving those outside the White Glove Society increase their Complication range by 1."
+    }
+  },
+  "enclaveRemnant": {
+    "hidden": {
+      "name": "Hidden and Hunted",
+      "description": "Tag one additional skill of your choice: **Sneak** or **Survival**.\n\nThe NCR and the Brotherhood of Steel hunt war criminals like you:\n- the difficulty of reputation tests with the NCR and Brotherhood of Steel is **increased by 2**;\n- if you are exposed, both factions become **hostile**.\n\nOnce per quest (or game session), you may spend **1 Luck point** to locate one of your caches and claim its contents.\n\nIf you have been exposed, upon reaching a cache make a **LCK + Sneak** test with difficulty 1. On a failure, your cache is compromised."
+    }
+  }
+}
