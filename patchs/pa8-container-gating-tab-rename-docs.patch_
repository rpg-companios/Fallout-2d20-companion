+export const tApp = (path) => {
+  // ПРАВИЛО (владелец): никаких фолбэков и хардкода — ключ обязан быть в словаре;
+  // промах ключа — дефект данных, видимый маркер — сам путь.
+  let current = DICTIONARIES[getCurrentLocale()];
