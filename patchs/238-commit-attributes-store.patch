   const resetCharacter = (preserveOrigin = false) => {
     const initialAttributes = createInitialAttributes();
@@ -1479,7 +1435,7 @@ export const CharacterProvider = ({ children }) => {
     resetKitAndRewards,
     resetKitOnly,
