+              <Text style={styles.btnText}>{tLootTrade('issueModal.confirm')}</Text>
+            </TouchableOpacity>
+            <TouchableOpacity style={[styles.btn, styles.cancelBtn]} onPress={onClose}>
+              <Text style={styles.btnText}>{tLootTrade('issueModal.cancel')}</Text>
+            </TouchableOpacity>
+          </View>
+        </View>
+      </View>
+    </Modal>
