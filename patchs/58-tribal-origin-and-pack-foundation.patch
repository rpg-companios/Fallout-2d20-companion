+              <TouchableOpacity
+                style={[styles.modalButton, styles.confirmButton, skillPicks.length !== (pendingTraitData?.totalCount || 0) && styles.disabledButton]}
+                disabled={skillPicks.length !== (pendingTraitData?.totalCount || 0)}
