+export const rollCdValue = (count) => {
+  const n = Math.max(1, Math.min(30, Math.floor(Number(count) || 1)));
+  const res = rollMultipleCombatDice(n);
+  return {
+    total: res.total,
+    rolls: res.rolls || [],
+    effectCount: res.effectCount || 0,
+  };
+};
