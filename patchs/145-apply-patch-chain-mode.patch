From 7d7069619acf614f23e4b24d9e7c4c6eb791a638 Mon Sep 17 00:00:00 2001
From: handylinux <8155246+handylinux@users.noreply.github.com>
Date: Thu, 3 Sep 2026 06:11:48 +0000
Subject: [PATCH] apply-patch.sh: chain mode, auto-detect what is missing

Was: applies exactly one patch, fails if earlier ones are missing.
Now: works out the current level of the tree and applies every
missing patch up to the requested number, in order.

- ./apply-patch.sh 144      apply 144 and anything missing before it
- ./apply-patch.sh 144 --only   single patch, old behaviour
- ./apply-patch.sh --status     what is installed, what is missing

Falls back to --3way when a patch does not apply cleanly, and stops
with a clear report if that leaves conflict markers.

Patches whose context has drifted (long since merged into main) are
skipped rather than blindly reapplied; so are patches older than the
detected level, which otherwise look 'missing' merely because they
create a file that has since moved.

Co-authored-by: arena-agent <297053741+arena-agent@users.noreply.github.com>
---
 apply-patch.sh | 375 +++++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 314 insertions(+), 61 deletions(-)

diff --git a/apply-patch.sh b/apply-patch.sh
index 43a42db..938d9d6 100755
--- a/apply-patch.sh
+++ b/apply-patch.sh
@@ -11,16 +11,66 @@ ROOT_DIR="$(
   pwd
 )"
 
-if [[ $# -ne 1 ]]; then
-  echo "Использование: ./apply-patch.sh <номер патча>"
-  echo "Пример:       ./apply-patch.sh 134"
+usage() {
+  cat <<'USAGE'
+Использование:
+  ./apply-patch.sh <номер>        применить патч и все недостающие до него
+  ./apply-patch.sh <номер> --only  применить ровно один патч, без цепочки
+  ./apply-patch.sh --status        показать, что стоит и чего не хватает
+  ./apply-patch.sh --list          то же, что --status
+
+Примеры:
+  ./apply-patch.sh 144
+  ./apply-patch.sh 144 --only
+  ./apply-patch.sh --status
+
+Скрипт сам определяет, какие патчи уже применены, и ставит только
+недостающие, по возрастанию номера. Порядок соблюдается автоматически,
+помнить, на чём вы остановились, не нужно.
+USAGE
+}
+
+MODE="chain"
+PATCH_ID=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --status|--list)
+      MODE="status"
+      shift
+      ;;
+    --only)
+      MODE="only"
+      shift
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    -*)
+      echo "Ошибка: неизвестный ключ: $1"
+      echo
+      usage
+      exit 2
+      ;;
+    *)
+      if [[ -n "$PATCH_ID" ]]; then
+        echo "Ошибка: номер патча указан дважды: $PATCH_ID и $1"
+        exit 2
+      fi
+      PATCH_ID="$1"
+      shift
+      ;;
+  esac
+done
+
+if [[ "$MODE" != "status" && -z "$PATCH_ID" ]]; then
+  usage
   exit 2
 fi
 
-PATCH_ID="$1"
-
 # Поддерживает номера вроде 134 и 121b.
-if [[ ! "$PATCH_ID" =~ ^[0-9]+[[:alnum:]]*$ ]]; then
+if [[ -n "$PATCH_ID" && ! "$PATCH_ID" =~ ^[0-9]+[[:alnum:]]*$ ]]; then
   echo "Ошибка: некорректный номер патча: $PATCH_ID"
   exit 2
 fi
@@ -45,89 +95,292 @@ FETCHED_COMMIT="$(
 )"
 
 echo "Загружен коммит: $FETCHED_COMMIT"
-echo "Поиск патча №$PATCH_ID..."
+echo
+
+WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/arena-patches.XXXXXX")"
+
+cleanup() {
+  rm -rf -- "$WORKDIR"
+}
+
+trap cleanup EXIT
+
+# --- список всех патчей в ветке, отсортированный по номеру -------------------
 
-mapfile -t PATCH_PATHS < <(
+mapfile -t ALL_PATCHES < <(
   git -C "$ROOT_DIR" ls-tree \
     -r \
     --name-only \
     "$FETCHED_COMMIT" \
     -- patchs |
-  grep -E "^patchs/${PATCH_ID}-[^/]*\\.patch$" ||
+  grep -E '^patchs/[0-9]+[[:alnum:]]*-[^/]*\.patch$' |
+  sed -E 's|^patchs/||' |
+  sort -V ||
   true
 )
 
-if [[ ${#PATCH_PATHS[@]} -eq 0 ]]; then
-  echo "Ошибка: патч №$PATCH_ID не найден в Arena-ветке."
+if [[ ${#ALL_PATCHES[@]} -eq 0 ]]; then
+  echo "Ошибка: в Arena-ветке не найдено ни одного патча."
   exit 1
 fi
 
-if [[ ${#PATCH_PATHS[@]} -gt 1 ]]; then
-  echo "Ошибка: в Arena-ветке найдено несколько патчей №$PATCH_ID:"
-  printf '  %s\n' "${PATCH_PATHS[@]}"
-  exit 1
-fi
+patch_number() {
+  # 144-ammo-weights.patch -> 144 ; 121b-foo.patch -> 121b
+  sed -E 's|^([0-9]+[[:alnum:]]*)-.*$|\1|' <<<"$1"
+}
 
-PATCH_PATH="${PATCH_PATHS[0]}"
-PATCH_NAME="$(basename -- "$PATCH_PATH")"
-TEMP_PATCH="$(mktemp "${TMPDIR:-/tmp}/arena-patch-${PATCH_ID}.XXXXXX.patch")"
+# Сравнение номеров: 121 < 121b < 122. sort -V делает это корректно.
+number_le() {
+  [[ "$1" == "$2" ]] && return 0
+  local first
+  first="$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)"
+  [[ "$first" == "$1" ]]
+}
 
-cleanup() {
-  rm -f -- "$TEMP_PATCH"
+extract_patch() {
+  local name="$1"
+  local dest="$WORKDIR/$name"
+  if [[ ! -f "$dest" ]]; then
+    git -C "$ROOT_DIR" show "${FETCHED_COMMIT}:patchs/${name}" > "$dest"
+  fi
+  printf '%s' "$dest"
 }
 
-trap cleanup EXIT
+# Состояние патча: applied | pending | conflict
+#
+# ВАЖНО: --3way здесь не используется даже с --check, потому что
+# git apply --3way --check реально пишет в индекс и рабочее дерево.
+# Определяем состояние только неразрушающими проверками.
+patch_state() {
+  local file="$1"
+
+  if git -C "$ROOT_DIR" apply --check --whitespace=nowarn "$file" >/dev/null 2>&1; then
+    printf 'pending'
+    return
+  fi
+
+  if git -C "$ROOT_DIR" apply --reverse --check "$file" >/dev/null 2>&1; then
+    printf 'applied'
+    return
+  fi
+
+  # Патч не встаёт целиком и не откатывается целиком. Возможны два случая:
+  # часть изменений уже внесена (тогда --3way справится), либо реальный
+  # конфликт. Различить без записи нельзя, поэтому помечаем как conflict
+  # и предлагаем --3way на этапе применения.
+  printf 'conflict'
+}
+
+# --- режим статуса -----------------------------------------------------------
+
+if [[ "$MODE" == "status" ]]; then
+  echo "Состояние патчей:"
+  echo
+
+  applied_count=0
+  pending_count=0
+  stale_count=0
+  PENDING_LIST=()
 
-echo "Извлечение патча:"
-echo "  $PATCH_PATH"
+  for name in "${ALL_PATCHES[@]}"; do
+    file="$(extract_patch "$name")"
+    state="$(patch_state "$file")"
+    case "$state" in
+      applied)
+        applied_count=$((applied_count + 1))
+        ;;
+      pending)
+        pending_count=$((pending_count + 1))
+        PENDING_LIST+=("$name")
+        ;;
+      conflict)
+        stale_count=$((stale_count + 1))
+        ;;
+    esac
+  done
 
-# Патч извлекается во временный файл.
-# Локальная папка patchs не изменяется.
-git -C "$ROOT_DIR" show \
-  "${FETCHED_COMMIT}:${PATCH_PATH}" \
-  > "$TEMP_PATCH"
+  if [[ $pending_count -gt 0 ]]; then
+    echo "Не хватает — будут поставлены:"
+    printf '  [ ] %s\n' "${PENDING_LIST[@]}"
+    echo
+  fi
 
-if [[ ! -s "$TEMP_PATCH" ]]; then
-  echo "Ошибка: извлечённый патч пуст."
+  echo "Применено точно:      $applied_count"
+  echo "Не хватает:           $pending_count"
+  echo "Контекст разошёлся:   $stale_count  (как правило, давно влиты в main)"
+
+  if [[ $pending_count -eq 0 ]]; then
+    echo
+    echo "Всё актуально."
+  else
+    echo
+    last="${PENDING_LIST[${#PENDING_LIST[@]} - 1]}"
+    echo "Поставить всё недостающее:  ./apply-patch.sh $(patch_number "$last")"
+  fi
+
+  exit 0
+fi
+
+# --- поиск целевого патча ----------------------------------------------------
+
+TARGET=""
+for name in "${ALL_PATCHES[@]}"; do
+  if [[ "$(patch_number "$name")" == "$PATCH_ID" ]]; then
+    if [[ -n "$TARGET" ]]; then
+      echo "Ошибка: в Arena-ветке несколько патчей №$PATCH_ID:"
+      echo "  $TARGET"
+      echo "  $name"
+      exit 1
+    fi
+    TARGET="$name"
+  fi
+done
+
+if [[ -z "$TARGET" ]]; then
+  echo "Ошибка: патч №$PATCH_ID не найден в Arena-ветке."
   exit 1
 fi
 
-echo "Проверка патча: $PATCH_NAME"
+# --- какие патчи ставить -----------------------------------------------------
 
-if git -C "$ROOT_DIR" apply \
-  --check \
-  --whitespace=error \
-  "$TEMP_PATCH"
-then
-  echo "Применение патча..."
+QUEUE=()
 
-  git -C "$ROOT_DIR" apply \
-    --whitespace=error \
-    "$TEMP_PATCH"
+if [[ "$MODE" == "only" ]]; then
+  QUEUE=("$TARGET")
+else
+  for name in "${ALL_PATCHES[@]}"; do
+    number_le "$(patch_number "$name")" "$PATCH_ID" || continue
+    QUEUE+=("$name")
+  done
+fi
 
-  echo
-  echo "Патч успешно применён: $PATCH_NAME"
-  echo "Источник: $REMOTE/$ARENA_BRANCH"
-  echo "Коммит:   $FETCHED_COMMIT"
+echo "Проверка состояния..."
+echo
+
+# «Уровень» дерева — самый свежий достоверно применённый патч.
+# Патчи старее уровня в цепочку не берём: если стоит 142, то 31b
+# ставить бессмысленно (его цель давно переехала, а «применяется»
+# он лишь потому, что создаёт новый файл).
+LEVEL=""
+for name in "${ALL_PATCHES[@]}"; do
+  file="$(extract_patch "$name")"
+  if [[ "$(patch_state "$file")" == "applied" ]]; then
+    LEVEL="$(patch_number "$name")"
+  fi
+done
+
+TODO=()
+SKIPPED=0
+STALE=0
+OLD=0
+
+for name in "${QUEUE[@]}"; do
+  file="$(extract_patch "$name")"
+  state="$(patch_state "$file")"
+  case "$state" in
+    applied)
+      SKIPPED=$((SKIPPED + 1))
+      ;;
+    pending)
+      if [[ -n "$LEVEL" && "$name" != "$TARGET" ]] \
+        && number_le "$(patch_number "$name")" "$LEVEL" \
+        && [[ "$(patch_number "$name")" != "$LEVEL" ]]; then
+        OLD=$((OLD + 1))
+      else
+        TODO+=("$name")
+      fi
+      ;;
+    conflict)
+      # Патч не встаёт и не откатывается целиком. Для старых патчей это
+      # обычно значит «давно влит, а контекст вокруг с тех пор изменился».
+      # Вслепую переприменять такое опасно, поэтому в цепочке пропускаем.
+      # Исключение — сам целевой патч: его пробуем всерьёз, включая --3way.
+      if [[ "$name" == "$TARGET" ]]; then
+        TODO+=("$name")
+      else
+        STALE=$((STALE + 1))
+      fi
+      ;;
+  esac
+done
+
+if [[ ${#TODO[@]} -eq 0 ]]; then
+  echo "Всё уже применено (пропущено: $SKIPPED)."
+  echo "Патч №$PATCH_ID стоит."
   exit 0
 fi
 
-# Если обычная проверка не прошла, проверяем,
-# не был ли этот патч уже применён.
-if git -C "$ROOT_DIR" apply \
-  --reverse \
-  --check \
-  "$TEMP_PATCH" >/dev/null 2>&1
-then
-  echo
-  echo "Патч уже был применён: $PATCH_NAME"
-  exit 0
+echo "Уже стоит: $SKIPPED"
+if [[ $OLD -gt 0 ]]; then
+  echo "Пропущено как старее уровня дерева: $OLD"
 fi
+if [[ $STALE -gt 0 ]]; then
+  echo "Пропущено как устаревшие: $STALE (контекст разошёлся, обычно уже в main)"
+fi
+echo "Будет применено: ${#TODO[@]}"
+for name in "${TODO[@]}"; do
+  printf '  %s\n' "$name"
+done
+echo
+
+# --- применение --------------------------------------------------------------
+
+APPLIED=()
+
+for name in "${TODO[@]}"; do
+  file="$(extract_patch "$name")"
+  printf 'Применение: %s ... ' "$name"
 
+  if git -C "$ROOT_DIR" apply --whitespace=nowarn "$file" >/dev/null 2>&1; then
+    echo "ок"
+    APPLIED+=("$name")
+    continue
+  fi
+
+  # Обычное применение не прошло. Пробуем трёхстороннее слияние:
+  # оно вытягивает недостающий контекст из объектов Git и умеет
+  # ставить патч поверх изменившегося окружения.
+  if git -C "$ROOT_DIR" apply --3way --whitespace=nowarn "$file" >/dev/null 2>&1; then
+    echo "ок (3way)"
+    APPLIED+=("$name")
+    continue
+  fi
+
+  # --3way мог оставить конфликтные маркеры в рабочем дереве.
+  if git -C "$ROOT_DIR" ls-files --unmerged | grep -q .; then
+    echo "КОНФЛИКТ"
+    echo
+    echo "Патч $name применён частично, есть конфликтующие файлы:"
+    git -C "$ROOT_DIR" diff --name-only --diff-filter=U | sed 's|^|  |'
+    echo
+    echo "Разберите маркеры <<<<<<< / >>>>>>> в этих файлах."
+    echo "Откатить всё сделанное этим запуском:"
+    echo "  git checkout -- . && git reset"
+    if [[ ${#APPLIED[@]} -gt 0 ]]; then
+      echo
+      echo "До конфликта успешно применены:"
+      printf '  %s\n' "${APPLIED[@]}"
+    fi
+    exit 1
+  fi
+
+  echo "НЕ УДАЛОСЬ"
+  echo
+  echo "Патч $name не применяется. Рабочее дерево не изменено этим патчем."
+  echo "Вероятные причины:"
+  echo "  - файлы правились вручную;"
+  echo "  - патч рассчитан на другую версию исходников."
+  if [[ ${#APPLIED[@]} -gt 0 ]]; then
+    echo
+    echo "Успешно применены до остановки:"
+    printf '  %s\n' "${APPLIED[@]}"
+  fi
+  exit 1
+done
+
+echo
+echo "Готово. Применено патчей: ${#APPLIED[@]}"
+printf '  %s\n' "${APPLIED[@]}"
 echo
-echo "Ошибка: патч $PATCH_NAME невозможно применить."
-echo "Возможные причины:"
-echo "  - не применены предыдущие патчи;"
-echo "  - исходники отличаются от ожидаемой версии;"
-echo "  - часть изменений патча уже внесена вручную."
-exit 1
\ No newline at end of file
