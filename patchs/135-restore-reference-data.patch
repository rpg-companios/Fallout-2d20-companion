diff --git a/docs/reference-data/lonestar_perks.json b/docs/reference-data/lonestar_perks.json
new file mode 100644
index 0000000..d06cf4d
--- /dev/null
+++ b/docs/reference-data/lonestar_perks.json
@@ -0,0 +1,1038 @@
+[
+  {
+    "sourceUrl": "https://github.com/iggyiggy127/lone-star-character-creator",
+    "name_en": "Action Boy/Girl",
+    "requirements_en": {},
+    "rank": 1,
+    "description_en": "When you spend AP to take an additional major action, you do not suffer the increased skill test difficulty during your second action.",
+    "set": "Core",
+    "source": "lonestar"
+  },
+  {
+    "sourceUrl": "https://github.com/iggyiggy127/lone-star-character-creator",
+    "name_en": "Adamantium Skeleton",
+    "requirements_en": {
+      "E": 7
+    },
+    "rank": 3,
+    "description_en": "When you suffer damage, the amount of damage needed to inflict a critical hit on you increases by your rank in this perk. At rank 1, you suffer a critical hit from 6 or more damage rather than 5 or more. Level req increases by 3 each rank.",
+    "set": "Core",
+    "source": "lonestar"
+  },
+  {
+    "sourceUrl": "https://github.com/iggyiggy127/lone-star-character-creator",
+    "name_en": "Adrenalin Rush",
+    "requirements_en": {
+      "S": 7
+    },
+    "rank": 1,
+    "description_en": "When your health is below its maximum value, you count your STR score as 10 for all purposes when attempting a STR-based skill test or melee attack.",
+    "set": "Core",
+    "source": "lonestar"
+  },
+  {
+    "sourceUrl": "https://github.com/iggyiggy127/lone-star-character-creator",
+    "name_en": "Animal Friend",
+    "requirements_en": {
+      "C": 6
+    },
+    "rank": 2,
+    "description_en": "At rank 1, whenever a creature NPC with the Mammal, Lizard, or Insect keyword would attack you, roll 1 CD; on any result other than an Effect, the creature chooses not to attack you, although it may still attack another character it can target. Level req increases by 3 each rank.",
+    "set": "Core",
+    "source": "lonestar"
+  },
+  {
+    "sourceUrl": "https://github.com/iggyiggy127/lone-star-character-creator",
+    "name_en": "Aquaboy/Aquagirl",
+    "requirements_en": {
+      "E": 5
+    },
+    "rank": 2,
+    "description_en": "Water is your ally. At rank 1, you no longer take radiation damage from swimming in irradiated water, and you can hold your breath for twice as long. At rank 2, enemies add +2 to the difficulty to tests to detect you while submerged underwater. Level req increases by 3 each rank.",
+    "set": "Core",
+    "source": "lonestar"
+  },
+  {
+    "sourceUrl": "https://github.com/iggyiggy127/lone-star-character-creator",
+    "name_en": "Armorer",
+    "requirements_en": {
+      "S": 5,
+      "I": 6
+    },
+    "rank": 4,
+    "description_en": "You can modify armor with armor mods. Each rank unlocks an additional rank of mods: rank 1 unlocks rank 1 mods, rank 2 unlocks rank 2 mods, etc. Level req increases by 4 each rank.",
+    "set": "Core",
+    "source": "lonestar"
+  },
+  {
+    "sourceUrl": "https://github.com/iggyiggy127/lone-star-character-creator",
+    "name_en": "Awareness",
+    "requirements_en": {
+      "P": 7
+    },
+    "rank": 1,
+    "description_en": "When you take the Aim minor action at a target within Close range, you spot their weaknesses and can attack more efficiently. The next attack you make against that target gains the Piercing 1 damage effect, or improves the rating of any existing Piercing X damage effect by 1.",
+    "set": "Core",
+    "source": "lonestar"
+  },
+  {
+    "sourceUrl": "https://github.com/iggyiggy127/lone-star-character-creator",
+    "name_en": "Barbarian",
+    "requirements_en": {
+      "S": 7
+    },
+    "rank": 1,
+    "description_en": "Your physical Damage Resistance increases on all hit locations based on your STR. You do not gain this benefit while wearing Power Armor. STR 7-8: +1 DR; STR 9-10: +2 DR; STR 11+: +3 DR. Not available to robots. Requires Level 4+.",
+    "set": "Core",
+    "source": "lonestar"
+  },
+  {
+    "sourceUrl": "https://github.com/iggyiggy127/lone-star-character-creator",
+    "name_en": "Basher",
+    "requirements_en": {
+      "S": 6
+    },
+    "rank": 1,
+    "description_en": "When you make a melee attack by bashing with your gun, your attack gains the Vicious damage effect.",
+    "set": "Core",
+    "source": "lonestar"
+  },
+  {
+    "sourceUrl": "https://github.com/iggyiggy127/lone-star-character-creator",
+    "name_en": "Better Criticals",
+    "requirements_en": {
+      "L": 9
+    },
+    "rank": 1,
+    "description_en": "When you inflict one or more points of damage to an enemy, you may spend 1 Luck Point to automatically inflict a critical hit, causing an injury.",
+    "set": "Core",
+    "source": "lonestar"
+  },
+  {
+    "sourceUrl": "https://github.com/iggyiggy127/lone-star-character-creator",
+    "name_en": "Big Leagues",
+    "requirements_en": {
+      "S": 8
+    },
+    "rank": 1,
+    "description_en": "When you make a melee attack with a two-handed melee weapon, the weapon gains the Vicious damage effect.",
+    "set": "Core",
+    "source": "lonestar"
+  },
