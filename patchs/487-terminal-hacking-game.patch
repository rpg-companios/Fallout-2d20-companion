+        index = bracket.end;
+        continue;
+      }
+      chunks.push({ kind: 'junk', text: game?.board?.[index] || '.', key: `cell-${index}` });
+      index += 1;
+    }
+    return (
+      <View key={`${columnIndex}-${lineIndex}`} style={styles.codeLine}>
+        {chunks.map((chunk) => {
+          if (chunk.kind === 'word') {
