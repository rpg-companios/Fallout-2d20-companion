-      
-      equipItem: (itemId) => {
-        const items = { ...get().items };
-        if (!items[itemId]) return;
-        
-        items[itemId].equipped = true;
-        
-        set({ items });
-        triggerDependentCalculations();
-      },
-      
-      unequipItem: (itemId) => {
-        const items = { ...get().items };
-        if (!items[itemId]) return;
