diff --git a/domain/meleeSlot.js b/domain/meleeSlot.js
new file mode 100644
--- /dev/null
+++ b/domain/meleeSlot.js

index 0000000..909d2b6
--- /dev/null
+++ b/domain/meleeSlot.js
@@ -0,0 +1,39 @@
+// domain/meleeSlot.js
+// Виртуальная рукопашная атака всегда присутствует в первом слоте оружия:
+//   - у людей — кулаки (`unarmed_human`, weaponType 'Unarmed', isBuiltin);
+//   - у роботов — манипулятор конечности (weaponType 'Unarmed', isBuiltin).
+// Она не предмет инвентаря, её нельзя снять/продать. Экран снаряжения может
+// СКРЫТЬ её карточку по настройке игрока — тогда первый слот занимает обычное
+// оружие. Этот модуль знает только механизм «что считать рукопашной атакой»
+// и как её отфильтровать; никаких данных конкретного сеттинга и UI тут нет.
+
+/**
+ * Является ли оружие виртуальной рукопашной атакой персонажа.
+ *
+ * Критерий — ДАННЫЕ оружия, а не догадки по id ориджина:
+ *   - weaponType / weapon_type === 'Unarmed' (это тип «без оружия/руки»);
+ *   - и при этом оно встроенное (isBuiltin): руки не лежат в инвентаре.
+ * Обычное рукопашное оружие (нож, кастет) имеет weaponType 'Melee' и носится
+ * как предмет — оно НЕ скрывается этим тумблером.
+ *
+ * @param {object|null|undefined} weapon
+ * @returns {boolean}
+ */
+export function isUnarmedAttack(weapon) {
+  if (!weapon) return false;
+  const weaponType = weapon.weaponType ?? weapon.weapon_type;
+  return weaponType === 'Unarmed' && weapon.isBuiltin === true;
+}
+
+/**
+ * Убирает виртуальную рукопашную атаку из списка, если игрок её скрыл.
+ * Прочее оружие (включая Melee-предметы) остаётся без изменений.
+ *
+ * @param {Array<object>} weapons
+ * @param {boolean} visible   показывать ли рукопашную атаку
+ * @returns {Array<object>}
+ */
+export function applyUnarmedVisibility(weapons, visible) {
+  if (visible) return weapons;
+  return (weapons || []).filter((w) => !isUnarmedAttack(w));
+}
