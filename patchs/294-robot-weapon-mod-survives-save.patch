+## Исправление — Установленный мод робо-оружия выживал только до сохранения (патч 294)
+
+`toModIds` (domain/robotSlots.js) первым делом смотрел на массив `modIds` — даже
+пустой — и не доходил до `appliedMods`, которые пишет модалка установки модов.
+У робо-слота, восстановленного из сейва, `heldWeapon.modIds` пуст, поэтому после
+установки конденсатора в Головной лазер мод жил в `appliedMods`, но при первом
+же сохранении слота `serializeSlot` выгружал пустоту: конденсатор пропадал,
+статы возвращались к базе. Теперь `appliedMods` — истина экрана: приоритет
+безусловный, пустой объект означает «модов нет» (снятие мода тоже работает),
+`modIds` остаётся источником для худых сейвов без объекта оружия.
+
+Заперто тестами (`__tests__/robot/assaultron-head-laser-mods.test.js`): смешанная
+форма (пустой `modIds` + свежие `appliedMods`), снятие мода, худой сейв, полный
+раунд-трип сейв → экран → модалка → сейв → экран и применение конвейером
+(лазер 5/115/8 + конденсатор Mk III → 6/119/8).
+
 ## Исправление — Конденсаторы Головного лазера в модалке установки (патч 293)
 
 > Сообщение владельца (2026-09-21): «Штурмотрон не получает моды для головного лазера. Их нет в модалке модернизации оружия» (патч 292 установлен).
diff --git a/domain/robotSlots.js b/domain/robotSlots.js
index c52491a..18b039b 100644
--- a/domain/robotSlots.js
+++ b/domain/robotSlots.js
@@ -56,9 +56,14 @@ const EMPTY_ARMOR_LAYERS = () => ({ frame: null, plating: null, armor: null });
  */
 export const toModIds = (source) => {
   if (!source || typeof source !== 'object') return [];
-  if (Array.isArray(source.modIds)) return source.modIds.filter(Boolean);
+  // appliedMods — истина экрана: модалка WeaponModificationModal пишет именно её,
+  // а modIds у восстановленного heldWeapon остаётся служебным (часто пустым) поле-
+  // выгрузки. Если массив смотрит первым, пустой modIds маскирует свежие appliedMods
+  // и установленный мод теряется при сохранении слота. Пустой объект appliedMods —
+  // «модов нет» (снятие мода тоже истина экрана), поэтому приоритет безусловно.
   const map = source.appliedMods;
   if (map && typeof map === 'object') return Object.values(map).filter(Boolean);
+  if (Array.isArray(source.modIds)) return source.modIds.filter(Boolean);
   return [];
 };
 
PATCH_294_EOF
