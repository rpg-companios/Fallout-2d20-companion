-export const CURRENT_SCHEMA_VERSION = 19;
+// v20 — роботы: миграция старых сейвов на новый формат:
+//       - defaultPlating теперь {} у всех роботов, убираем авто-обшивку standard из старых сейвов
+//       - assaultron: руки должны иметь когти robot_weapon_claw (builtinWeaponId), а не манипулятор
+//       - комплекты роботов: химия/еда/патроны не должны быть equipped=true (whitelist)
+//       - недостающие конечности из bodyPlan.defaults заполняются
+export const CURRENT_SCHEMA_VERSION = 20;
 
 // Версия, которая ставится при отсутствии schemaVersion в сохранении
 // (старые сохранения без поля — считаем v0, текущим форматом).
