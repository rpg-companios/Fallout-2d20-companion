+    if (!Array.isArray(arr)) return;
+    arr.forEach((e) => {
+      const id = (typeof e === 'object' && e ? e[idKey] : e);
+      if (id && id !== '–') map.set(id, e && e.value != null ? { [idKey]: id, value: e.value } : { [idKey]: id });
+    });
