new file mode 100644
index 0000000..2b9ec5a
--- /dev/null
+++ b/modules/fallout/data/equipmentKits/purchase.json
@@ -0,0 +1,17 @@
+{
+  "purchase_equipment": {
+    "universal": true,
+    "items": [
+      {
+        "type": "purchase",
+        "itemType": "currency",
+        "maxRarity": 2,
+        "caps": [
