+### Этап 4, шаг 1 (патч 171): новая модель включена
+
+Флаг перевёрнут: `isNewSlotModelEnabled()` по умолчанию возвращает `true`.
+Приложение живёт по новой модели — это и есть переключение.
+
+Сделано в два приёма сознательно:
+
+* **171 — переключение.** Одна правка, откат одной правкой. Старые ветки
+  лежат рядом и доступны через `ROBOT_NEW_SLOT_MODEL=0` — аварийный
+  выключатель на случай, если вживую что-то поедет;
+* **172 — удаление.** Чистка старых веток, самого флага и тестов, которые
+  закрепляли старое поведение.
+
+Сейвы при этом НЕ меняют формы: новая модель читает оба вида состояния
+(`normalizeSlot`), поэтому старые сохранения работают и до миграции этапа 5.
+
+| Режим | Тестов | Зелёных |
+|---|---|---|
+| по умолчанию (новая модель) | 261 | **261** |
+| `ROBOT_NEW_SLOT_MODEL=0` (старая) | 261 | **261** |
+
 #### Что осталось по этапу 3
 
 | Шаг | Точка использования | Статус |
diff --git a/domain/robotSlots.js b/domain/robotSlots.js
index 71bcfcb..5c76471 100644
--- a/domain/robotSlots.js
+++ b/domain/robotSlots.js
@@ -59,17 +59,25 @@ export const LIMB_TYPE_BY_ROBOT_LOCATION = {
 
 let flagOverride = null;
 
-const envEnabled = () =>
-  typeof process !== 'undefined' && process.env?.ROBOT_NEW_SLOT_MODEL === '1';
+// ROBOT_NEW_SLOT_MODEL=0 — аварийный выключатель: вернуть старую модель,
+// не откатывая код. Полезно, если после включения что-то поехало вживую.
+const envDisabled = () =>
+  typeof process !== 'undefined' && process.env?.ROBOT_NEW_SLOT_MODEL === '0';
 
 /** Включить/выключить новую модель вручную (null — вернуться к умолчанию). */
 export function setNewSlotModelEnabled(value) {
   flagOverride = value === null ? null : Boolean(value);
 }
 
-/** Включена ли новая модель слотов. */
+/**
+ * Включена ли новая модель слотов.
+ *
+ * Этап 4: новая модель включена по умолчанию. Старые ветки пока лежат рядом
+ * и снимаются следующим патчем — до их удаления их можно вернуть переменной
+ * окружения ROBOT_NEW_SLOT_MODEL=0.
+ */
 export function isNewSlotModelEnabled() {
-  return flagOverride === null ? envEnabled() : flagOverride;
+  return flagOverride === null ? !envDisabled() : flagOverride;
 }
 
