Date: Fri, 04 Sep 2026 08:56:58 +0000
Subject: [PATCH] feat(robot): enable new slot model by default
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Этап 4, шаг 1: новая модель включена по умолчанию.

isNewSlotModelEnabled() теперь возвращает true, если иное не задано явно.
Приложение живёт по новой модели — это и есть переключение.

ROBOT_NEW_SLOT_MODEL=0 — аварийный выключатель: возвращает старую ветку,
пока она не удалена (патч 172). Полезно, если после включения что-то
поехало вживую.

Сейвы НЕ меняют формы: новая модель читает оба вида состояния
(normalizeSlot), поэтому старые сохранения работают и до миграции этапа 5.

Тесты: поправлены две проверки про умолчание флага. Прогон 261 теста —
261 зелёный и с новой моделью по умолчанию, и с ROBOT_NEW_SLOT_MODEL=0.

Следующий патч (172) удаляет старые ветки, сам флаг и тесты, закреплявшие
старое поведение.

---
 3 files changed, 40 insertions(+), 11 deletions(-)

diff --git a/__tests__/robot/robot-slot-model-flag.test.js b/__tests__/robot/robot-slot-model-flag.test.js
index 5470904..cf21e36 100644
--- a/__tests__/robot/robot-slot-model-flag.test.js
+++ b/__tests__/robot/robot-slot-model-flag.test.js
@@ -73,15 +73,15 @@ const handyNanny = () => initRobotSlots('misterHandy', [
 
 afterEach(() => setNewSlotModelEnabled(null));
 
-// Флаг можно поднять из окружения: ROBOT_NEW_SLOT_MODEL=1 прогоняет весь
-// набор тестов под новой моделью и показывает, что сломается на этапе 4.
-const envOn = () =>
-  typeof process !== 'undefined' && process.env?.ROBOT_NEW_SLOT_MODEL === '1';
+// Этап 4: новая модель включена по умолчанию. ROBOT_NEW_SLOT_MODEL=0 —
+// аварийный выключатель, возвращающий старую ветку до её удаления.
+const envOff = () =>
+  typeof process !== 'undefined' && process.env?.ROBOT_NEW_SLOT_MODEL === '0';
 
 describe('фича-флаг новой модели', () => {
-  it('по умолчанию выключен (если окружение не велит иного)', () => {
+  it('по умолчанию включен (кроме аварийного выключателя в окружении)', () => {
     setNewSlotModelEnabled(null);
-    expect(isNewSlotModelEnabled()).toBe(envOn());
+    expect(isNewSlotModelEnabled()).toBe(!envOff());
   });
 
   it('ручной режим приоритетнее окружения и возвращается к нему', () => {
@@ -90,7 +90,7 @@ describe('фича-флаг новой модели', () => {
     setNewSlotModelEnabled(false);
     expect(isNewSlotModelEnabled()).toBe(false);
     setNewSlotModelEnabled(null);
-    expect(isNewSlotModelEnabled()).toBe(envOn());
+    expect(isNewSlotModelEnabled()).toBe(!envOff());
   });
 });
 
