++    const garbage = ['', 'GM-123456', 'GM-000000', 'GM-7O3K9M', 'GM-7I3K9M', 'GM-7L3K9M', 'G-7Q3K9M', 'LONGP-7Q3K9M', 'GM-7Q3K9', 'GM-7Q3K9MX'];
