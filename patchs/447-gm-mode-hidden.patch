+// __tests__/room/gm-mode-gate-447.test.js
+//
+// 447: «Админ» (вход в GM-режим) скрыт из UI — админка не закончена,
+// дальше её ждёт большая работа и серверная часть: «сервер состояний»,
+// который через интернет сведёт клиента и админа и будет транслировать
+// админу состояние персонажа клиента. Механика комнат сохранена целиком.
+//
+// Канон погашения — как у «Игрового сеттинга» (446): константа-выключатель
+// в HomeScreen, обратный возврат в UI — одна правка флага.
+
+import { describe, it, expect } from 'vitest';
+import { readFileSync } from 'fs';
+import { resolve } from 'path';
+
+const HOME_SCREEN = resolve(__dirname, '../../components/screens/HomeScreen/HomeScreen.js');
+const RU_HOME = resolve(__dirname, '../../i18n/ru-RU/screens/home/screen.json');
+const EN_HOME = resolve(__dirname, '../../i18n/en-EN/screens/home/screen.json');
+
+describe('447: кнопка «Админ» (GM-режим) скрыта выключателем', () => {
+  it('константа-выключатель объявлена и стоит в false', () => {
+    const src = readFileSync(HOME_SCREEN, 'utf8');
+    expect(src).toContain('const GM_MODE_UI_ENABLED = false;');
+    // в комментарии зафиксирована причина и путь возврата (сервер состояний)
+    expect(src).toContain('сервер состояний');
+    expect(src).toContain('Возврат в UI = GM_MODE_UI_ENABLED = true.');
+  });
+
+  it('кнопка в шапке не рисуется без флага, а выход из GM — остаётся', () => {
+    const src = readFileSync(HOME_SCREEN, 'utf8');
+    // рендер: (GM_MODE_UI_ENABLED || isGmMode) && roomServerAvailable
+    expect(src).toMatch(/\(\(GM_MODE_UI_ENABLED \|\| isGmMode\) && roomServerAvailable\) && \(/);
+    // сам JSX кнопки админа сохранён (не удалён, только погашен)
+    expect(src).toContain('styles.adminButton');
+    expect(src).toContain('handleToggleUiMode');
+  });
+
+  it('механика комнат нетронута: стор, протокол, клиент на месте', () => {
+    const src = readFileSync(HOME_SCREEN, 'utf8');
+    expect(src).toContain("import { isRoomServerConfigured } from '../../../src/room/roomClient';");
+    expect(src).toContain('isRoomServerConfigured()');
+    expect(src).toContain('handleToggleUiMode');
+    // эффекты переподключения к комнатам не погашены — сеть живая
+    expect(src).toContain('room.leave:failed');
+  });
+
+  it('строки gm.enter/gm.exit остались в обеих локалях (фича отложена, не удалена)', () => {
+    const ru = JSON.parse(readFileSync(RU_HOME, 'utf8'));
+    const en = JSON.parse(readFileSync(EN_HOME, 'utf8'));
+    expect(ru.gm.enter).toBe('Админ');
+    expect(ru.gm.exit).toBe('Пользователь');
+    expect(en.gm.enter).toBe('Admin');
+    expect(en.gm.exit).toBe('User');
+  });
+});
diff --git a/__tests__/room/room-client.test.js b/__tests__/room/room-client.test.js
new file mode 100644
index 0000000..7feb33f
--- /dev/null
+++ b/__tests__/room/room-client.test.js
@@ -0,0 +1,161 @@
+// roomClient (gm-rooms §3.6): очередь до открытия, flush по onopen,
+// heartbeat, reconnect с backoff, ручное закрытие без переподключения.
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { createRoomClient } from '../../src/room/roomClient';
+import { ROOM_MESSAGE } from '../../src/room/roomProtocol';
+
+class MockWebSocket {
+  static OPEN = 1;
+
+  constructor(url) {
+    this.url = url;
+    this.readyState = 0;
+    this.sent = [];
+    this.onopen = null;
+    this.onclose = null;
+    this.onerror = null;
+    this.onmessage = null;
+    MockWebSocket.instances.push(this);
+  }
+
+  open() {
+    this.readyState = MockWebSocket.OPEN;
+    this.onopen?.();
+  }
+
+  close() {
+    this.readyState = 3;
+    this.onclose?.();
+  }
+
+  send(data) {
+    this.sent.push(JSON.parse(data));
+  }
+
+  emit(payload) {
+    this.onmessage?.({ data: JSON.stringify(payload) });
+  }
+}
+
+describe('roomClient', () => {
+  let statuses;
+  let messages;
+  let factory;
+
+  beforeEach(() => {
+    vi.useFakeTimers();
+    MockWebSocket.instances = [];
+    statuses = [];
+    messages = [];
+    factory = (url) => new MockWebSocket(url);
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  const makeClient = (overrides = {}) => createRoomClient({
+    url: 'ws://test/ws',
+    clientId: 'c1',
+    onStatus: (s) => statuses.push(s),
+    onMessage: (m) => messages.push(m),
+    webSocketFactory: factory,
+    ...overrides,
+  });
+
+  it('очередь до открытия, flush и конверт протокола по onopen', () => {
+    const client = makeClient();
+    expect(statuses).toEqual(['connecting']);
+    client.send(ROOM_MESSAGE.ROOM_JOIN, { code: 'GM-AAAAAA' }, 'GM-AAAAAA');
+    const socket = MockWebSocket.instances[0];
+    expect(socket.sent).toHaveLength(0);
+
+    socket.open();
+    expect(statuses).toEqual(['connecting', 'online']);
+    expect(socket.sent).toHaveLength(1);
+    expect(socket.sent[0]).toMatchObject({
+      v: 1,
+      type: ROOM_MESSAGE.ROOM_JOIN,
+      roomCode: 'GM-AAAAAA',
+      clientId: 'c1',
+    });
+    expect(socket.sent[0].payload.code).toBe('GM-AAAAAA');
+    client.close();
+  });
+
+  it('heartbeat шлёт presence.ping по открытому сокету', () => {
+    const client = makeClient();
+    const socket = MockWebSocket.instances[0];
+    socket.open();
+    socket.sent.length = 0;
+    vi.advanceTimersByTime(26 * 1000);
+    expect(socket.sent.some((m) => m.type === ROOM_MESSAGE.PRESENCE_PING)).toBe(true);
+    client.close();
+  });
+
+  it('входящие конверты парсятся и уходят обработчику; мусор игнорируется', () => {
+    makeClient();
+    const socket = MockWebSocket.instances[0];
+    socket.open();
+    socket.emit({ type: 'x', payload: { a: 1 } });
+    socket.onmessage?.({ data: 'не json' });
+    expect(messages).toEqual([{ type: 'x', payload: { a: 1 } }]);
+  });
+
+  it('reconnect с backoff: безуспешные попытки растут (1с → 2с)', () => {
+    makeClient();
+    const first = MockWebSocket.instances[0];
+    first.open();
+    first.close();
+    expect(statuses.at(-1)).toBe('offline');
+    expect(MockWebSocket.instances).toHaveLength(1);
+
+    // attempt 0 → 1000 мс.
+    vi.advanceTimersByTime(1000);
+    expect(MockWebSocket.instances).toHaveLength(2);
+    // Вторая попытка не открылась (сокет закрылся до onopen) → attempt 1 → 2000 мс.
+    MockWebSocket.instances[1].close();
+
+    vi.advanceTimersByTime(1999);
+    expect(MockWebSocket.instances).toHaveLength(2);
+    vi.advanceTimersByTime(1);
+    expect(MockWebSocket.instances).toHaveLength(3);
+  });
+
+  it('успешное открытие сбрасывает backoff (снова 1с)', () => {
+    makeClient();
+    const first = MockWebSocket.instances[0];
+    first.open();
+    first.close();
+    vi.advanceTimersByTime(1000);
+    const second = MockWebSocket.instances[1];
+    second.open(); // успех → attempt = 0
+    second.close();
+    vi.advanceTimersByTime(1000);
+    expect(MockWebSocket.instances).toHaveLength(3);
+  });
+
+  it('ручное close не переподключается и глушит очередь отправки статусом offline', () => {
+    const client = makeClient();
+    const socket = MockWebSocket.instances[0];
+    socket.open();
+    client.close();
+    expect(statuses.at(-1)).toBe('offline');
+    vi.advanceTimersByTime(30 * 1000);
+    expect(MockWebSocket.instances).toHaveLength(1);
+  });
+
+  it('пользовательская кривая задержек инъецируется (тесты не зависят от генератора)', () => {
+    const delays = [];
+    makeClient({ reconnectDelayMs: (attempt) => { delays.push(attempt); return 5; } });
+    const first = MockWebSocket.instances[0];
+    first.open();
+    first.close();
+    vi.advanceTimersByTime(5);
+    // Вторая попытка не открылась → растущий attempt = 1.
+    MockWebSocket.instances[1].close();
+    vi.advanceTimersByTime(5);
+    expect(delays).toEqual([0, 1]);
+  });
+});
diff --git a/__tests__/room/room-code.test.js b/__tests__/room/room-code.test.js
new file mode 100644
index 0000000..d0274d9
--- /dev/null
+++ b/__tests__/room/room-code.test.js
@@ -0,0 +1,91 @@
+// Адрес комнаты (gm-rooms §3.2): клиентские и серверные правила читают
+// код ОДИНАКОВО — зеркала server/roomCode.js и src/room/roomCode.ts.
+// Заслон: алфавит без неоднозначных символов, длина по умолчанию 6,
+// коллизии при генерации перегенерируются (дубликат невозможен).
+
+import { describe, expect, it } from 'vitest';
+import serverCodes from '../../server/roomCode.js';
+import {
+  DEFAULT_ROOM_PREFIX,
+  ROOM_CODE_ALPHABET,
+  ROOM_CODE_LENGTH,
+  formatRoomCodeForDisplay,
+  parseRoomAddress,
+  toCanonicalRoomCode,
+} from '../../src/room/roomCode';
+
+describe('roomCode: правила совпадают на клиенте и сервере', () => {
+  const samples = [
+    'GM-7Q3K9M',
+    'gm-7q3-k9m',
+    'GM7Q3K9M',
+    '  gm 7q3 k9m ',
+    'VLT-2A4B6C',
+  ];
+
+  it('канонизация: одна и та же строка из любых форм', () => {
+    for (const sample of samples) {
+      expect(toCanonicalRoomCode(sample)).toBe(serverCodes.toCanonicalRoomCode(sample));
+    }
+    expect(toCanonicalRoomCode('GM-7Q3K9M')).toBe('GM-7Q3K9M');
+    expect(toCanonicalRoomCode('gm-7q3-k9m')).toBe('GM-7Q3K9M');
+    expect(toCanonicalRoomCode('VLT2A4B6C')).toBe('VLT-2A4B6C');
+  });
+
+  it('мусор и неоднозначные символы — null (0/O, 1/I/L в кодах отсутствуют)', () => {
+    // «GM-A7Q3K9» — НЕ мусор: валидный код алфавита (учитывается в samples выше).
+    const garbage = ['', 'GM-123456', 'GM-000000', 'GM-7O3K9M', 'GM-7I3K9M', 'GM-7L3K9M', 'G-7Q3K9M', 'LONGP-7Q3K9M', 'GM-7Q3K9', 'GM-7Q3K9MX'];
+    for (const item of garbage) {
+      expect(toCanonicalRoomCode(item), `client: ${item}`).toBeNull();
+      expect(serverCodes.toCanonicalRoomCode(item), `server: ${item}`).toBeNull();
+    }
+  });
+
+  it('алфавит: 31 символ, без 0/O/1/I/L', () => {
+    expect(ROOM_CODE_ALPHABET).toHaveLength(31);
+    expect(ROOM_CODE_ALPHABET).toBe(serverCodes.CODE_ALPHABET);
+    for (const banned of ['0', 'O', '1', 'I', 'L']) {
+      expect(ROOM_CODE_ALPHABET.includes(banned)).toBe(false);
+    }
+  });
+
+  it('отображение группами по 3: GM-7Q3-K9M', () => {
+    expect(formatRoomCodeForDisplay('GM-7Q3K9M')).toBe('GM-7Q3-K9M');
+    expect(serverCodes.formatRoomCodeForDisplay('gm7q3k9m')).toBe('GM-7Q3-K9M');
+    // Нечитаемый ввод возвращается как есть (никаких исключений в UI).
+    expect(formatRoomCodeForDisplay('???')).toBe('???');
+  });
+
+  it('parseRoomAddress: префикс 2–3 буквы + код 6 знаков', () => {
+    expect(parseRoomAddress('GM-7Q3K9M')).toEqual({ prefix: 'GM', code: '7Q3K9M' });
+    expect(parseRoomAddress('VLT-2A4B6C')).toEqual({ prefix: 'VLT', code: '2A4B6C' });
+    expect(DEFAULT_ROOM_PREFIX).toBe('GM');
+    expect(ROOM_CODE_LENGTH).toBe(6);
+  });
+});
+
+describe('roomCode: генератор (сервер)', () => {
+  it('коды заданной длины из алфавита', () => {
+    for (let i = 0; i < 200; i += 1) {
+      const code = serverCodes.generateRoomCode();
+      expect(code).toHaveLength(6);
+      expect([...code].every((char) => serverCodes.CODE_ALPHABET.includes(char))).toBe(true);
+    }
+  });
+
+  it('rng точечно подменяется: «коллизийная» последовательность детектируема вызывающим', () => {
+    // Все вызовы rng возвращают 0 → всегда 'AAAAAA'. Уникальность обеспечивает
+    // вызывающий (реестр) циклом генерации — см. room-registry.test.js.
+    const constant = serverCodes.generateRoomCode(6, () => 0);
+    expect(constant).toBe('AAAAAA');
+  });
+
+  it('префикс: чистка до 2–3 букв, дефолт GM', () => {
+    expect(serverCodes.sanitizePrefix('vlt')).toBe('VLT');
+    expect(serverCodes.sanitizePrefix('ab')).toBe('AB');
+    expect(serverCodes.sanitizePrefix('abcd')).toBe('ABC');
+    expect(serverCodes.sanitizePrefix('g1')).toBe('GM');
+    expect(serverCodes.sanitizePrefix('')).toBe('GM');
+    expect(serverCodes.sanitizePrefix(undefined)).toBe('GM');
+  });
+});
diff --git a/__tests__/room/room-registry.test.js b/__tests__/room/room-registry.test.js
new file mode 100644
index 0000000..c1dae74
--- /dev/null
+++ b/__tests__/room/room-registry.test.js
@@ -0,0 +1,143 @@
+// Реестр комнат (gm-rooms §3.2–§3.3): создание с уникальным кодом,
+// квоты, вход/выход, снапшоты (LWW), TTL пустых, восстановление по токену.
+
+import { describe, expect, it } from 'vitest';
+import { createRoomRegistry } from '../../server/roomRegistry.js';
+import { ERROR_CODE, LIMITS } from '../../server/protocol.js';
+
+const makeRegistry = (overrides = {}) => createRoomRegistry(overrides);
+
+describe('roomRegistry: создание комнаты', () => {
+  it('код генерируется сервером, префикс дефолтный GM', () => {
+    const registry = makeRegistry();
+    const { room } = registry.createRoom({ clientId: 'gm-1', name: 'Стол #1' });
+    expect(room.code).toMatch(/^GM-[A-Z2-9]{6}$/);
+    expect(room.name).toBe('Стол #1');
+    expect(room.ownerToken).toHaveLength(32);
+    expect(room.ownerClientId).toBe('gm-1');
+  });
+
+  it('префикс мастера (сеттинга): sanitize + никакого хардкода GM', () => {
+    const registry = makeRegistry();
+    const { room } = registry.createRoom({ clientId: 'gm-1', prefix: 'vlt!', name: 'Убежище' });
+    expect(room.code.startsWith('VLT-')).toBe(true);
+  });
+
+  it('дубликат кода исключён конструктивно: коллизия → перегенерация', () => {
+    // rng отдаёт нули первые 12 вызовов (две попытки по 6 знаков = 'AAAAAA'),
+    // дальше — меняющаяся последовательность. Реестр обязан: первую комнату
+    // создать 'GM-AAAAAA', вторую — после повтора генерации с ДРУГИМ кодом.
+    let call = 0;
+    const scriptedRng = () => { call += 1; return call <= 12 ? 0 : call % 31; };
+    const registry = makeRegistry({ rng: scriptedRng });
+    const first = registry.createRoom({ clientId: 'gm' });
+    const second = registry.createRoom({ clientId: 'gm' });
+    expect(first.room.code).toBe('GM-AAAAAA');
+    expect(second.error).toBeUndefined();
+    expect(second.room.code).not.toBe(first.room.code);
+  });
+
+  it('квота комнат на мастера', () => {
+    const registry = makeRegistry({ limits: { ...LIMITS, MAX_ROOMS_PER_OWNER: 2 } });
+    expect(registry.createRoom({ clientId: 'gm' }).error).toBeUndefined();
+    expect(registry.createRoom({ clientId: 'gm' }).error).toBeUndefined();
+    const third = registry.createRoom({ clientId: 'gm' });
+    expect(third.error).toBe(ERROR_CODE.ROOM_QUOTA_EXCEEDED);
+    // Другой мастер — свободен.
+    expect(registry.createRoom({ clientId: 'gm-2' }).error).toBeUndefined();
+  });
+
+  it('квота созданий на IP в сутки', () => {
+    const registry = makeRegistry({ limits: { ...LIMITS, MAX_ROOMS_PER_IP_PER_DAY: 1 } });
+    expect(registry.createRoom({ clientId: 'gm-1', ip: '1.1.1.1' }).error).toBeUndefined();
+    expect(registry.createRoom({ clientId: 'gm-2', ip: '1.1.1.1' }).error).toBe(ERROR_CODE.ROOM_QUOTA_EXCEEDED);
+    expect(registry.createRoom({ clientId: 'gm-2', ip: '2.2.2.2' }).error).toBeUndefined();
+  });
+
+  it('восстановление комнаты: requestedCode + ownerToken', () => {
+    const registry = makeRegistry();
+    const { room } = registry.createRoom({ clientId: 'gm-1', name: 'Стол' });
+    // Тот же код без токена/с чужим токеном — отказ.
+    expect(registry.createRoom({ clientId: 'thief', requestedCode: room.code }).error)
+      .toBe(ERROR_CODE.ROOM_CODE_TAKEN);
+    expect(registry.createRoom({ clientId: 'thief', requestedCode: room.code, ownerToken: 'wrong' }).error)
+      .toBe(ERROR_CODE.ROOM_CODE_TAKEN);
+    // Свой токен — привязка (перезапуск сервера не теряем, но и здесь сценарий
+    // «другое устройство мастера»): владелец переназначается.
+    const rebound = registry.createRoom({ clientId: 'gm-1-device-2', requestedCode: room.code, ownerToken: room.ownerToken });
+    expect(rebound.rebound).toBe(true);
+    expect(rebound.room.ownerClientId).toBe('gm-1-device-2');
+  });
+});
+
+describe('roomRegistry: вход, выход, presence', () => {
+  it('join/leave + состояние комнаты', () => {
+    const registry = makeRegistry();
+    const { room } = registry.createRoom({ clientId: 'gm', name: 'Стол' });
+    const joined = registry.joinRoom({ code: room.code, clientId: 'p1', name: 'Иван', role: 'player' });
+    expect(joined.error).toBeUndefined();
+    expect(joined.state.members).toEqual([{ clientId: 'p1', name: 'Иван', role: 'player' }]);
+    const left = registry.leaveRoom({ code: room.code, clientId: 'p1' });
+    expect(left.left).toBe(true);
+    expect(registry.getState(room.code).members).toEqual([]);
+  });
+
+  it('нормализация роли и имени', () => {
+    const registry = makeRegistry();
+    const { room } = registry.createRoom({ clientId: 'gm' });
+    registry.joinRoom({ code: room.code, clientId: 'p1', name: '  ', role: 'whatever' });
+    expect(registry.getState(room.code).members[0]).toEqual({ clientId: 'p1', name: '—', role: 'player' });
+  });
+
+  it('комната не найдена / переполнена', () => {
+    const registry = makeRegistry({ limits: { ...LIMITS, MAX_MEMBERS_PER_ROOM: 1 } });
+    expect(registry.joinRoom({ code: 'GM-XXXXXX', clientId: 'p1' }).error).toBe(ERROR_CODE.ROOM_NOT_FOUND);
+    const { room } = registry.createRoom({ clientId: 'gm' });
+    expect(registry.joinRoom({ code: room.code, clientId: 'p1' }).error).toBeUndefined();
+    expect(registry.joinRoom({ code: room.code, clientId: 'p2' }).error).toBe(ERROR_CODE.ROOM_FULL);
+    // Переподключение уже вошедшего не считается новым членом.
+    expect(registry.joinRoom({ code: room.code, clientId: 'p1', name: 'Снова' }).error).toBeUndefined();
+    expect(registry.getState(room.code).members).toHaveLength(1);
+  });
+
+  it('рейт-лимит входов с одного IP', () => {
+    const registry = makeRegistry({ limits: { ...LIMITS, MAX_JOINS_PER_IP_PER_MINUTE: 2 } });
+    const { room } = registry.createRoom({ clientId: 'gm' });
+    registry.joinRoom({ code: room.code, clientId: 'p1', ip: '1.1.1.1' });
+    registry.joinRoom({ code: room.code, clientId: 'p2', ip: '1.1.1.1' });
+    expect(registry.joinRoom({ code: room.code, clientId: 'p3', ip: '1.1.1.1' }).error)
+      .toBe(ERROR_CODE.RATE_LIMITED);
+  });
+});
+
+describe('roomRegistry: снапшоты и TTL', () => {
+  it('последний снапшот по LWW: старая ревизия не затирает новую', () => {
+    const registry = makeRegistry();
+    const { room } = registry.createRoom({ clientId: 'gm' });
+    registry.joinRoom({ code: room.code, clientId: 'p1', name: 'Иван' });
+    expect(registry.putSnapshot({ code: room.code, characterId: 'c1', revision: 5, snapshot: { hp: 5 }, fromClientId: 'p1' }).stored).toBe(true);
+    expect(registry.putSnapshot({ code: room.code, characterId: 'c1', revision: 3, snapshot: { hp: 3 }, fromClientId: 'p1' }).stored).toBe(false);
+    const state = registry.getState(room.code);
+    expect(state.snapshots).toHaveLength(1);
+    expect(state.snapshots[0].revision).toBe(5);
+  });
+
+  it('снапшот в несуществующую комнату — ROOM_NOT_FOUND', () => {
+    const registry = makeRegistry();
+    expect(registry.putSnapshot({ code: 'GM-XXXXXX', characterId: 'c1', revision: 1, snapshot: {} }).error)
+      .toBe(ERROR_CODE.ROOM_NOT_FOUND);
+  });
+
+  it('пустая комната живёт до TTL, потом забирается sweeperом', () => {
+    let clock = 1_000_000;
+    const registry = makeRegistry({ now: () => clock });
+    const { room } = registry.createRoom({ clientId: 'gm' });
+    registry.joinRoom({ code: room.code, clientId: 'p1' });
+    registry.leaveRoom({ code: room.code, clientId: 'p1' });
+    clock += LIMITS.EMPTY_ROOM_TTL_MS - 1;
+    expect(registry.sweep()).toEqual([]);
+    clock += 2;
+    expect(registry.sweep()).toEqual([room.code]);
+    expect(registry.getRoom(room.code)).toBeNull();
+  });
+});
diff --git a/__tests__/room/room-server.integration.test.js b/__tests__/room/room-server.integration.test.js
new file mode 100644
index 0000000..30d5f43
--- /dev/null
+++ b/__tests__/room/room-server.integration.test.js
@@ -0,0 +1,165 @@
+// Интеграция комнатного сервера по сети (gm-rooms, этап 0–2): поднимаем
+// http+ws на случайном порту, ходим двумя ws-клиентами: create → join →
+// presence → publish-релей → отключение. Критерий этапа 0: два клиента
+// видят друг друга.
+
+import { describe, expect, it } from 'vitest';
+import WebSocket from 'ws';
+import { createRoomServer } from '../../server/roomServer.js';
+import { MESSAGE, PROTOCOL_VERSION } from '../../server/protocol.js';
+import { toCanonicalRoomCode } from '../../server/roomCode.js';
+
+let requestCounter = 0;
+const makeClient = (port, clientId) => {
+  const ws = new WebSocket(`ws://127.0.0.1:${port}/ws`);
+  const inbox = [];
+  const waiters = [];
+  const push = (msg) => {
+    for (let i = waiters.length - 1; i >= 0; i -= 1) {
+      if (waiters[i].predicate(msg)) {
+        waiters[i].resolve(msg);
+        waiters.splice(i, 1);
+        return;
+      }
+    }
+    inbox.push(msg);
+  };
+  ws.on('message', (raw) => push(JSON.parse(raw.toString())));
+  const opened = new Promise((resolve) => ws.once('open', resolve));
+  return {
+    clientId,
+    async send(type, payload = {}, roomCode = null) {
+      await opened;
+      requestCounter += 1;
+      const requestId = `t-${requestCounter}`;
+      ws.send(JSON.stringify({
+        v: PROTOCOL_VERSION, type, roomCode, clientId, ts: Date.now(), payload: { ...payload, requestId },
+      }));
+      return requestId;
+    },
+    sendRaw(type, payload = {}, roomCode = null) {
+      return opened.then(() => ws.send(JSON.stringify({
+        v: PROTOCOL_VERSION, type, roomCode, clientId, ts: Date.now(), payload,
+      })));
+    },
+    waitFor(predicate, timeoutMs = 3000) {
+      const buffered = inbox.findIndex(predicate);
+      if (buffered >= 0) return Promise.resolve(inbox.splice(buffered, 1)[0]);
+      return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => reject(new Error('waitFor: таймаут')), timeoutMs);
+        waiters.push({ predicate, resolve: (msg) => { clearTimeout(timer); resolve(msg); } });
+      });
+    },
+    close: () => ws.close(),
+  };
+};
+
+const withServer = async (fn) => {
+  const app = createRoomServer({ port: 0, host: '127.0.0.1', distDir: '/nonexistent-dist' });
+  const address = await app.start();
+  try {
+    await fn(address.port);
+  } finally {
+    await app.close();
+  }
+};
+
+describe('roomServer: create/join/presence', () => {
+  it('два клиента видят друг друга (критерий этапа 0)', async () => {
+    await withServer(async (port) => {
+      const gm = makeClient(port, 'gm-1');
+      const player = makeClient(port, 'player-1');
+
+      const createReq = await gm.send(MESSAGE.ROOM_CREATE, { name: 'Стол' });
+      const created = await gm.waitFor((m) => m.type === MESSAGE.ROOM_CREATED && m.payload.requestId === createReq);
+      expect(created.payload.code).toMatch(/^GM-[A-Z2-9]{6}$/);
+      expect(created.payload.ownerToken).toHaveLength(32);
+      expect(toCanonicalRoomCode(created.payload.code)).toBe(created.payload.code);
+
+      const joinReq = await player.send(MESSAGE.ROOM_JOIN, { code: created.payload.code, name: 'Иван' });
+      const state = await player.waitFor((m) => m.type === MESSAGE.ROOM_STATE && m.payload.requestId === joinReq);
+      expect(state.payload.members).toEqual([{ clientId: 'player-1', name: 'Иван', role: 'player' }]);
+
+      // Мастер входит как gm и видит игрока в списке.
+      await gm.send(MESSAGE.ROOM_JOIN, { code: created.payload.code, name: 'GM', role: 'gm' });
+      const gmState = await gm.waitFor((m) => m.type === MESSAGE.ROOM_STATE);
+      expect(gmState.payload.members.map((m) => m.name).sort()).toEqual(['GM', 'Иван']);
+
+      gm.close();
+      player.close();
+    });
+  });
+
+  it('presence: уход одного видят остальные', async () => {
+    await withServer(async (port) => {
+      const gm = makeClient(port, 'gm-1');
+      const player = makeClient(port, 'player-1');
+      const joinReq = await gm.send(MESSAGE.ROOM_CREATE, { name: 'Стол' });
+      const created = await gm.waitFor((m) => m.payload.requestId === joinReq);
+      await gm.send(MESSAGE.ROOM_JOIN, { code: created.payload.code, name: 'GM', role: 'gm' });
+      await gm.waitFor((m) => m.type === MESSAGE.ROOM_STATE);
+      await player.send(MESSAGE.ROOM_JOIN, { code: created.payload.code, name: 'Иван' });
+      await player.waitFor((m) => m.type === MESSAGE.ROOM_STATE);
+      // Игрок обновляет список у мастера (broadcast на вход), затем на выход.
+      await gm.waitFor((m) => m.type === MESSAGE.ROOM_MEMBER && m.payload.members.some((x) => x.name === 'Иван'));
+      await player.send(MESSAGE.ROOM_LEAVE, {}, created.payload.code);
+      const afterLeave = await gm.waitFor((m) => m.type === MESSAGE.ROOM_MEMBER && !m.payload.members.some((x) => x.name === 'Иван'));
+      expect(afterLeave.payload.members.some((x) => x.name === 'GM')).toBe(true);
+      gm.close();
+      player.close();
+    });
+  });
+
+  it('char.publish релеится остальным, отправителю — нет; в state позднему входящему едет снапшот', async () => {
+    await withServer(async (port) => {
+      const gm = makeClient(port, 'gm-1');
+      const player = makeClient(port, 'player-1');
+      const createReq = await gm.send(MESSAGE.ROOM_CREATE, { name: 'Стол' });
+      const created = await gm.waitFor((m) => m.payload.requestId === createReq);
+      await player.send(MESSAGE.ROOM_JOIN, { code: created.payload.code, name: 'Иван' });
+      await player.waitFor((m) => m.type === MESSAGE.ROOM_STATE);
+
+      // Мастер ещё не вошёл, но игрок публикует — сервер запоминает снапшот.
+      await player.sendRaw(MESSAGE.CHAR_PUBLISH, { characterId: 'char-1', revision: 1, snapshot: { name: 'Иван' } }, created.payload.code);
+      await gm.send(MESSAGE.ROOM_JOIN, { code: created.payload.code, name: 'GM', role: 'gm' });
+      const gmState = await gm.waitFor((m) => m.type === MESSAGE.ROOM_STATE);
+      expect(gmState.payload.snapshots).toHaveLength(1);
+      expect(gmState.payload.snapshots[0]).toMatchObject({ characterId: 'char-1', revision: 1 });
+
+      // Живая публикация долетает до другого члена.
+      const liveExpectation = gm.waitFor((m) => m.type === MESSAGE.CHAR_PUBLISH && m.payload.characterId === 'char-1');
+      await player.sendRaw(MESSAGE.CHAR_PUBLISH, { characterId: 'char-1', revision: 2, snapshot: { name: 'Иван-2' } }, created.payload.code);
+      const live = await liveExpectation;
+      expect(live.payload.fromName).toBe('Иван');
+      gm.close();
+      player.close();
+    });
+  });
+
+  it('ошибки: комната не найдена, чужая директива, неизвестный тип', async () => {
+    await withServer(async (port) => {
+      const gm = makeClient(port, 'gm-1');
+      const player = makeClient(port, 'player-1');
+
+      const missReq = await player.send(MESSAGE.ROOM_JOIN, { code: 'GM-AAAAAA', name: 'Иван' });
+      const miss = await player.waitFor((m) => m.type === MESSAGE.ERROR && m.payload.requestId === missReq);
+      expect(miss.payload.code).toBe('ROOM_NOT_FOUND');
+
+      const createReq = await gm.send(MESSAGE.ROOM_CREATE, { name: 'Стол' });
+      const created = await gm.waitFor((m) => m.payload.requestId === createReq);
