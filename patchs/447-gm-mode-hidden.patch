@@ -0,0 +1,48 @@
+'use strict';
+
+// server/protocol.js
+// Константы протокола комнат мастера (план: docs/architecture/gm-rooms-plan.md).
+// Клиентское зеркало — src/room/roomProtocol.ts; согласованность наборов
+// проверяет __tests__/room/protocol-mirror.test.js. Меняя константу здесь —
+// меняй зеркало и бампай PROTOCOL_VERSION при несовместимости.
+
+const PROTOCOL_VERSION = 1;
+
+const MESSAGE = Object.freeze({
+  ROOM_CREATE: 'room.create',
+  ROOM_CREATED: 'room.created',
+  ROOM_JOIN: 'room.join',
+  ROOM_STATE: 'room.state',
+  ROOM_LEAVE: 'room.leave',
+  // Полный список членов комнаты (рассылается на join/leave — presence).
+  ROOM_MEMBER: 'room.member',
+  PRESENCE_PING: 'presence.ping',
+  PRESENCE_PONG: 'presence.pong',
+  CHAR_PUBLISH: 'char.publish',
+  CHAR_FOCUS: 'char.focus',
+  GM_DIRECTIVE: 'gm.directive',
+  ERROR: 'error',
+});
+
+const ERROR_CODE = Object.freeze({
+  ROOM_NOT_FOUND: 'ROOM_NOT_FOUND',
+  ROOM_FULL: 'ROOM_FULL',
+  ROOM_QUOTA_EXCEEDED: 'ROOM_QUOTA_EXCEEDED',
+  ROOM_CODE_TAKEN: 'ROOM_CODE_TAKEN',
+  RATE_LIMITED: 'RATE_LIMITED',
+  NOT_ROOM_OWNER: 'NOT_ROOM_OWNER',
+  BAD_MESSAGE: 'BAD_MESSAGE',
+  UNKNOWN_TYPE: 'UNKNOWN_TYPE',
+});
+
+const LIMITS = Object.freeze({
+  CODE_LENGTH: 6,
+  MAX_ROOMS_PER_OWNER: 20,
+  MAX_MEMBERS_PER_ROOM: 12,
+  MAX_ROOMS_PER_IP_PER_DAY: 200,
+  MAX_JOINS_PER_IP_PER_MINUTE: 30,
+  MAX_MESSAGE_BYTES: 2 * 1024 * 1024,
+  EMPTY_ROOM_TTL_MS: 24 * 60 * 60 * 1000,
+});
+
+module.exports = { PROTOCOL_VERSION, MESSAGE, ERROR_CODE, LIMITS };
diff --git a/server/roomCode.js b/server/roomCode.js
new file mode 100644
index 0000000..0f4bd25
--- /dev/null
+++ b/server/roomCode.js
@@ -0,0 +1,72 @@
+'use strict';
+
+// server/roomCode.js
+// Адрес комнаты: «PP-XXXXXX» (пример GM-7Q3K9M). Код генерирует ТОЛЬКО
+// сервер — уникальность конструктивная (§3.2 плана gm-rooms). Клиентское
+// зеркало правил разбора/отображения — src/room/roomCode.ts; согласованность
+// проверяет __tests__/room/room-code.test.js.
+
+const crypto = require('node:crypto');
+const { LIMITS } = require('./protocol');
+
+// Алфавит без неоднозначных символов (нет 0/O, 1/I/L):
+// 23 буквы + 8 цифр = 31 символ; 6 знаков ≈ 887 млн комбинаций.
+const CODE_ALPHABET = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
+const DEFAULT_PREFIX = 'GM';
+
+// rng(maxExclusive) -> int [0, maxExclusive) — инъецируемо для тестов
+// (проверка перегенерации при коллизии); по умолчанию крипто.
+const defaultRandomInt = (maxExclusive) => crypto.randomInt(maxExclusive);
+
+const generateRoomCode = (length = LIMITS.CODE_LENGTH, rng = defaultRandomInt) => {
+  let code = '';
+  for (let i = 0; i < length; i += 1) code += CODE_ALPHABET[rng(CODE_ALPHABET.length)];
+  return code;
+};
+
+// Префикс — косметика (§3.2): чистится до 2–3 латинских букв, иначе GM.
+const sanitizePrefix = (raw) => {
+  const cleaned = String(raw || '').toUpperCase().replace(/[^A-Z]/g, '').slice(0, 3);
+  return cleaned.length >= 2 ? cleaned : DEFAULT_PREFIX;
+};
+
+/**
+ * Разбор адреса, введённого пользователем: верхний регистр, срез всего,
+ * кроме букв/цифр, последние codeLength символов — код, перед ними
+ * префикс 2–3 буквы. Возвращает { prefix, code } | null.
+ * Пользовательский ввод O/I/L/0/1 не восстанавливаем: в настоящих кодах
+ * их нет, такой ввод считается ошибкой (null).
+ */
+const parseRoomAddress = (input, codeLength = LIMITS.CODE_LENGTH) => {
+  const cleaned = String(input || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
+  if (cleaned.length !== codeLength + 2 && cleaned.length !== codeLength + 3) return null;
+  const prefix = cleaned.slice(0, cleaned.length - codeLength);
+  const code = cleaned.slice(cleaned.length - codeLength);
+  if (!/^[A-Z]{2,3}$/.test(prefix)) return null;
+  if (![...code].every((char) => CODE_ALPHABET.includes(char))) return null;
+  return { prefix, code };
+};
+
+/** Канонический машинный вид: 'GM-7Q3K9M' (то, что ходит по сети и лежит в БД). */
+const toCanonicalRoomCode = (input) => {
+  const parsed = parseRoomAddress(input);
+  return parsed ? `${parsed.prefix}-${parsed.code}` : null;
+};
+
+/** Экранный вид группами по 3: 'GM-7Q3-K9M'. Принимает канон или сырой ввод. */
+const formatRoomCodeForDisplay = (input) => {
+  const parsed = parseRoomAddress(input);
+  if (!parsed) return String(input || '');
+  const grouped = parsed.code.replace(/(.{3})(?=.)/g, '$1-');
+  return `${parsed.prefix}-${grouped}`;
+};
+
+module.exports = {
+  CODE_ALPHABET,
+  DEFAULT_PREFIX,
+  generateRoomCode,
+  sanitizePrefix,
+  parseRoomAddress,
+  toCanonicalRoomCode,
+  formatRoomCodeForDisplay,
+};
diff --git a/server/roomRegistry.js b/server/roomRegistry.js
new file mode 100644
index 0000000..c137161
--- /dev/null
+++ b/server/roomRegistry.js
@@ -0,0 +1,183 @@
+'use strict';
+
+// server/roomRegistry.js
+// Реестр комнат мастера: чистая память + правила, БЕЗ сети (сеть —
+// roomServer.js). Хранит членов комнаты, последние снапшоты персонажей,
+// квоты и TTL. Членская запись несёт непрозрачный `ws` (кладёт сетевой
+// слой, реестр его никогда не трогает) — так тесты подставляют заглушки.
+
+const crypto = require('node:crypto');
+const { ERROR_CODE, LIMITS } = require('./protocol');
+const { generateRoomCode, sanitizePrefix } = require('./roomCode');
+
+const newOwnerToken = () => crypto.randomBytes(16).toString('hex');
+
+/**
+ * @param {{ now?: () => number, rng?: (max: number) => number, limits?: object }} deps
+ * now/rng — точки подмены для тестов (TTL, коллизии кодов).
+ */
+const createRoomRegistry = ({ now = () => Date.now(), rng = undefined, limits = LIMITS } = {}) => {
+  const rooms = new Map(); // code -> room
+  const ipRoomLog = new Map(); // ip -> [ts] (создания комнат за сутки)
+  const ipJoinLog = new Map(); // ip -> [ts] (входы за минуту)
+  const lastRng = rng; // jest/vitest подмена
+
+  const touchRateLog = (log, key, windowMs, max) => {
+    const cutoff = now() - windowMs;
+    const list = (log.get(key) || []).filter((ts) => ts > cutoff);
+    if (list.length >= max) return false;
+    list.push(now());
+    log.set(key, list);
+    return true;
+  };
+
+  const buildRoom = ({ code, ownerClientId, ownerToken, name }) => ({
+    code,
+    name: String(name || '').trim() || code,
+    ownerClientId: ownerClientId || null,
+    ownerToken,
+    members: new Map(), // clientId -> { clientId, name, role, ws }
+    lastSnapshots: new Map(), // characterId -> { characterId, revision, snapshot, fromClientId, fromName, updatedAt }
+    createdAt: now(),
+    emptySince: null,
+  });
+
+  const roomSnapshot = (room) => ({
+    code: room.code,
+    name: room.name,
+    members: [...room.members.values()].map((member) => ({
+      clientId: member.clientId, name: member.name, role: member.role,
+    })),
+    snapshots: [...room.lastSnapshots.values()].map((entry) => ({
+      characterId: entry.characterId,
+      revision: entry.revision,
+      snapshot: entry.snapshot,
+      fromClientId: entry.fromClientId,
+      fromName: entry.fromName,
+    })),
+  });
+
+  const countOwnedRooms = (ownerClientId) => (
+    [...rooms.values()].filter((room) => room.ownerClientId === ownerClientId).length
+  );
+
+  const generateFreeCode = (prefixRaw) => {
+    for (let attempt = 0; attempt < 50; attempt += 1) {
+      const prefix = sanitizePrefix(prefixRaw);
+      const candidate = `${prefix}-${generateRoomCode(limits.CODE_LENGTH, lastRng)}`;
+      if (!rooms.has(candidate)) return candidate;
+    }
+    return null;
+  };
+
+  /**
+   * Создать комнату. requestedCode + ownerToken — восстановление комнаты
+   * мастера (перезапуск сервера / переезд): код занят чужой комнатой без
+   * совпадения токена → ROOM_CODE_TAKEN.
+   */
+  const createRoom = ({ clientId, ip = 'unknown', prefix, requestedCode = null, ownerToken = null, name = '' }) => {
+    if (requestedCode) {
+      const existing = rooms.get(requestedCode);
+      if (existing) {
+        if (!ownerToken || existing.ownerToken !== ownerToken) {
+          return { error: ERROR_CODE.ROOM_CODE_TAKEN };
+        }
+        existing.ownerClientId = clientId;
+        if (name) existing.name = String(name).trim() || existing.name;
+        existing.emptySince = null;
+        return { room: existing, rebound: true };
+      }
+      const room = buildRoom({
+        code: requestedCode,
+        ownerClientId: clientId,
+        ownerToken: ownerToken || newOwnerToken(),
+        name,
+      });
+      rooms.set(room.code, room);
+      return { room, rebound: false };
+    }
+
+    if (!touchRateLog(ipRoomLog, ip || 'unknown', 24 * 60 * 60 * 1000, limits.MAX_ROOMS_PER_IP_PER_DAY)) {
+      return { error: ERROR_CODE.ROOM_QUOTA_EXCEEDED };
+    }
+    if (countOwnedRooms(clientId) >= limits.MAX_ROOMS_PER_OWNER) {
+      return { error: ERROR_CODE.ROOM_QUOTA_EXCEEDED };
+    }
+    const code = generateFreeCode(prefix);
+    if (!code) return { error: ERROR_CODE.ROOM_QUOTA_EXCEEDED };
+    const room = buildRoom({ code, ownerClientId: clientId, ownerToken: newOwnerToken(), name });
+    rooms.set(code, room);
+    return { room, rebound: false };
+  };
+
+  const joinRoom = ({ code, clientId, ip = 'unknown', name = '', role = 'player', ws = null }) => {
+    if (!touchRateLog(ipJoinLog, ip || 'unknown', 60 * 1000, limits.MAX_JOINS_PER_IP_PER_MINUTE)) {
+      return { error: ERROR_CODE.RATE_LIMITED };
+    }
+    const room = rooms.get(code);
+    if (!room) return { error: ERROR_CODE.ROOM_NOT_FOUND };
+    if (!room.members.has(clientId) && room.members.size >= limits.MAX_MEMBERS_PER_ROOM) {
+      return { error: ERROR_CODE.ROOM_FULL };
+    }
+    // Повторный вход того же clientId — переподключение: запись заменяется.
+    room.members.set(clientId, {
+      clientId,
+      name: String(name || '').trim() || '—',
+      role: role === 'gm' ? 'gm' : 'player',
+      ws,
+    });
+    room.emptySince = null;
+    return { room, state: roomSnapshot(room) };
+  };
+
+  const leaveRoom = ({ code, clientId }) => {
+    const room = rooms.get(code);
+    if (!room) return { room: null, left: false };
+    const left = room.members.delete(clientId);
+    if (room.members.size === 0) room.emptySince = now();
+    return { room, left };
+  };
+
+  /** Последний снапшот персонажа в комнате (LWW по revision). */
+  const putSnapshot = ({ code, characterId, revision, snapshot, fromClientId, fromName }) => {
+    const room = rooms.get(code);
+    if (!room) return { error: ERROR_CODE.ROOM_NOT_FOUND };
+    const previous = room.lastSnapshots.get(characterId);
+    if (previous && Number(revision) < Number(previous.revision)) {
+      return { room, stored: false, currentRevision: previous.revision };
+    }
+    room.lastSnapshots.set(characterId, {
+      characterId, revision: Number(revision) || 0, snapshot, fromClientId, fromName, updatedAt: now(),
+    });
+    return { room, stored: true, currentRevision: Number(revision) || 0 };
+  };
+
+  const isOwner = (code, clientId) => rooms.get(code)?.ownerClientId === clientId;
+  const getRoom = (code) => rooms.get(code) || null;
+  const getState = (code) => {
+    const room = rooms.get(code);
+    return room ? roomSnapshot(room) : null;
+  };
+
+  /** Чистка комнат, опустевших дольше TTL (пустые = 0 подключённых членов). */
+  const sweep = () => {
+    const removed = [];
+    for (const room of rooms.values()) {
+      if (room.members.size === 0) {
+        if (!room.emptySince) room.emptySince = now();
+        if (now() - room.emptySince >= limits.EMPTY_ROOM_TTL_MS) {
+          rooms.delete(room.code);
+          removed.push(room.code);
+        }
+      }
+    }
+    return removed;
+  };
+
+  return {
+    createRoom, joinRoom, leaveRoom, putSnapshot, isOwner, getRoom, getState, sweep,
+    _rooms: rooms, // диагностика/тесты
+  };
+};
+
+module.exports = { createRoomRegistry };
diff --git a/server/roomServer.js b/server/roomServer.js
new file mode 100644
index 0000000..37073f9
--- /dev/null
+++ b/server/roomServer.js
@@ -0,0 +1,286 @@
+'use strict';
+
+// server/roomServer.js
+// Комнатный сервер Positronium: раздаёт статику dist/ и принимает WebSocket
+// на /ws — релей комнат мастера поверх реестра roomRegistry. Протокол —
+// server/protocol.js (конверт { v, type, roomCode, clientId, ts, payload },
+// requestId в payload эхом возвращается в ответах create/join/error).
+
+const http = require('node:http');
+const fs = require('node:fs');
+const path = require('node:path');
+const { WebSocketServer } = require('ws');
+const { PROTOCOL_VERSION, MESSAGE, ERROR_CODE, LIMITS } = require('./protocol');
+const { createRoomRegistry } = require('./roomRegistry');
+const { toCanonicalRoomCode } = require('./roomCode');
+
+const MIME = {
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.gif': 'image/gif',
+  '.webp': 'image/webp',
+  '.ico': 'image/x-icon',
+  '.svg': 'image/svg+xml',
+  '.webmanifest': 'application/manifest+json',
+  '.woff': 'font/woff',
+  '.woff2': 'font/woff2',
+  '.ttf': 'font/ttf',
+  '.txt': 'text/plain; charset=utf-8',
+};
+
+const serveStatic = (distDir) => (req, res) => {
+  let urlPath;
+  try {
+    urlPath = decodeURIComponent((req.url || '/').split('?')[0]);
+  } catch {
+    res.writeHead(400); res.end('Bad request'); return;
+  }
+  if (urlPath === '/') urlPath = '/index.html';
+  const normalized = path.normalize(urlPath).replace(/^([/\\])+/, '');
+  const filePath = path.join(distDir, normalized);
+  if (!filePath.startsWith(distDir)) { res.writeHead(403); res.end('Forbidden'); return; }
+  fs.readFile(filePath, (err, data) => {
+    if (!err) {
+      res.writeHead(200, { 'Content-Type': MIME[path.extname(filePath).toLowerCase()] || 'application/octet-stream' });
+      res.end(data);
+      return;
+    }
+    // SPA-фолбэк: «навигационные» пути без расширения ведут на index.html.
+    if (!path.extname(urlPath)) {
+      fs.readFile(path.join(distDir, 'index.html'), (fallbackErr, html) => {
+        if (fallbackErr) { res.writeHead(404); res.end('Not found'); return; }
+        res.writeHead(200, { 'Content-Type': MIME['.html'] });
+        res.end(html);
+      });
+      return;
+    }
+    res.writeHead(404); res.end('Not found');
+  });
+};
+
+const createRoomServer = ({
+  port = 5000,
+  host = '0.0.0.0',
+  distDir = path.join(__dirname, '..', 'dist'),
+  registry = createRoomRegistry(),
+} = {}) => {
+  const server = http.createServer(serveStatic(distDir));
+  const wss = new WebSocketServer({ noServer: true, maxPayload: LIMITS.MAX_MESSAGE_BYTES });
+
+  const sendEnvelope = (ws, type, payload = {}, roomCode = null, clientId = null) => {
+    if (ws.readyState !== ws.OPEN && ws.readyState !== 1) return;
+    const envelope = {
+      v: PROTOCOL_VERSION, type, roomCode, clientId, ts: Date.now(), payload,
+    };
+    try { ws.send(JSON.stringify(envelope)); } catch { /* сокол умер на записи — close доберёт */ }
+  };
+
+  const sendError = (ws, clientId, code, requestId = null, roomCode = null) => {
+    sendEnvelope(ws, MESSAGE.ERROR, { code, requestId }, roomCode, clientId);
+  };
+
+  const broadcastMembers = (room, exceptClientId = null) => {
+    const members = [...room.members.values()].map((member) => ({
+      clientId: member.clientId, name: member.name, role: member.role,
+    }));
+    for (const member of room.members.values()) {
+      if (member.clientId === exceptClientId || !member.ws) continue;
+      sendEnvelope(member.ws, MESSAGE.ROOM_MEMBER, { members }, room.code, member.clientId);
+    }
+  };
+
+  const broadcastToRoom = (room, exceptClientId, type, payload) => {
+    for (const member of room.members.values()) {
+      if (member.clientId === exceptClientId || !member.ws) continue;
+      sendEnvelope(member.ws, type, payload, room.code, member.clientId);
+    }
+  };
+
+  server.on('upgrade', (req, socket, head) => {
+    if (!req.url.startsWith('/ws')) { socket.destroy(); return; }
+    wss.handleUpgrade(req, socket, head, (ws) => {
+      ws.clientIp = req.headers['x-forwarded-for']?.split(',')[0]?.trim() || req.socket.remoteAddress || 'unknown';
+      wss.emit('connection', ws, req);
+    });
+  });
+
+  wss.on('connection', (ws) => {
+    // ws.meta = { clientId, rooms: Set<string> } — заполняется по мере join/create.
+    ws.meta = { clientId: null, rooms: new Set() };
+
+    ws.on('message', (raw) => {
+      let msg;
+      try { msg = JSON.parse(raw.toString()); } catch {
+        sendError(ws, ws.meta.clientId, ERROR_CODE.BAD_MESSAGE);
+        return;
+      }
+      const { type, roomCode, clientId, payload = {} } = msg || {};
+      if (!clientId || typeof type !== 'string') {
+        sendError(ws, clientId || null, ERROR_CODE.BAD_MESSAGE, payload?.requestId || null);
+        return;
+      }
+      ws.meta.clientId = clientId;
+
+      switch (type) {
+        case MESSAGE.PRESENCE_PING: {
+          sendEnvelope(ws, MESSAGE.PRESENCE_PONG, {}, null, clientId);
+          break;
+        }
+
+        case MESSAGE.ROOM_CREATE: {
+          const requestedCode = payload.requestedCode ? toCanonicalRoomCode(payload.requestedCode) : null;
+          if (payload.requestedCode && !requestedCode) {
+            sendError(ws, clientId, ERROR_CODE.ROOM_CODE_TAKEN, payload.requestId);
+            break;
+          }
+          const result = registry.createRoom({
+            clientId,
+            ip: ws.clientIp,
+            prefix: payload.prefix,
+            requestedCode,
+            ownerToken: payload.ownerToken || null,
+            name: payload.name,
+          });
+          if (result.error) {
+            sendError(ws, clientId, result.error, payload.requestId);
+            break;
+          }
+          ws.meta.rooms.add(result.room.code);
+          sendEnvelope(ws, MESSAGE.ROOM_CREATED, {
+            code: result.room.code,
+            name: result.room.name,
+            ownerToken: result.room.ownerToken,
+            rebound: result.rebound,
+            requestId: payload.requestId || null,
+          }, result.room.code, clientId);
+          break;
+        }
+
+        case MESSAGE.ROOM_JOIN: {
+          const canonical = toCanonicalRoomCode(payload.code || roomCode || '');
+          if (!canonical) {
+            sendError(ws, clientId, ERROR_CODE.ROOM_NOT_FOUND, payload.requestId);
+            break;
+          }
+          const result = registry.joinRoom({
+            code: canonical,
+            clientId,
+            ip: ws.clientIp,
+            name: payload.name,
+            role: payload.role,
+            ws,
+          });
+          if (result.error) {
+            sendError(ws, clientId, result.error, payload.requestId, canonical);
+            break;
+          }
+          ws.meta.rooms.add(canonical);
+          sendEnvelope(ws, MESSAGE.ROOM_STATE, { ...result.state, requestId: payload.requestId || null }, canonical, clientId);
+          broadcastMembers(result.room, clientId);
+          break;
+        }
+
+        case MESSAGE.ROOM_LEAVE: {
+          const canonical = toCanonicalRoomCode(roomCode || payload.code || '');
+          if (!canonical) break;
+          const { room, left } = registry.leaveRoom({ code: canonical, clientId });
+          ws.meta.rooms.delete(canonical);
+          if (left && room) broadcastMembers(room, clientId);
+          break;
+        }
+
+        case MESSAGE.CHAR_PUBLISH: {
+          const canonical = toCanonicalRoomCode(roomCode || payload.code || '');
+          const room = canonical && registry.getRoom(canonical);
+          if (!room || !room.members.has(clientId)) {
+            sendError(ws, clientId, ERROR_CODE.ROOM_NOT_FOUND, payload.requestId, canonical);
+            break;
+          }
+          const member = room.members.get(clientId);
+          registry.putSnapshot({
+            code: canonical,
+            characterId: payload.characterId,
+            revision: payload.revision,
+            snapshot: payload.snapshot,
+            fromClientId: clientId,
+            fromName: member?.name,
+          });
+          broadcastToRoom(room, clientId, MESSAGE.CHAR_PUBLISH, {
+            characterId: payload.characterId,
+            revision: payload.revision,
+            snapshot: payload.snapshot,
+            fromClientId: clientId,
+            fromName: member?.name,
+            fromRole: member?.role,
+          });
+          break;
+        }
+
+        case MESSAGE.CHAR_FOCUS: {
+          const canonical = toCanonicalRoomCode(roomCode || payload.code || '');
+          const room = canonical && registry.getRoom(canonical);
+          if (!room || !room.members.has(clientId)) break;
+          broadcastToRoom(room, clientId, MESSAGE.CHAR_FOCUS, {
+            characterId: payload.characterId,
+            editing: Boolean(payload.editing),
+            fromClientId: clientId,
+            fromName: room.members.get(clientId)?.name,
+          });
+          break;
+        }
+
+        case MESSAGE.GM_DIRECTIVE: {
+          const canonical = toCanonicalRoomCode(roomCode || payload.code || '');
+          const room = canonical && registry.getRoom(canonical);
+          if (!room) { sendError(ws, clientId, ERROR_CODE.ROOM_NOT_FOUND, payload.requestId, canonical); break; }
+          if (!registry.isOwner(canonical, clientId)) {
+            sendError(ws, clientId, ERROR_CODE.NOT_ROOM_OWNER, payload.requestId, canonical);
+            break;
+          }
+          broadcastToRoom(room, clientId, MESSAGE.GM_DIRECTIVE, {
+            ...payload,
+            fromClientId: clientId,
+            fromName: room.members.get(clientId)?.name,
+          });
+          break;
+        }
+
+        default:
+          sendError(ws, clientId, ERROR_CODE.UNKNOWN_TYPE, payload.requestId || null, roomCode || null);
+      }
+    });
+
+    ws.on('close', () => {
+      if (!ws.meta.clientId) return;
+      for (const code of ws.meta.rooms) {
+        const { room, left } = registry.leaveRoom({ code, clientId: ws.meta.clientId });
+        if (left && room) broadcastMembers(room, ws.meta.clientId);
+      }
+      ws.meta.rooms.clear();
+    });
+  });
+
+  const sweepTimer = setInterval(() => registry.sweep(), 5 * 60 * 1000);
+  if (sweepTimer.unref) sweepTimer.unref();
+
+  const start = () => new Promise((resolve, reject) => {
+    server.once('error', reject);
+    server.listen(port, host, () => resolve(server.address()));
+  });
+
+  const close = () => new Promise((resolve) => {
+    clearInterval(sweepTimer);
+    for (const client of wss.clients) { try { client.terminate(); } catch { /* уже мёртв */ } }
+    wss.close(() => server.close(() => resolve()));
+    // server.close ждёт висящие keep-alive сокеты — у нас их нет (ws terminate).
+  });
+
+  return { server, wss, registry, start, close };
+};
+
+module.exports = { createRoomServer };
