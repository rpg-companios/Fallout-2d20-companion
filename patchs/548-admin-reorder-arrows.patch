+++ b/__tests__/lootTrade/lock-label-writeback-548.test.js
@@ -0,0 +1,207 @@
+// ПРИЁМОЧНЫЙ (патч 548): удалить при конверсии/приживании.
+// Патч 548, вторая половина: обратная запись живой сессии не должна затирать
+// человеческую подпись замка техническим маркером. До фикса выдача локации
+// превращала «Ржавая дверь» в `F2D20-LOC:{"v":1,...}` и портила карточку Мастера
+// навсегда. Маркер прячет исходный текст в поле `l` — его и возвращаем.
+import { describe, expect, it, beforeEach, vi } from 'vitest';
+
+const h = vi.hoisted(() => ({
+  cards: {},
+  listeners: new Set(),
+  state: { rooms: {} },
+}));
+
+vi.mock('react-native', () => ({
+  Platform: { OS: 'web' },
+  Alert: { alert: vi.fn() },
+}));
+
+vi.mock('../../db', () => ({
+  getGmContainerById: vi.fn(async (id) => h.cards[id] || null),
+  getGmContainersList: vi.fn(async () => Object.values(h.cards)),
+  saveGmContainer: vi.fn(async (card) => { h.cards[card.id] = card; return card; }),
+  deleteGmContainer: vi.fn(async (id) => { delete h.cards[id]; }),
+  getFolderRooms: vi.fn(async () => []),
+}));
+
+vi.mock('../../src/room/roomStore', () => ({
+  default: { getState: () => h.state },
+  onRoomSessionState: (fn) => { h.listeners.add(fn); return () => h.listeners.delete(fn); },
+}));
+
+vi.mock('../../components/cloudSync/googleDriveSync', () => ({
+  syncGmContainerToCloudIfEnabled: vi.fn(async () => {}),
+  deleteGmContainerFromCloudIfEnabled: vi.fn(async () => {}),
+}));
+vi.mock('../../components/alerts/alertService', () => ({ showRawAlert: vi.fn() }));
+vi.mock('../../components/screens/LootTradeScreen/logic/lootTradeI18n', () => ({
+  tLootTrade: (key) => key,
+  formatLootTrade: (key) => key,
+}));
+vi.mock('../../domain/premium', async (importOriginal) => ({
+  ...(await importOriginal()),
+  isGmLootTradeLicensed: () => true,
+}));
+
+import * as db from '../../db';
+import {
+  CONTAINER_KIND,
+  buildLocationSessionNodes,
+  encodeLockNodeMarker,
+  encodeTerminalNodeMarker,
+  normalizeContainerEntity,
+  normalizeHubLink,
+  readableSessionLockLabel,
+} from '../../domain/lootTrade.js';
+import { encodeLocationNodeMarker } from '../../domain/locationNodeMarker.js';
+import {
+  resetPromptedEmptySessionsForTests,
+  startGmSessionPersistence,
+} from '../../src/lootTrade/gmSessionPersistence.js';
+
+const cards = () => [
+  normalizeContainerEntity({
+    id: 'town', kind: CONTAINER_KIND.HUB, name: 'Город',
+    links: [
+      { containerId: 'cellar', locked: true, lockLabel: 'Ржавая дверь' },
+      { containerId: 'hatch', locked: false, lockLabel: '' },
+    ],
+  }),
+  normalizeContainerEntity({ id: 'cellar', kind: CONTAINER_KIND.LOOT, name: 'Подвал', items: [] }),
+  normalizeContainerEntity({ id: 'hatch', kind: CONTAINER_KIND.LOCK, name: 'Люк', difficulty: 2 }),
+];
+
+const seed = (all) => {
+  h.cards = {};
+  all.forEach((c) => { h.cards[c.id] = c; });
+};
+
+/** Прогоняет конверт сессии через настоящий слушатель и ждёт цепочку записи. */
+const emitSession = async (session) => {
+  const stop = startGmSessionPersistence();
+  try {
+    await Promise.all([...h.listeners].map((fn) => fn({ roomCode: 'ROOM1', payload: { session } })));
+  } finally {
+    stop();
+  }
+};
+
+beforeEach(() => {
+  h.listeners.clear();
+  h.state = { rooms: { ROOM1: { role: 'gm', joined: true, activeSession: null } } };
+  resetPromptedEmptySessionsForTests();
+  vi.clearAllMocks();
+});
+
+describe('548: разбор подписи замка', () => {
+  it('обычный текст возвращается без изменений', () => {
+    expect(readableSessionLockLabel('Ржавая дверь')).toBe('Ржавая дверь');
+    expect(readableSessionLockLabel('')).toBe('');
+    expect(readableSessionLockLabel(undefined)).toBe('');
+    expect(readableSessionLockLabel(null)).toBe('');
+  });
+
+  it('маркер локации, замка и терминала отдают исходный текст Мастера', () => {
+    expect(readableSessionLockLabel(encodeLocationNodeMarker({
+      kind: 'loot', parentIds: ['town'], lockLabel: 'Ржавая дверь',
+    }))).toBe('Ржавая дверь');
+    expect(readableSessionLockLabel(encodeLockNodeMarker({
+      difficulty: 3, label: 'Тугой замок',
+    }))).toBe('Тугой замок');
+    expect(readableSessionLockLabel(encodeTerminalNodeMarker({
+      difficulty: 2, label: 'Старый терминал',
+    }))).toBe('Старый терминал');
+  });
+
+  it('маркер без подписи даёт пустую строку, а не JSON', () => {
+    expect(readableSessionLockLabel(encodeLocationNodeMarker({ kind: 'lock', parentIds: ['town'] }))).toBe('');
+  });
+
+  it('битый маркер не роняет чтение и остаётся как есть', () => {
+    const broken = 'F2D20-LOC:{не json';
+    expect(readableSessionLockLabel(broken)).toBe(broken);
+  });
+
+  it('нормализация ссылки лечит маркер, уже осевший в БД', () => {
+    const polluted = encodeLocationNodeMarker({ kind: 'loot', parentIds: ['town'], lockLabel: 'Ржавая дверь' });
+    expect(normalizeHubLink({ containerId: 'cellar', locked: true, lockLabel: polluted }))
+      .toEqual({ containerId: 'cellar', locked: true, lockLabel: 'Ржавая дверь' });
+    // Карточка, сохранённая прошлой версией, читается уже с человеческой подписью.
+    const restored = normalizeContainerEntity({
+      id: 'town', kind: CONTAINER_KIND.HUB, name: 'Город',
+      links: [{ containerId: 'cellar', locked: true, lockLabel: polluted }],
+    });
+    expect(restored.links[0].lockLabel).toBe('Ржавая дверь');
+  });
+});
+
+describe('548: обратная запись сессии сохраняет подпись Мастера', () => {
+  it('выдача локации с маркером 544 не затирает подпись замка', async () => {
+    const all = cards();
+    seed(all);
+    const nodes = buildLocationSessionNodes(all[0], all);
+    // Живые узлы действительно несут маркер — это условие бага.
+    expect(String(nodes.find((n) => n.containerId === 'cellar').lockLabel)).toMatch(/^F2D20-/);
+
+    await emitSession({
+      sessionId: 's548', containerId: 'town', kind: 'hub', revision: 1, nodes,
+    });
+
+    const saved = h.cards.town;
+    expect(saved.links.find((l) => l.containerId === 'cellar').lockLabel).toBe('Ржавая дверь');
+    expect(saved.links.find((l) => l.containerId === 'hatch').lockLabel).toBe('');
+    // Флаг замка по-прежнему синхронизируется — поведение 546/547 не тронуто.
+    expect(saved.links.find((l) => l.containerId === 'cellar').locked).toBe(true);
+  });
+
+  it('взлом замка снимает флаг, но подпись остаётся человеческой', async () => {
+    const all = cards();
+    seed(all);
+    const nodes = buildLocationSessionNodes(all[0], all).map((n) => (
+      n.containerId === 'cellar' ? { ...n, locked: false } : n
+    ));
+    await emitSession({
+      sessionId: 's548b', containerId: 'town', kind: 'hub', revision: 1, nodes,
+    });
+    const link = h.cards.town.links.find((l) => l.containerId === 'cellar');
+    expect(link.locked).toBe(false);
+    expect(link.lockLabel).toBe('Ржавая дверь');
+  });
+
+  it('повторная выдача не накапливает маркеры (идемпотентность)', async () => {
+    const all = cards();
+    seed(all);
+    const nodes = buildLocationSessionNodes(all[0], all);
+    await emitSession({ sessionId: 's548c', containerId: 'town', kind: 'hub', revision: 1, nodes });
+    const afterFirst = h.cards.town.links.find((l) => l.containerId === 'cellar').lockLabel;
+    const again = buildLocationSessionNodes(normalizeContainerEntity(h.cards.town), Object.values(h.cards));
+    await emitSession({ sessionId: 's548d', containerId: 'town', kind: 'hub', revision: 1, nodes: again });
+    expect(h.cards.town.links.find((l) => l.containerId === 'cellar').lockLabel).toBe(afterFirst);
+    expect(afterFirst).toBe('Ржавая дверь');
+  });
+
+  it('узел без подписи в конверте не стирает сохранённую, а маркер в БД лечится', async () => {
+    const all = cards();
+    all[0] = normalizeContainerEntity({
+      ...all[0],
+      links: [
+        { containerId: 'cellar', locked: true, lockLabel: 'Ржавая дверь' },
+        {
+          containerId: 'hatch',
+          locked: false,
+          lockLabel: encodeLockNodeMarker({ difficulty: 2, label: 'Люк во двор' }),
+        },
+      ],
+    });
+    seed(all);
+    // Конверт несёт только один узел: вторая ссылка идёт мимо синхронизации.
+    await emitSession({
+      sessionId: 's548e', containerId: 'town', kind: 'hub', revision: 1,
+      nodes: [{ containerId: 'cellar', kind: 'loot', name: 'Подвал', locked: true, lockLabel: 'Ржавая дверь', items: [] }],
+    });
+    const links = h.cards.town.links;
+    expect(links.find((l) => l.containerId === 'cellar').lockLabel).toBe('Ржавая дверь');
+    expect(links.find((l) => l.containerId === 'hatch').lockLabel).toBe('Люк во двор');
+    expect(db.saveGmContainer).toHaveBeenCalled();
+  });
+});
diff --git a/__tests__/room/admin-reorder-arrows-548.test.js b/__tests__/room/admin-reorder-arrows-548.test.js
new file mode 100644
index 0000000..6767776
--- /dev/null
+++ b/__tests__/room/admin-reorder-arrows-548.test.js
@@ -0,0 +1,270 @@
+// ПРИЁМОЧНЫЙ (патч 548): удалить при конверсии/приживании.
+// Патч 548: «стрелки перемещения в админке не активны».
+//
+// Настоящая причина — порядок опроса ответственности в React Native.
+// `findWantsResponder` (react-native-web: modules/useResponderEvents/
+// ResponderSystem.js) идёт по CAPTURE-фазе сверху вниз и принимает решение
+// СРАЗУ, как только обработчик вернул true; bubble-фаза после этого не
+// опрашивается. Ручка дерева отдавала `onStartShouldSetPanResponderCapture:
+// () => true`, а контекст строки (`parentId`, `childId`, братья) писала только
+// в `onStartShouldSetPanResponder`. Поэтому `dragContextRef.current` оставался
+// null, `onPanResponderGrant` выходил по `if (!context) return`, и стрелка не
+// перетаскивалась никогда.
+//
+// Тест 545 этого не увидел: он звал bubble-обработчик руками, чего живой
+// браузер не делает. Здесь опрос идёт как в RN: сначала capture, и bubble
+// вызывается ТОЛЬКО если capture отказался.
+import { describe, expect, it, vi } from 'vitest';
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import React from 'react';
+import { create, act } from 'react-test-renderer';
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+
+const mockLayout = vi.hoisted(() => ({ bounds: {} }));
+
+vi.mock('react-native', () => {
+  const React = require('react');
+  const host = (name) => ({ children, ...props }) => React.createElement(name, props, children);
+  const View = React.forwardRef(({ children, ...props }, ref) => {
+    React.useImperativeHandle(ref, () => ({
+      measureInWindow: (cb) => {
+        const b = mockLayout.bounds[props.testID] || { x: 0, y: 0, width: 200, height: 24 };
+        cb(b.x, b.y, b.width, b.height);
+      },
+    }));
+    return React.createElement('View', props, children);
+  });
+  return {
+    Platform: { OS: 'web' },
+    StyleSheet: {
+      create: (styles) => styles,
+      flatten: (styles) => (Array.isArray(styles) ? Object.assign({}, ...styles.filter(Boolean)) : styles || {}),
+    },
+    Modal: ({ visible, children, ...props }) => (visible ? React.createElement('Modal', props, children) : null),
+    View,
+    Text: host('Text'),
+    TextInput: host('TextInput'),
+    TouchableOpacity: host('TouchableOpacity'),
+    ScrollView: host('ScrollView'),
+    Image: host('Image'),
+    useWindowDimensions: () => ({ width: 420, height: 800 }),
+    // Как настоящий PanResponder: конфиг превращается в набор обработчиков.
+    PanResponder: { create: (config) => ({ panHandlers: config }) },
+  };
+});
+
+vi.mock('@expo/vector-icons', () => ({
+  MaterialCommunityIcons: ({ name, ...props }) => React.createElement('MaterialCommunityIcons', { name, ...props }),
+}));
+vi.mock('../../i18n/locale', async (importOriginal) => {
+  const actual = await importOriginal();
+  return { ...actual, useLocale: () => 'ru-RU', useModuleLocale: () => 'ru-RU' };
+});
+vi.mock('../../components/screens/LootTradeScreen/logic/lootTradeI18n', () => ({
+  tLootTrade: (key) => key,
+  formatLootTrade: (template, values) => `${template}:${JSON.stringify(values || {})}`,
+}));
+vi.mock('../../modules/fallout/assets/backgrounds/caps.png', () => ({ default: 'caps.png' }));
+
+import HubTreeView from '../../components/screens/LootTradeScreen/modals/HubTreeView.js';
+import { CONTAINER_KIND, normalizeContainerEntity } from '../../domain/lootTrade.js';
+
+const ROOT = fileURLToPath(new URL('../../', import.meta.url));
+const read = (rel) => readFileSync(path.join(ROOT, rel), 'utf8');
+const findAll = (root, testID) => root.findAll((node) => node.props?.testID === testID);
+
+const hub = (id, extra = {}) => normalizeContainerEntity({
+  id, kind: CONTAINER_KIND.HUB, name: id, ...extra,
+});
+const child = (id, kind, extra = {}) => normalizeContainerEntity({ id, kind, name: id, ...extra });
+
+// Город: торговец, сундук и вложенная мэрия; в мэрии стол и сейф.
+const cards = () => [
+  hub('town', {
+    childOrder: ['shop', 'chest', 'mayor'],
+    links: [{ containerId: 'chest' }, { containerId: 'shop' }],
+  }),
+  hub('mayor', {
+    parentLocationId: 'town',
+    childOrder: ['desk', 'safe'],
+    links: [{ containerId: 'safe' }, { containerId: 'desk' }],
+  }),
+  child('chest', CONTAINER_KIND.LOOT),
+  child('shop', CONTAINER_KIND.MERCHANT, { caps: 100 }),
+  child('desk', CONTAINER_KIND.LOOT),
+  child('safe', CONTAINER_KIND.LOOT),
+];
+
+const mountTree = (all, onReorderChildren) => {
+  let renderer;
+  act(() => {
+    renderer = create(React.createElement(HubTreeView, {
+      hub: all[0], containers: all, keyItems: [],
+      onOpenSettings: vi.fn(), onReorderChildren,
+    }));
+  });
+  return renderer;
+};
+
+const rowIds = (renderer) => renderer.root
+  .findAll((node) => node.type === 'View'
+    && typeof node.props?.testID === 'string'
+    && node.props.testID.startsWith('hub-tree-row-'))
+  .map((node) => node.props.testID.replace('hub-tree-row-', ''));
+
+const setRowBounds = (ids, startY = 0) => {
+  ids.forEach((id, index) => {
+    mockLayout.bounds[`hub-tree-row-${id}`] = { x: 0, y: startY + index * 30, width: 200, height: 24 };
+  });
+};
+
+/**
+ * Опрос ответственности как в RN/react-native-web: capture идёт первым и
+ * принимает решение сразу; bubble опрашивается только если capture отказался.
+ * Возвращает имя сработавшей фазы — чтобы тест видел, кто именно захватил жест.
+ */
+const negotiate = (handle, kind = 'start') => {
+  const capture = kind === 'start'
+    ? 'onStartShouldSetPanResponderCapture'
+    : 'onMoveShouldSetPanResponderCapture';
+  const bubble = kind === 'start'
+    ? 'onStartShouldSetPanResponder'
+    : 'onMoveShouldSetPanResponder';
+  if (handle.props[capture]?.() === true) return 'capture';
+  if (handle.props[bubble]?.() === true) return 'bubble';
+  return null;
+};
+
+const handleOf = (renderer, childId) => {
+  const [handle] = findAll(renderer.root, `hub-tree-reorder-${childId}`);
+  expect(handle, childId).toBeTruthy();
+  return handle;
+};
+
+/** Живой жест: negotiation (capture-first) → grant → move → release. */
+const dragLikeNative = (renderer, childId, targetId, kind = 'start') => {
+  const handle = handleOf(renderer, childId);
+  const target = mockLayout.bounds[`hub-tree-row-${targetId}`];
+  let phase = null;
+  act(() => {
+    phase = negotiate(handle, kind);
+    handle.props.onPanResponderGrant({}, { x0: 0, y0: 0 });
+    handle.props.onPanResponderMove({}, { moveX: 10, moveY: target.y + 5 });
+    handle.props.onPanResponderRelease();
+  });
+  return phase;
+};
+
+describe('548: стрелка дерева работает при настоящем порядке опроса', () => {
+  it('capture принимает жест, и перенос всё равно меняет порядок', () => {
+    const onReorderChildren = vi.fn();
+    const renderer = mountTree(cards(), onReorderChildren);
+    expect(rowIds(renderer)).toEqual(['shop', 'chest', 'mayor']);
+    setRowBounds(['shop', 'chest', 'mayor']);
+
+    // В живом браузере решение принимает именно capture-фаза.
+    expect(dragLikeNative(renderer, 'chest', 'shop')).toBe('capture');
+    expect(onReorderChildren).toHaveBeenCalledWith('town', ['chest', 'shop', 'mayor']);
+  });
+
+  it('перенос вниз через capture-фазу тоже меняет порядок', () => {
+    const onReorderChildren = vi.fn();
+    const renderer = mountTree(cards(), onReorderChildren);
+    setRowBounds(['shop', 'chest', 'mayor']);
+    dragLikeNative(renderer, 'shop', 'mayor');
+    expect(onReorderChildren).toHaveBeenCalledWith('town', ['chest', 'mayor', 'shop']);
+  });
+
+  it('захват по движению (move), а не по нажатию, тоже начинает перетаскивание', () => {
+    const onReorderChildren = vi.fn();
+    const renderer = mountTree(cards(), onReorderChildren);
+    setRowBounds(['shop', 'chest', 'mayor']);
+    expect(dragLikeNative(renderer, 'chest', 'shop', 'move')).toBe('capture');
+    expect(onReorderChildren).toHaveBeenCalledWith('town', ['chest', 'shop', 'mayor']);
+  });
+
+  it('bubble-путь остаётся рабочим, если платформа опросила только его', () => {
+    const onReorderChildren = vi.fn();
+    const renderer = mountTree(cards(), onReorderChildren);
+    setRowBounds(['shop', 'chest', 'mayor']);
+    const handle = handleOf(renderer, 'chest');
+    act(() => {
+      expect(handle.props.onStartShouldSetPanResponder()).toBe(true);
+      handle.props.onPanResponderGrant({}, { x0: 0, y0: 0 });
+      handle.props.onPanResponderMove({}, { moveX: 10, moveY: 5 });
+      handle.props.onPanResponderRelease();
+    });
+    expect(onReorderChildren).toHaveBeenCalledWith('town', ['chest', 'shop', 'mayor']);
+  });
+
+  it('вложенная локация переставляет своих детей через capture-фазу', () => {
+    const onReorderChildren = vi.fn();
+    const renderer = mountTree(cards(), onReorderChildren);
+    act(() => findAll(renderer.root, 'hub-tree-toggle-mayor')[0].props.onPress());
+    setRowBounds(['desk', 'safe'], 120);
+    expect(dragLikeNative(renderer, 'safe', 'desk')).toBe('capture');
+    expect(onReorderChildren).toHaveBeenCalledWith('mayor', ['safe', 'desk']);
+  });
+
+  it('каждая ручка захватывает свою строку: чужой порядок не наследуется', () => {
+    const onReorderChildren = vi.fn();
+    const renderer = mountTree(cards(), onReorderChildren);
+    setRowBounds(['shop', 'chest', 'mayor']);
+    dragLikeNative(renderer, 'chest', 'shop');
+    dragLikeNative(renderer, 'mayor', 'shop');
+    expect(onReorderChildren).toHaveBeenNthCalledWith(1, 'town', ['chest', 'shop', 'mayor']);
+    expect(onReorderChildren).toHaveBeenNthCalledWith(2, 'town', ['mayor', 'shop', 'chest']);
+  });
+
+  it('без движения порядок не меняется — простое нажатие стрелки безвредно', () => {
+    const onReorderChildren = vi.fn();
+    const renderer = mountTree(cards(), onReorderChildren);
+    setRowBounds(['shop', 'chest', 'mayor']);
+    const handle = handleOf(renderer, 'chest');
+    act(() => {
+      negotiate(handle);
+      handle.props.onPanResponderGrant({}, { x0: 0, y0: 0 });
+      handle.props.onPanResponderRelease();
+    });
+    expect(onReorderChildren).not.toHaveBeenCalled();
+  });
+
+  it('ручка не отдаёт жест ScrollView и блокирует нативный скролл', () => {
+    const renderer = mountTree(cards(), vi.fn());
+    const handle = handleOf(renderer, 'chest');
+    expect(handle.props.onPanResponderTerminationRequest()).toBe(false);
+    expect(handle.props.onShouldBlockNativeResponder()).toBe(true);
+  });
+});
+
+describe('548: обе группы стрелок и защита от возврата бага', () => {
+  it('контекст строки задаётся в capture-фазе, а не только в bubble', () => {
+    const tree = read('components/screens/LootTradeScreen/modals/HubTreeView.js');
+    expect(tree).toContain('onStartShouldSetPanResponderCapture: claimDrag');
+    expect(tree).toContain('onMoveShouldSetPanResponderCapture: claimDrag');
+    expect(tree).toContain('onStartShouldSetPanResponder: claimDrag');
+    expect(tree).toContain('onMoveShouldSetPanResponder: claimDrag');
