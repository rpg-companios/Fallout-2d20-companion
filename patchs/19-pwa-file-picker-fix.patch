Subject: [PATCH] =?UTF-8?q?fix(pwa):=20file=20picker=20for=20character=20i?=
 =?UTF-8?q?mport=20=E2=80=94=20append=20input=20to=20DOM=20before=20click?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

В PWA (standalone mode) input.click() не открывает файловый диалог, если элемент не в DOM. Фикс: appendChild(input) перед click(), removeChild после выбора. Стандартный паттерн для PWA file input.
---
 components/screens/HomeScreen/logic/characterTransfer.js | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/components/screens/HomeScreen/logic/characterTransfer.js b/components/screens/HomeScreen/logic/characterTransfer.js
index 0bb529f..0bf15c9 100644
--- a/components/screens/HomeScreen/logic/characterTransfer.js
+++ b/components/screens/HomeScreen/logic/characterTransfer.js
@@ -88,9 +88,11 @@ export const pickCharacterFileWeb = () => new Promise((resolve) => {
   const input = document.createElement('input');
   input.type = 'file';
   input.accept = `${EXPORT_FILE_EXTENSION},application/json`;
+  input.style.display = 'none';
 
   input.onchange = () => {
     const file = input.files && input.files[0];
+    if (input.parentNode) input.parentNode.removeChild(input);
     if (!file) {
       resolve(null);
       return;
@@ -102,6 +104,8 @@ export const pickCharacterFileWeb = () => new Promise((resolve) => {
     reader.readAsText(file, 'utf-8');
   };
 
+  // PWA (standalone): input должен быть в DOM, иначе .click() не открывает диалог.
+  document.body.appendChild(input);
   input.click();
 });
 
