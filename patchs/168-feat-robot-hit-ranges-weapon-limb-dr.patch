+describe('диапазоны попаданий в экране', () => {
+  it('getSlotHitRange — обратная сторона resolveHit', () => {
+    setNewSlotModelEnabled(true);
+    expect(getSlotHitRange('protectron', 'leftArm')).toEqual({ from: 4, to: 7 });
