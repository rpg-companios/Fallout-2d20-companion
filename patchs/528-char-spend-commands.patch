diff --git a/__tests__/lootTrade/lock-break-pause-528.test.js b/__tests__/lootTrade/lock-break-pause-528.test.js
new file mode 100644
index 0000000..974576c
--- /dev/null
+++ b/__tests__/lootTrade/lock-break-pause-528.test.js
@@ -0,0 +1,207 @@
+// Патч 528: «Если ячейка красится в красный и заколка ломается, сделай
+// небольшую паузу перед обновлением цветов. Но если заколка не сломалась,
+// красный остается».
+import React, { act } from 'react';
+import TestRenderer from 'react-test-renderer';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { createLockGame, applyLockAction, BREAK_HIGHLIGHT_MS, CELL_STATE } from '../../server/lockPicking.js';
+import { initialLocalLockState, applyLocalLockAction } from '../../components/lootTrade/localLockGame.js';
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+
+vi.mock('react-native', () => {
+  const mk = (tag) => ({ children, ...props }) => React.createElement(tag, props, children);
+  return {
+    Platform: { OS: 'web' },
+    StyleSheet: {
+      create: (styles) => styles,
+      flatten: (styles) => (Array.isArray(styles) ? Object.assign({}, ...styles.filter(Boolean)) : styles || {}),
+    },
+    Modal: ({ visible, children, ...props }) => (visible ? React.createElement('Modal', props, children) : null),
+    View: mk('View'), Text: mk('Text'), TextInput: mk('TextInput'),
+    TouchableOpacity: mk('TouchableOpacity'), ScrollView: mk('ScrollView'), Image: mk('Image'),
+    KeyboardAvoidingView: mk('KeyboardAvoidingView'),
+    Animated: { Value: class { constructor(v) { this.value = v; } setValue() {} }, timing: () => ({ start() {} }) },
+    useWindowDimensions: () => ({ width: 390, height: 700 }),
+  };
+});
+vi.mock('@expo/vector-icons', () => ({
+  MaterialCommunityIcons: ({ name, ...props }) => React.createElement('MaterialCommunityIcons', { name, ...props }),
+}));
+vi.mock('../../components/alerts/alertService', () => ({ showRawAlert: vi.fn() }));
+vi.mock('../../src/room/roomCharacterSync', () => ({
+  pushSavedCharacterToBoundRoomIfAny: vi.fn(async () => true),
+}));
+vi.mock('../../components/lootTrade/spendBobbyPins', () => ({
+  spendBobbyPins: vi.fn(async () => 1),
+}));
+
+import LockPickingModal from '../../components/lootTrade/LockPickingModal';
+import useCharacterStore from '../../src/store/characterStore';
+import useRoomStore from '../../src/room/roomStore';
+import { lockLightStyles } from '../../components/lootTrade/lockPickingStyles';
+
+const LOW_SKILL = {
+  data: {
+    attributes: { PER: { value: 10 }, LCK: { value: 4 } },
+    skills: [{ name: 'LOCKPICK', value: 0 }],
+    items: [{ itemId: 'item_bobby_pin', quantity: 5 }],
+  },
+};
+const HELD_SKILL = {
+  data: { ...LOW_SKILL.data, skills: [{ name: 'LOCKPICK', value: 6 }] },
+};
+
+const LOCK = { containerId: 'l1', name: 'Замок', description: '', difficulty: 2, kind: 'lock' };
+
+const boardGame = (overrides = {}) => ({
+  status: 'playing',
+  kind: 'lock',
+  result: 'PIN BROKEN',
+  cells: [
+    { arrow: null, state: 'red' },
+    { arrow: 'left', state: 'grey' },
+    { arrow: null, state: 'hidden' },
+    { arrow: null, state: 'hidden' },
+  ],
+  rows: [4],
+  cellCount: 4,
+  cursor: 0,
+  per: 10,
+  luck: 4,
+  skill: 0,
+  difficulty: 1,
+  pinsRemaining: 3,
+  pinActive: true,
+  brokenPins: 1,
+  breakHighlight: { durationMs: 15 },
+  revision: 7,
+  operatorClientId: 'client-1',
+  operatorCharacterId: 'ch1',
+  ...overrides,
+});
+
+const roomWith = (game) => ({
+  joined: true,
+  capabilities: { terminalHacking: true, lockPicking: true },
+  terminalStates: {
+    l1: {
+      containerId: 'l1', accessId: 'broadcast-1', config: LOCK,
+      game, closed: false, locked: false, awaitingGm: false,
+    },
+  },
+});
+
+const renderers = [];
+const render = async () => {
+  let renderer;
+  await act(async () => {
+    renderer = TestRenderer.create(
+      <LockPickingModal visible lock={LOCK} roomCode="ROOM1" onClose={() => {}} />,
+    );
+    await Promise.resolve();
+  });
+  renderers.push(renderer);
+  return renderer;
+};
+const pause = async (ms = 60) => {
+  await act(async () => { await new Promise((resolve) => setTimeout(resolve, ms)); });
+};
+const cell = (renderer, idx) => renderer.root.findAllByProps({ testID: `lock-cell-${idx}` })[0];
+const cellText = (node) => {
+  const text = node.findAllByType('Text')[0];
+  return Object.assign({}, ...[].concat(text.props.style).filter(Boolean));
+};
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  useCharacterStore.setState({
+    currentCharacterId: 'ch1', characterName: 'Сталкер',
+    items: { p: { weaponId: 'item_bobby_pin', quantity: 4 } },
+  });
+  useRoomStore.setState({
+    clientId: 'client-1',
+    rooms: { ROOM1: roomWith(boardGame()) },
+    actOnTerminal: vi.fn(async () => ({ game: null })),
+  });
+});
+
+afterEach(async () => {
+  for (const renderer of renderers.splice(0)) {
+    try { await act(async () => renderer.unmount()); } catch { /* уже снято */ }
+  }
+});
+
+describe('528: сервер помечает поломку паузой, но не поломку без паузы', () => {
+  it('на поломке появляется breakHighlight, красная ячейка сохраняется', () => {
+    const game = createLockGame({ config: { difficulty: 1 }, characterSnapshot: LOW_SKILL, rng: () => 0 });
+    const broken = applyLockAction({ game, config: {}, action: 'press', value: 'up', rng: () => 0.99 }).game;
+    expect(broken.brokenPins).toBe(1);
+    expect(broken.breakHighlight).toEqual({ durationMs: BREAK_HIGHLIGHT_MS });
+    expect(broken.cells[0]).toEqual({ arrow: null, state: CELL_STATE.RED });
+  });
+
+  it('если заколка НЕ сломалась — паузы нет, красный остаётся', () => {
+    const game = createLockGame({ config: { difficulty: 1 }, characterSnapshot: HELD_SKILL, rng: () => 0 });
+    const wrong = applyLockAction({ game, config: {}, action: 'press', value: 'up', rng: () => 0.99 }).game;
+    expect(wrong.brokenPins).toBe(0);
+    expect(wrong.breakHighlight).toBeNull();
+    expect(wrong.cells[0]).toEqual({ arrow: null, state: CELL_STATE.RED });
+  });
+
+  it('следующее нажатие снимает метку паузы и стирает старый красный', () => {
+    const game = createLockGame({ config: { difficulty: 1 }, characterSnapshot: LOW_SKILL, rng: () => 0 });
+    const broken = applyLockAction({ game, config: {}, action: 'press', value: 'up', rng: () => 0.99 }).game;
+    const again = applyLockAction({ game: broken, config: {}, action: 'press', value: 'left', rng: () => 0.99 }).game;
+    expect(again.breakHighlight).toBeNull();
+    expect(again.cells.filter((c) => c.state === CELL_STATE.RED).length).toBeLessThanOrEqual(1);
+  });
+
+  it('локальный резерв доски тоже отдаёт breakHighlight клиенту', () => {
+    let state = initialLocalLockState();
+    state = applyLocalLockAction(state, 'start', undefined, {
+      lock: LOCK, characterId: 'ch1', characterSnapshot: LOW_SKILL, rng: () => 0,
+    });
+    state = applyLocalLockAction(state, 'press', 'up', {
+      lock: LOCK, characterId: 'ch1', characterSnapshot: LOW_SKILL, rng: () => 0.99,
+    });
+    expect(state.view.brokenPins).toBe(1);
+    expect(state.view.breakHighlight).toEqual({ durationMs: BREAK_HIGHLIGHT_MS });
+  });
+});
+
+describe('528: пауза в окне замка', () => {
+  it('красный «?» виден сразу и гаснет только после паузы', async () => {
+    const renderer = await render();
+    expect(cellText(cell(renderer, 0)).color).toBe('#c1121f');
+    await pause();
+    expect(cellText(cell(renderer, 0)).color).not.toBe('#c1121f');
+  });
+
+  it('на время паузы не перескакиваем в «Подход завершён» даже без заколок', async () => {
+    useRoomStore.setState({ rooms: { ROOM1: roomWith(boardGame({
+      status: 'awaitingRetry', result: 'OUT OF PINS', pinsRemaining: 0, pinActive: false,
+    })) } });
+    const renderer = await render();
+    expect(renderer.root.findAllByProps({ testID: 'lock-cells-board' }).length).toBeGreaterThan(0);
+    expect(renderer.root.findAllByProps({ testID: 'lock-approach-finished' })).toHaveLength(0);
+    expect(cellText(cell(renderer, 0)).color).toBe('#c1121f');
+    await pause();
+    expect(renderer.root.findAllByProps({ testID: 'lock-approach-finished' }).length).toBeGreaterThan(0);
+  });
+
+  it('без поломки красный остаётся сколь угодно долго', async () => {
+    useRoomStore.setState({ rooms: { ROOM1: roomWith(boardGame({
+      result: 'TRY AGAIN', breakHighlight: null, brokenPins: 0,
+      cells: [
+        { arrow: null, state: 'red' }, { arrow: null, state: 'hidden' },
+        { arrow: null, state: 'hidden' }, { arrow: null, state: 'hidden' },
+      ],
+    })) } });
+    const renderer = await render();
+    expect(cellText(cell(renderer, 0)).color).toBe('#c1121f');
+    await pause();
+    expect(cellText(cell(renderer, 0)).color).toBe('#c1121f');
+    expect(cell(renderer, 0).props.style).toEqual(expect.arrayContaining([lockLightStyles.cellRed]));
+  });
+});
diff --git a/__tests__/room/char-spend-commands-528.test.js b/__tests__/room/char-spend-commands-528.test.js
new file mode 100644
index 0000000..26eb998
--- /dev/null
+++ b/__tests__/room/char-spend-commands-528.test.js
@@ -0,0 +1,156 @@
+// Приёмочный тест патча 528. Владелец: «Заколки удаляются не из снапшота,
+// а клиенту посылается команда на списание заколки из инвентаря, штатными
+// средствами. И после списания посылается команда на обновление снапшота».
+import { describe, expect, it, vi } from 'vitest';
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createRoomRegistry } from '../../server/roomRegistry.js';
+import { MESSAGE as SERVER_MESSAGE } from '../../server/protocol.js';
+import { ROOM_MESSAGE as CLIENT_MESSAGE } from '../../src/room/roomProtocol';
+import { applyCharSpendCommand, resetAppliedPinSpendsForTests } from '../../components/lootTrade/CharSpendCommandHost.js';
+
+const ROOT = fileURLToPath(new URL('../../', import.meta.url));
+const read = (rel) => readFileSync(path.join(ROOT, rel), 'utf8');
+
+const setup = () => {
+  const registry = createRoomRegistry({ now: () => 1000 });
+  const { room } = registry.createRoom({ clientId: 'gm', name: 'Стол' });
+  const code = room.code;
+  registry.joinRoom({ code, clientId: 'gm', name: 'GM', role: 'gm' });
+  registry.joinRoom({ code, clientId: 'p1', name: 'Игрок', role: 'player' });
+  registry.putSnapshot({
+    code, characterId: 'ch1', revision: 1,
+    snapshot: { items: { p: { weaponId: 'item_bobby_pin', quantity: 5 } } },
+    fromClientId: 'p1', fromName: 'Игрок',
+  });
+  return { registry, code, room: registry._rooms.get(code) };
+};
+
+describe('528: протокол команд списания', () => {
+  it('char.spend / char.refresh зеркально есть на сервере и клиенте', () => {
+    expect(SERVER_MESSAGE.CHAR_SPEND).toBe('char.spend');
+    expect(SERVER_MESSAGE.CHAR_REFRESH).toBe('char.refresh');
+    expect(CLIENT_MESSAGE.CHAR_SPEND).toBe(SERVER_MESSAGE.CHAR_SPEND);
+    expect(CLIENT_MESSAGE.CHAR_REFRESH).toBe(SERVER_MESSAGE.CHAR_REFRESH);
+  });
+
+  it('реестр хранит команду до публикации листа и повторяет её после реконнекта', () => {
+    const { registry, code } = setup();
+    const entry = registry.registerPinSpend({
+      code, characterId: 'ch1', clientId: 'p1', count: 1, spendId: 'pin-a1',
+    });
+    expect(entry).toMatchObject({
+      spendId: 'pin-a1', characterId: 'ch1', clientId: 'p1', count: 1, itemId: 'item_bobby_pin',
+    });
+    expect(registry.pendingSpendsForClient(code, 'p1')).toHaveLength(1);
+    expect(registry.pendingSpendsForClient(code, 'another-tab')).toHaveLength(0);
+    expect(registry.getState(code).pendingSpends).toHaveLength(1);
+    // Обычная публикация листа (вторая команда) снимает неподтверждённые.
+    registry.putSnapshot({
+      code, characterId: 'ch1', revision: 5,
+      snapshot: { items: { p: { weaponId: 'item_bobby_pin', quantity: 4 } } },
+      fromClientId: 'p1', fromName: 'Игрок',
+    });
+    expect(registry.getState(code).pendingSpends).toHaveLength(0);
+    expect(registry.pendingSpendsForClient(code, 'p1')).toHaveLength(0);
+  });
+
+  it('сервер больше не правит чужой снимок', () => {
+    const registrySource = read('server/roomRegistry.js');
+    const serverSource = read('server/roomServer.js');
+    expect(registrySource).not.toContain('consumeBobbyPins(');
+    expect(registrySource).toContain('pinsToSpend');
+    expect(serverSource).toContain('sendPinSpendCommands');
+    expect(serverSource).toContain('MESSAGE.CHAR_SPEND');
+    expect(serverSource).toContain('MESSAGE.CHAR_REFRESH');
+  });
+});
+
+describe('528: клиент применяет команды в строгом порядке', () => {
+  const deps = (overrides = {}) => {
+    const spend = vi.fn(async () => 1);
+    const publish = vi.fn(async () => true);
+    return {
+      spend,
+      publish,
+      d: {
+        spendBobbyPins: spend,
+        publish,
+        getCharacterId: () => 'ch1',
+        isApplied: async () => false,
+        setApplied: vi.fn(async () => true),
+        log: vi.fn(),
+        ...overrides,
+      },
+    };
+  };
+
+  it('char.spend списывает штатным вызовом и НЕ публикует лист сам', async () => {
+    const { spend, d } = deps();
+    const result = await applyCharSpendCommand({
+      type: CLIENT_MESSAGE.CHAR_SPEND,
+      payload: { spendId: 's1', characterId: 'ch1', itemId: 'item_bobby_pin', count: 1 },
+    }, new Map(), d);
+    expect(result).toMatchObject({ ok: true, started: true });
+    expect(spend).toHaveBeenCalledWith(1, { characterId: 'ch1', publish: false });
+  });
+
+  it('char.refresh ждёт окончания списания и только потом обновляет снимок', async () => {
+    let resolveSpend;
+    const spend = vi.fn(() => new Promise((resolve) => { resolveSpend = resolve; }));
+    const publish = vi.fn(async () => true);
+    const d = {
+      spendBobbyPins: spend,
+      publish,
+      getCharacterId: () => 'ch1',
+      isApplied: async () => false,
+      setApplied: vi.fn(async () => true),
+      log: vi.fn(),
+    };
+    const jobs = new Map();
+    const base = { spendId: 's2', characterId: 'ch1' };
+    await applyCharSpendCommand({
+      type: CLIENT_MESSAGE.CHAR_SPEND,
+      payload: { ...base, itemId: 'item_bobby_pin', count: 1 },
+    }, jobs, d);
+    const refreshing = applyCharSpendCommand({
+      type: CLIENT_MESSAGE.CHAR_REFRESH, payload: base,
+    }, jobs, d);
+    expect(publish).not.toHaveBeenCalled();
+    resolveSpend(1);
+    await refreshing;
+    expect(publish).toHaveBeenCalledWith('ch1');
+    expect(jobs.has('s2')).toBe(false);
+  });
+
+  it('повтор команды после реконнекта не списывает заколку дважды', async () => {
+    const { spend, d } = deps({ isApplied: async () => true });
+    const result = await applyCharSpendCommand({
+      type: CLIENT_MESSAGE.CHAR_SPEND,
+      payload: { spendId: 's3', characterId: 'ch1', itemId: 'item_bobby_pin', count: 1 },
+    }, new Map(), d);
+    expect(result.duplicate).toBe(true);
+    expect(spend).not.toHaveBeenCalled();
+  });
+
+  it('команда для другого персонажа или другого предмета игнорируется', async () => {
+    const { spend, d } = deps({ getCharacterId: () => 'ch2' });
+    expect((await applyCharSpendCommand({
+      type: CLIENT_MESSAGE.CHAR_SPEND,
+      payload: { spendId: 's4', characterId: 'ch1', itemId: 'item_bobby_pin', count: 1 },
+    }, new Map(), d)).reason).toBe('other-character');
+    const wrongItem = await applyCharSpendCommand({
+      type: CLIENT_MESSAGE.CHAR_SPEND,
+      payload: { spendId: 's5', characterId: 'ch1', itemId: 'caps', count: 1 },
+    }, new Map(), deps().d);
+    expect(wrongItem.reason).toBe('wrong-item');
+    expect(spend).not.toHaveBeenCalled();
+  });
+
+  it('хост смонтирован поверх всех экранов, чтобы лист обновился и при закрытом окне', () => {
+    expect(read('App.js')).toContain('<CharSpendCommandHost />');
+    expect(read('src/room/roomStore.ts')).toContain('onRoomCharSpend');
+    resetAppliedPinSpendsForTests();
+  });
+});
