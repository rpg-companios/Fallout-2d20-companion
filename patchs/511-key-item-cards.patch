+  saveBtnText: { color: ADMIN_MODAL_PALETTE.text, fontSize: 15, fontWeight: '700' },
+  cancelBtn: { backgroundColor: ADMIN_MODAL_PALETTE.surfaceRaised, borderColor: ADMIN_MODAL_PALETTE.border },
