+    characterName: 'Минутмен',
+    level: 3,
+    origin: { id: 'minuteman', name: 'Минитмен' },
+    trait: null,
+    currency: 77,
+    currentHealth: 12,
+    radiation: 4,
+    sceneCounter: 3,
+    traitEffects: [{ id: 'trait_glow', name: 'Светящийся' }],
