#!/bin/sh
# Патч 300: перевод источника списания ammoPerAttack (пропуск 298).
# Применять из корня репозитория: sh patchs/300-weapon-ammo-spend-source-i18n.patch
# Правит только словари ru/en (weapon.ammoSpend.source.ammoPerAttack)
# и добавляет тест-предохранитель «source → ключ в обоих словарях».
patch -p1 <<'PATCH_300_EOF'
diff --git a/__tests__/weapons/weapon-ammo-spend.test.js b/__tests__/weapons/weapon-ammo-spend.test.js
index 9489af7..bc4cd22 100644
--- a/__tests__/weapons/weapon-ammo-spend.test.js
+++ b/__tests__/weapons/weapon-ammo-spend.test.js
@@ -143,3 +143,24 @@ describe('формула применяется и исчезает вместе
     expect(plan.asks).toEqual([]);
   });
 });
+
+describe('источники запросов расхода зарядов: переводы (298, пропуск ammoPerAttack)', () => {
+  it('каждый source из плана — с непустым ключом в словарях ru и en', async () => {
+    const { WEAPONS_DICTIONARIES } = await import(
+      '../../modules/fallout/screens/WeaponsAndArmorScreen/weaponsAndArmorScreenI18n'
+    );
+    const plan = buildMechAmmoSpend({
+      qualities: [{ qualityId: 'quality_crank_x', value: 3 }],
+      mods: [{ id: 'mod_test_ammo_per_attack', ammoPerAttack: 6 }],
+      available: 12,
+    });
+    expect(plan.asks.map((a) => a.source)).toEqual(['crank', 'ammoPerAttack']);
+    for (const locale of ['ru-RU', 'en-EN']) {
+      for (const source of plan.asks.map((a) => a.source)) {
+        // ПРАВИЛО (владелец): промах ключа — дефект данных, маркер — сам путь.
+        const label = WEAPONS_DICTIONARIES[locale]?.weapon?.ammoSpend?.source?.[source];
+        expect(label, `${locale}: weapon.ammoSpend.source.${source}`).toBeTruthy();
+      }
+    }
+  });
+});
diff --git a/i18n/en-EN/screens/weaponsAndArmor/screen.json b/i18n/en-EN/screens/weaponsAndArmor/screen.json
index c225ad6..7a24a67 100644
--- a/i18n/en-EN/screens/weaponsAndArmor/screen.json
+++ b/i18n/en-EN/screens/weaponsAndArmor/screen.json
@@ -44,7 +44,8 @@
       "available": "Charges available",
       "source": {
         "crank": "Crank",
-        "capacitor": "Capacitor"
+        "capacitor": "Capacitor",
+        "ammoPerAttack": "Mod spend per attack"
       },
       "upTo": "spend up to",
       "unconditional": "Unconditional",
diff --git a/i18n/ru-RU/screens/weaponsAndArmor/screen.json b/i18n/ru-RU/screens/weaponsAndArmor/screen.json
index f4732ee..157d3d5 100644
--- a/i18n/ru-RU/screens/weaponsAndArmor/screen.json
+++ b/i18n/ru-RU/screens/weaponsAndArmor/screen.json
@@ -44,7 +44,8 @@
       "available": "Доступно зарядов",
       "source": {
         "crank": "Заводная рукоятка",
-        "capacitor": "Конденсатор"
+        "capacitor": "Конденсатор",
+        "ammoPerAttack": "Расход мода за атаку"
       },
       "upTo": "потратить до",
       "unconditional": "Безусловно",
PATCH_300_EOF
