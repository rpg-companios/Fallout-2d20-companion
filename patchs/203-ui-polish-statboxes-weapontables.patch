+++ b/docs/survival-system-design.md
@@ -1,7 +1,7 @@
 # Система выживания — дизайн-документ
 
-Редакция **0.3.6** от 2026-09-07.
-Статус: этапы 1–3 и первая часть этапа 4 реализованы (патчи 197–202);
+Редакция **0.3.7** от 2026-09-07.
+Статус: этапы 1–3 и первая часть этапа 4 реализованы (патчи 197–203);
 модалки еды/питья/сна — следующий патч.
 
 Железное правило (владелец): **опираемся на данные; нужного признака нет —
@@ -394,6 +394,12 @@ survival: {
 
 ## 15. История редакций
 
+- **0.3.7 (2026-09-07):** полировка UI: значения областей выживания —
+  отступы от краёв (paddingHorizontal); карточки оружия — ячейка-лейбл
+  фиксированной доли (42%) во всех карточках, длинные значения
+  («Энергетический») больше не сжимают первую ячейку. Стартовый лог веба
+  `{"hydrate": …, "rootTag": …}` — штатный вывод Expo/react-native-web,
+  не ошибка приложения.
 - **0.3.6 (2026-09-07):** поле шкал убрано (решение владельца: «текущую со
   шкалами на помойку»). Вместо него три области третьим рядом статистики
   («Голод» / «Жажда» / «Сон»), значение — название состояния из книги;
diff --git a/styles/WeaponsAndArmorScreen.styles.js b/styles/WeaponsAndArmorScreen.styles.js
index 3ea6407..8952f0b 100644
--- a/styles/WeaponsAndArmorScreen.styles.js
+++ b/styles/WeaponsAndArmorScreen.styles.js
@@ -34,6 +34,9 @@ const styles = StyleSheet.create({
   statBoxValueContainer: {
     flex: 1,
     paddingVertical: 8,
+    // Отступы от краёв области: длинные текстовые значения (названия
+    // состояний выживания) не упираются в рамку (владелец, 0.3.7).
+    paddingHorizontal: 6,
     alignItems: 'center',
     justifyContent: 'center',
     backgroundColor: '#fff',
@@ -154,7 +157,10 @@ const styles = StyleSheet.create({
     backgroundColor: '#333',
     color: '#fff',
     fontWeight: 'bold',
-    flex: 1,
+    // Фиксированная доля ячейки-лейбла — одинакова во всех карточках:
+    // длинное значение («Энергетический») больше не сжимает первую ячейку
+    // (владелец, 0.3.7). Ячейка значения забирает остальное (flex: 1).
+    width: '42%',
     padding: 8,
     fontSize: 12,
   },
