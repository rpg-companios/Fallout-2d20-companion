From 785e1db15a034e2bc5426c07aa95eb6378b26f17 Mon Sep 17 00:00:00 2001
From: arena-agent <297053741+arena-agent@users.noreply.github.com>
Date: Wed, 5 Aug 2026 04:30:05 +0000
Subject: [PATCH] fix(ui): use locale-driven effectDescription; drop redundant
 effectsLegacy
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

effectsLegacy — английский дубль описания эффекта в data-файле — всегда перебивал локализованный effectDescription (effectsLegacy ?? effectDescription) и ломал показ русского. Чистка: удалить effectsLegacy из data (203 мода) и из buildWeaponModRow; в normalizeModRow брать i18n effectDescription (locale-driven), фолбэк — effects. Текст не теряется: у всех 203 модов есть effectDescription в обеих локалях.
---
 .../modal/WeaponModificationModal.js          |   4 +-
 data/equipment/weapon_mods.json               | 211 +-----------------
 db/catalogSource.js                           |   1 -
 3 files changed, 6 insertions(+), 210 deletions(-)

diff --git a/components/screens/WeaponsAndArmorScreen/modal/WeaponModificationModal.js b/components/screens/WeaponsAndArmorScreen/modal/WeaponModificationModal.js
index 7bbb2cf..c00b9b9 100644
--- a/components/screens/WeaponsAndArmorScreen/modal/WeaponModificationModal.js
+++ b/components/screens/WeaponsAndArmorScreen/modal/WeaponModificationModal.js
@@ -33,8 +33,8 @@ function normalizeModRow(row) {
     // canonical DB fields only
     weight: row.weight ?? 0,
     cost: row.cost ?? 0,
-    // Localized description for UI
-    effectDescription: row.effectsLegacy ?? row.effectDescription ?? row.effect_description ?? row.effects ?? '',
+    // Localized description for UI (i18n effectDescription, locale-driven).
+    effectDescription: row.effectDescription || row.effect_description || row.effects || '',
     damageModifier: row.damageModifier,
     fireRateModifier: row.fireRateModifier,
     rangeModifier: row.rangeModifier,
