+        const raw = await downloadRemoteCharacter(token, remote.id);
+        const parsed = parseGmRoomCloudPayload(raw);
+        if (parsed.error || !parsed.room) continue;
+        await saveImportedGmRoom(parsed.room, localRoomsByCode);
