diff --git a/modules/fallout/i18n/en-EN/data/system/traits.json b/modules/fallout/i18n/en-EN/data/system/traits.json
new file mode 100644
index 0000000..aa1da93
--- /dev/null
+++ b/modules/fallout/i18n/en-EN/data/system/traits.json
@@ -0,0 +1,205 @@
+{
+  "traits": {
+    "brotherhood": {
+      "chainThatBinds": {
+        "name": "The Chain That Binds",
+        "description": "You grew up in the strict hierarchy of the Brotherhood of Steel, where the chain of command is sacred. Your devotion to the order and its technological ideals knows no bounds.\n\nYou gain one additional tagged skill of your choice from: Energy Weapons, Science, or Repair.",
+        "forcedSkills": [
+          "Energy Weapons",
+          "Science",
+          "Repair"
+        ]
+      }
+    },
+    "brotherhoodOutcast": {
+      "chainThatBreaks": {
+        "name": "The Chain That Breaks",
+        "description": "You believe your Brotherhood leadership cares only about collecting pre-war technology. Your role as a member, as a descendant of soldiers, compels you to help others and pursue goals beyond the Brotherhood's dogma.\n\nYou gain one additional tagged skill of your choice from: Energy Weapons, Science, or Repair.",
+        "forcedSkills": [
+          "Energy Weapons",
+          "Science",
+          "Repair"
+        ]
+      }
+    },
+    "superMutant": {
+      "forcedEvolution": {
+        "name": "Forced Evolution",
+        "description": "Your starting Strength and Endurance are each increased by +2, and their maximums are raised to 12, while Intelligence and Charisma maximums are reduced to 6. All your skills are capped at rank 4. You are fully immune to radiation and poison damage. You do not appear to age, but you are sterile. You may only wear armor made for super mutants."
+      }
+    },
+    "ghoul": {
+      "necroticPosthuman": {
+        "name": "Necrotic Posthuman",
+        "description": "You are immune to radiation damage. Moreover, you heal from it — restoring 1 HP for every 3 points of radiation damage dealt to you. If you rest in an irradiated area, you may reroll your dice pool when checking if your injuries heal. Additionally, Survival becomes a tagged skill, raising it by 2 ranks."
+      }
+    },
+    "minuteman": {
+      "peoplesMilitia": {
+        "name": "People's Militia",
+        "description": "You grew up in the tradition of the Minutemen — defenders of the common people of the Commonwealth. Your dedication to protecting civilians and readiness to help at any moment have become part of your nature.\n\nYou gain one additional tagged skill of your choice from: Small Guns, Survival, or Speech.",
+        "forcedSkills": [
+          "Small Guns",
+          "Survival",
+          "Speech"
+        ]
+      }
+    },
+    "childOfAtom": {
+      "radioactiveSponge": {
+        "name": "Radioactive Sponge",
+        "description": "Your unusual life experience grants you an additional perk at first level. You can resist, accumulate, and even channel radiation through your body. Your base radiation damage resistance is 1. Once per scene, when someone at close range would suffer radiation damage, you may take the hit instead."
+      }
+    },
+    "vaultDweller": {
+      "vaultKid": {
+        "name": "Vault Kid",
+        "description": "Your healthy upbringing from skilled doctors and high-tech Auto-Docs reduces the difficulty of all END checks and lets you resist disease effects. Additionally, thanks to your carefully planned education, you gain one additional tagged skill of your choice."
+      }
+    },
+    "protectron": {
+      "protectOrDestroy": {
+        "name": "Protect or Destroy",
+        "description": "You were built to survive harsh conditions. Once per scene you may reroll a check to overcome an environmental hazard. You are immune to disease, radiation, and poison, but cannot use chems or benefit from food, drink, or rest. You cannot recover from injuries or restore HP without repair."
+      }
+    },
+    "assaultron": {
+      "designedForFrontline": {
+        "name": "Designed for the Frontline",
+        "description": "You are a robot immune to disease, radiation damage, and poison, but unable to use chems or benefit from food, drink, or rest. You cannot recover from injuries or restore HP without repair. Your chain-driven limbs grant +1 Combat Die to melee attacks. A powerful laser is built into your armored head."
+      }
+    },
+    "ncr": {
+      "resident": {
+        "name": "NCR Resident",
+        "description": "You grew up in the New California Republic."
+      },
+      "goodSoul": {
+        "name": "Good Soul",
+        "description": "You gain one additional tagged skill of your choice from: Speech, Medicine, Repair, Science, or Barter."
+      },
+      "infantryman": {
+        "name": "Infantryman",
+        "description": "You deal +1 damage when using NCR infantry weapons."
+      },
+      "homeOnTheRange": {
+        "name": "Home on the Range",
+        "description": "You feel at home on the open wasteland."
+      },
+      "techniqueOfDescent": {
+        "name": "Trigger Discipline",
+        "description": "Reduces fire rate of small guns and energy weapons by 1 when both types are equipped simultaneously."
+      },
+      "brahminBaron": {
+        "name": "Brahmin Baron",
+        "description": "Your connections with traders give advantages in barter."
+      }
+    },
+    "survivor": {
+      "survivor": {
+        "name": "Survivor",
+        "description": "You are hardened by life on the wasteland."
+      },
+      "educated": {
+        "name": "Educated",
+        "description": "Tag one additional skill. When you fail a check for an untagged skill, the GM gains 1 AP."
+      },
+      "quickShot": {
+        "name": "Quick Shot",
+        "description": "If in combat you take a second major action and use it for a ranged attack, the second major action costs 1 AP instead of 2. You cannot take aiming actions — you are too impatient."
+      },
+      "gifted": {
+        "name": "Gifted",
+        "description": "Gain +1 to two attributes or +2 to one attribute. In return, your Luck is reduced by -1."
+      },
+      "heavyHanded": {
+        "name": "Heavy Handed",
+        "description": "Your melee damage bonus increases by +1. Your melee and unarmed attacks gain a complication on a 19 or 20, not just on 20."
+      },
+      "smallFrame": {
+        "name": "Small Frame",
+        "description": "You may reroll 1d20 on any AGI check that depends on balance or flexibility. You can carry less than others."
+      }
+    },
+    "synth": {
+      "moreThanHuman": {
+        "name": "More Than Human",
+        "description": "Outwardly and mentally indistinguishable from a human, but biologically enhanced. Does not require sleep, food, or water, does not age, does not get sick, and is fully immune to poison, radiation, and disease.\n\nPros: +1 additional Tagged skill. Instead of sleeping, may spend the time crafting, reading, or light scouting.\n\nCons: If NPCs who know of their nature are not friendly to synths, the difficulty of all Charisma checks increases by 2. On a complication, NPCs become hostile or reputation drops. They have an Institute code phrase: upon hearing it, they become incapacitated and lose their identity until restored by the Institute."
+      }
+    },
+    "misterHandy": {
+      "robotMrHandy": {
+        "name": "Robot Mr. Handy",
+        "description": "You have 360-degree vision and an enhanced sensor suite. You are immune to radiation and poison damage, but cannot use chems or benefit from food, drink, or rest. You hover via jet propulsion. You cannot recover from injuries or restore HP without repair."
+      }
+    },
+    "robobrain": {
+      "robotWithBrains": {
+        "name": "Robot with Brains",
+        "description": "You are a robot with a human brain as your central processor. You have visual sensors capable of detecting the visual spectrum and infrared radiation. You are immune to radiation and poison, but cannot use chems or benefit from food, drink, or rest."
+      }
+    },
+    "shadow": {
+      "shadow": {
+        "name": "Shadow",
+        "description": "Your initial Strength and Endurance scores increase by +2 each, and your maximum Strength and Endurance scores increase to 12, but your maximum Intelligence and Charisma scores decrease to 8. You cannot have a rank higher than 4 in any skill. You are completely immune to radiation and poison damage.\n\nYour height is over two meters; your body is bulky and muscular, and your skin is blue. You do not appear to age, but you are infertile. You may only wear armor that was made for super mutants.\n\nYou can easily become addicted to Stealth Boy; its prolonged use has dealt enormous damage to your psyche and mental health. Whenever you use Stealth Boy, roll 1 {CD} per dose you took this session. If any effects come up, you get the following symptoms:\n\nStealth Boy Addiction: A failed addiction check makes you addicted to Stealth Boy. The difficulty of Perception and Intelligence tests increases by +2, and Charisma tests by +1, until cured."
+      }
+    },
+    "securitron": {
+      "markI": {
+        "name": "Mark I Securitron",
+        "description": "You are a robot with the Mk I operating system designed by RobCo Industries. You move on a single wheel: the difficulty of tests relying on balance or stability is increased by 1. Your arms are fitted with manipulator claws, allowing you to roughly manipulate your surroundings and make unarmed melee attacks, and integrated weapons are built into your palms. Missile launchers are mounted in your shoulders, and a grenade launcher is integrated into your left arm, but both are inoperable until you are fitted with the Mk II operating system. Your carry weight is 150 lbs. It cannot be increased by your Strength or perks, but it can be increased by modified armor. You are immune to radiation and poison damage, but you cannot use chems, nor can you benefit from food, drink, or rest. You cannot recover from your injuries or regain health points without receiving repairs."
+      }
+    },
+    "tribal": {
+      "tribal": {
+        "name": "Wasteland Tribal",
+        "description": "You may choose two traits from the Tribal traits or two traits from the Survivor origin. You also have the option to choose one trait from the following: Tribal traits, Survivor traits, New California Republic Citizen traits, plus one additional perk. Each trait has a certain advantage and may have its own drawback."
+      },
+      "motherWasteland": {
+        "name": "Mother Wasteland",
+        "description": "ADVANTAGE: Spend 1 Luck Point to gain an insight into a quest, situation, or scene, as if you spent 3 AP to use \"Gather Information\" 3 times. This information is often cryptic and mystical in nature.\n\nDRAWBACK: Complications make it harder to understand scenes involving pre-war artifacts, limiting their use. (Fluff only — no mechanical effect in the app)"
+      },
+      "nomad": {
+        "name": "Nomad",
+        "description": "ADVANTAGE: Reroll 1d20 on Survival tests while traveling, making camp, and foraging for food and water. In addition, ignore the first complication rolled on these tests.\n\nDRAWBACK: The difficulty of Barter and Speech tests is increased, and the complication range when interacting with inhabitants of permanent settlements is increased by 1. The Science skill cannot be tagged (permanently; you may still put points into it, but not tag it)."
+      },
+      "riteOfPassage": {
+        "name": "Rite of Passage",
+        "description": "ADVANTAGE: During a scene, the first time you spend a Luck Point, roll 1 {/CD}. If an effect is rolled, you do not spend that Luck Point.\n\nDRAWBACK: You believe those who have not undergone your rite of passage are unworthy of respect. You cannot help another player character unless you first spend 1 AP."
+      },
+      "oldWorldTools": {
+        "name": "Old World Tools",
+        "description": "ADVANTAGE: You may use the Survival skill instead of the Repair or Science skills when repairing or using pre-war technology.\n\nDRAWBACK: The complication range when passing tests using pre-war technology (not weapons) is increased by 2. (Fluff only — no mechanical effect in the app)"
+      },
+      "chosenOne": {
+        "name": "Chosen One",
+        "description": "ADVANTAGE: When buying dice, you may get your first d20 for free, but only on tests related to your tribe's quest; you can also always succeed at a cost.\n\nDRAWBACK: When a situation directly concerns your quest, the GM adds 2 AP to their pool. (Fluff only — no mechanical effect in the app)"
+      }
+    },
+    "treeFamilies": {
+      "family": {
+        "name": "Strip Families",
+        "description": "You are a member of one of the three Strip families. Choose your family: each grants its own advantage."
+      },
+      "chairmen": {
+        "name": "The Chairmen",
+        "description": "Once per scene, you may re-roll one d20 when passing a single skill test based on Charisma (CHA)."
+      },
+      "omerta": {
+        "name": "Omerta",
+        "description": "Chems you administer to other characters have their Addiction property increased by 1. If a chem has no Addiction property, it gains Addiction 1."
+      },
+      "whiteGlove": {
+        "name": "White Glove Society",
+        "description": "Food you cook at a Cooking Station restores 1 more HP. When you butcher a corpse for meat, you gain one additional piece. Charisma (CHA) skill tests involving those outside the White Glove Society increase their Complication range by 1."
+      }
+    },
+    "enclaveRemnant": {
+      "hidden": {
+        "name": "Hidden and Hunted",
+        "description": "Tag one additional skill of your choice: **Sneak** or **Survival**.\n\nThe NCR and the Brotherhood of Steel hunt war criminals like you:\n- the difficulty of reputation tests with the NCR and Brotherhood of Steel is **increased by 2**;\n- if you are exposed, both factions become **hostile**.\n\nOnce per quest (or game session), you may spend **1 Luck point** to locate one of your caches and claim its contents.\n\nIf you have been exposed, upon reaching a cache make a **LCK + Sneak** test with difficulty 1. On a failure, your cache is compromised."
+      }
+    }
+  }
+}
