From 187bafcf2b3b388019c0c3acc47d8d68abdd8b22 Mon Sep 17 00:00:00 2001
From: arena-agent <297053741+arena-agent@users.noreply.github.com>
Date: Wed, 5 Aug 2026 06:57:50 +0000
Subject: [PATCH] fix(inventory): enrich armor/clothing from catalog at equip
 (save compatibility)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Предметы из старых сохранений грузились без protectedAreas (normalizeItems копирует только id/name/itemType/quantity/...), поэтому их нельзя было надеть (getSlotsForArea пусто). Предмет, добавленный через модалку в той же сессии, имел protectedAreas в памяти — потому надевался. Фикс: в handleEquipArmor обогащаем предмет из каталога через resolveLocalizedItem (по id подтягиваются protectedAreas/itemType/clothingType). Каталог = источник истины, поэтому старые сохранения надеваются без миграции самих данных.
---
 components/screens/InventoryScreen/InventoryScreen.js | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/components/screens/InventoryScreen/InventoryScreen.js b/components/screens/InventoryScreen/InventoryScreen.js
index 62531ad..c69874d 100644
--- a/components/screens/InventoryScreen/InventoryScreen.js
+++ b/components/screens/InventoryScreen/InventoryScreen.js
@@ -860,7 +860,11 @@ const InventoryScreen = () => {
     });
   };
 
-  const handleEquipArmor = (itemToEquip) => {
+  const handleEquipArmor = (itemToEquipRaw) => {
+    // Совместимость сохранений: статические поля (protectedAreas, itemType, …)
+    // берём из каталога по id — в старых сохранениях их может не быть, и без них
+    // предмет не надевается. Каталог = источник истины.
+    const itemToEquip = resolveLocalizedItem(itemToEquipRaw) || itemToEquipRaw;
     const currentEquipped = equippedArmor;
     if (isRobot && !isRobotOnlyItem(itemToEquip)) {
       const isAllowedClothing = itemToEquip.itemType === 'clothing' && itemToEquip.canRobotWear === true;
-- 
2.47.3

