+// Server-authoritative rules and board generation for shared terminal hacking.
+const WORDS_BY_LENGTH = {
+  4: ['ATOM', 'BOMB', 'CODE', 'DATA', 'DOOR', 'EXIT', 'FUEL', 'GAME', 'HACK', 'LOCK', 'MINE', 'PASS', 'RAID', 'SAFE', 'SHIP', 'VAULT'],
