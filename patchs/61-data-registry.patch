diff --git a/domain/registry.js b/domain/registry.js
new file mode 100644
index 0000000..ecbaf48
--- /dev/null
+++ b/domain/registry.js
@@ -0,0 +1,45 @@
+// domain/registry.js
+// Реестр данных движка — ЕДИНАЯ точка чтения данных сеттинга.
+//
+// Сейчас реестр возвращает статические файлы data/ (поведение не меняется).
+// В будущем сюда подключится модуль сеттинга (modules/fallout.posm):
+// registry = base(встроенные данные) + user(packStore-модуль), приоритет — модуль.
+//
+// Все потребители (domain/*, компоненты) должны читать данные ТОЛЬКО через
+// реестр, а не напрямую из data/*.json — тогда добавление модуля не потребует
+// правок в сотне мест.
+
+import originsJson from '../data/origins/origins.json';
+import traitsJson from '../data/traits/traits.json';
+import bodyplansJson from '../data/bodyplans/bodyplans.json';
+import { getEquipmentCatalog } from '../i18n/equipmentCatalog';
+
+/**
+ * Все ориджины (сырые записи).
+ * TODO(pack): при подключении модуля — слить с модульными (deepMerge по id).
+ */
+export function getOrigins() {
+  return originsJson;
+}
+
+/**
+ * Все трейты (сырые записи).
+ */
+export function getTraits() {
+  return traitsJson;
+}
+
+/**
+ * Планы тела.
+ */
+export function getBodyPlans() {
+  return bodyplansJson;
+}
+
+/**
+ * Каталог снаряжения (оружие/броня/комплекты/i18n).
+ * Уже принимает локаль; при подключении модуля — сюда же добавится merge.
+ */
+export function getEquipmentCatalogForLocale(locale) {
+  return getEquipmentCatalog(locale);
+}
