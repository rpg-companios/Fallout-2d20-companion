{
  "license": "AGPL-3.0-only",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "apk": "npx eas-cli build --platform android --profile preview",
    "apk:local": "npx expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "aab": "npx eas-cli build --platform android --profile production",
    "serve": "npx serve -s dist -l 5000",
    "test": "vitest run",
    "publish:plan": "node scripts/publish-repositories.mjs",
    "publish:engine": "node scripts/publish-repositories.mjs --target engine --patch --push",
    "publish:setting": "node scripts/publish-repositories.mjs --target setting --patch --push --release",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/material-top-tabs": "^7.4.27",
    "@react-navigation/native": "^7.2.4",
    "browser-fs-access": "^0.38.0",
    "expo": "~57.0.16",
    "expo-asset": "~57.0.14",
    "expo-auth-session": "~57.0.15",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-sharing": "~57.0.15",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "fflate": "^0.8.3",
    "immer": "^11.1.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-pager-view": "8.0.2",
    "react-native-paper": "^4.12.8",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@types/react": "~19.2.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.4",
    "fast-check": "^4.7.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  },
  "private": true,
  "overrides": {
    "shell-quote": "1.12.0"
  }
